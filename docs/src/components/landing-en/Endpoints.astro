---
const endpoints = [
  { method: 'GET', path: '/today', description: 'Today\'s Hijri date' },
  { method: 'GET', path: '/today/{date}', description: 'Specific date (CDN-cacheable)' },
  { method: 'GET', path: '/convert', description: 'Single date conversion (both directions)' },
  { method: 'GET', path: '/range', description: 'Bulk conversion (≤400 days)' },
  { method: 'GET', path: '/month', description: 'Monthly calendar grid' },
  { method: 'GET', path: '/events', description: 'Islamic holidays (Ramadan, Eid al-Fitr/Adha, etc.)' },
  { method: 'GET', path: '/hilal/info', description: 'Hilal visibility: criteria data' },
  { method: 'GET', path: '/hilal/viz', description: '720×1280 sky chart PNG' },
  { method: 'GET', path: '/meta', description: 'Data coverage & status info' },
];
---

<section class="endpoints-section">
  <div class="endpoints-content">
    <div class="endpoints-header">
      <h2>Built for Developers</h2>
      <p>Clean REST API, consistent JSON responses, full documentation.</p>
    </div>

    <div class="endpoints-list">
      {endpoints.map((ep) => (
        <div class="endpoint-row">
          <span class="endpoint-method">{ep.method}</span>
          <code class="endpoint-path">{ep.path}</code>
          <span class="endpoint-desc">{ep.description}</span>
        </div>
      ))}
    </div>

    <div class="endpoints-footer">
      <a href="/en/endpoints/convert/" class="link-arrow">
        View Full API Reference
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .endpoints-section {
    padding: clamp(3rem, 6vw, 6rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .endpoints-content {
    max-width: 48rem;
    margin: 0 auto;
  }

  .endpoints-header {
    margin-bottom: 3rem;
  }

  .endpoints-header h2 {
    font-size: clamp(1.75rem, 1rem + 3vw, 2.5rem);
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0 0 1rem;
  }

  .endpoints-header p {
    font-size: clamp(1rem, 0.5rem + 1vw, 1.125rem);
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  .endpoints-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .endpoint-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    transition: border-color 0.2s;
  }

  .endpoint-row:hover {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .endpoint-method {
    flex-shrink: 0;
    padding: 0.2rem 0.5rem;
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    font-family: monospace;
  }

  .endpoint-path {
    flex-shrink: 0;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875rem;
    color: var(--sl-color-white);
    min-width: 10rem;
  }

  .endpoint-desc {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .endpoints-footer {
    margin-top: 2rem;
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-accent);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    transition: gap 0.2s;
  }

  .link-arrow:hover {
    gap: 0.75rem;
  }

  @media (max-width: 40rem) {
    .endpoint-row {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .endpoint-desc {
      width: 100%;
      margin-top: 0.25rem;
    }
  }
</style>
