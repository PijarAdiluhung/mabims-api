---
import FooterId from './landing/Footer.astro';
import FooterEn from './landing-en/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'id' | 'en';
  canonical: string;
  ogLocale?: string;
  altId?: string;
  altEn?: string;
  xDefault?: string;
}

const {
  title,
  description,
  lang = 'id',
  canonical,
  ogLocale = lang === 'en' ? 'en_US' : 'id_ID',
  altId = 'https://mabims.dev/',
  altEn = 'https://mabims.dev/en/',
  xDefault = altId,
} = Astro.props;

const base = lang === 'en' ? '/en' : '';
const labels = lang === 'en'
  ? { quickstart: 'Quickstart', coba: 'Coba', try: 'Demo', blog: 'Blog', github: 'GitHub' }
  : { quickstart: 'Quickstart', coba: 'Coba', try: 'Demo', blog: 'Blog', github: 'GitHub' };
const links = {
  logo:        `${base}/`,
  quickstart:  `${base}/quickstart/`,
  coba:        `https://api.mabims.dev/playground`,
  converter:   `${base}/demo/converter/`,
  kalender:    `${base}/demo/kalender/`,
  hilalDemo:   `${base}/demo/hilal/`,
  hilalPage:   lang === 'id' ? '/hilal/' : null,
  blog:        `${base}/blog/`,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <meta name="theme-color" content="#23262f" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://mabims.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="mabims.dev" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://mabims.dev/og-image.png" />

    <!-- hreflang -->
    <link rel="alternate" hreflang="id" href={altId} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <slot name="head" />
  </head>
  <body>
    <nav class="landing-nav">
      <div class="nav-inner">
        <a href={links.logo} class="nav-logo">
          <img src="/mabims-long.png" alt="MABIMS" class="nav-logo-img" />
        </a>
        <div class="nav-links">
          <a href={links.quickstart}>{labels.quickstart}</a>
          <a href={links.coba} target="_blank" rel="noopener">{labels.coba}</a>
          <div class="nav-dropdown">
            <button class="nav-dropdown-trigger">
              {labels.try}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="nav-dropdown-menu">
              <a href={links.converter}>Konverter</a>
              <a href={links.kalender}>Kalender</a>
              <a href={links.hilalDemo}>Grafik</a>
            </div>
          </div>
          {links.hilalPage && <a href={links.hilalPage}>Hilal</a>}
          <a href={links.blog}>{labels.blog}</a>
          <a href="https://github.com/PijarAdiluhung/mabims-api" target="_blank" rel="noopener" class="nav-github">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
        <button class="nav-toggle" aria-label="Toggle menu" id="nav-toggle">
          <svg class="icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <a href={links.quickstart}>{labels.quickstart}</a>
      <a href={links.coba} target="_blank" rel="noopener">{labels.coba}</a>
      <span class="mobile-menu-label">{labels.try}</span>
      <a href={links.converter} class="mobile-menu-sub">Konverter</a>
      <a href={links.kalender} class="mobile-menu-sub">Kalender</a>
      <a href={links.hilalDemo} class="mobile-menu-sub">Grafik</a>
      {links.hilalPage && <a href={links.hilalPage}>Hilal</a>}
      <a href={links.blog}>{labels.blog}</a>
      <a href="https://github.com/PijarAdiluhung/mabims-api" target="_blank" rel="noopener">{labels.github}</a>
    </div>

    <main class="landing-main">
      <div class="landing-container">
        <slot />
      </div>
      {lang === 'en' ? <FooterEn /> : <FooterId />}
    </main>
  </body>
</html>

<style is:global>
  :root {
    --sl-color-accent: #fecf46;
    --sl-color-accent-high: #e6b830;
    --sl-color-accent-low: #fef0c8;
    --sl-color-white: #ffffff;
    --sl-color-gray-2: #c4c4c4;
    --sl-color-gray-3: #888888;
    --sl-text-xs: 0.75rem;
    --sl-text-sm: 0.875rem;
    --sl-text-body: 1rem;
    --sl-text-h4: 1.125rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: 'Poppins', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    background: #17181c;
    color: #e8e8ee;
    min-height: 100vh;
  }

  /* Gradient fade dividers instead of hard borders */
  section {
    border-top: none !important;
    position: relative;
  }

  .landing-container > section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
    pointer-events: none;
  }

  /* Force yellow CTA buttons */
  a[class*="btn-primary"],
  a[class*="btn-primary"]:visited {
    background: #fecf46 !important;
    color: #1a1a2e !important;
    border: none !important;
  }

  a[class*="btn-primary"]:hover {
    background: #e6b830 !important;
    color: #1a1a2e !important;
  }

  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(35, 38, 47, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
  }

  .nav-logo-img {
    height: 28px;
    width: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-links a {
    color: #999;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: #fff;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: #999;
    background: none;
    border: none;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    transition: color 0.2s;
  }

  .nav-dropdown-trigger svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s;
  }

  .nav-dropdown:hover .nav-dropdown-trigger {
    color: #fff;
  }

  .nav-dropdown:hover .nav-dropdown-trigger svg {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(35, 38, 47, 0.97);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.5rem 0;
    min-width: 160px;
    z-index: 200;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -1rem;
    left: 0;
    right: 0;
    height: 1rem;
  }

  .nav-dropdown:hover .nav-dropdown-menu {
    display: block;
  }

  .nav-dropdown-menu a {
    display: block;
    padding: 0.5rem 1rem;
    color: #999;
    font-size: 0.875rem;
    white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }

  .nav-dropdown-menu a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-github {
    display: flex;
    align-items: center;
  }

  .landing-main {
    width: 100%;
  }

  .landing-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    padding: 0.25rem;
  }

  .nav-toggle:hover {
    color: #fff;
  }

  .nav-toggle .icon-close {
    display: none;
  }

  .nav-toggle.active .icon-open {
    display: none;
  }

  .nav-toggle.active .icon-close {
    display: block;
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(35, 38, 47, 0.98);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 1rem 1.5rem;
    z-index: 99;
    flex-direction: column;
    gap: 0;
  }

  .mobile-menu.active {
    display: flex;
  }

  .mobile-menu a {
    color: #999;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: color 0.2s;
  }

  .mobile-menu a:last-child {
    border-bottom: none;
  }

  .mobile-menu a:hover {
    color: #fff;
  }

  .mobile-menu-label {
    display: block;
    color: #999;
    font-size: 1rem;
    font-weight: 500;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .mobile-menu-sub {
    padding-left: 1rem !important;
  }

  @media (max-width: 640px) {
    .landing-container {
      padding: 0 1rem;
    }

    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const nav = document.querySelector('.landing-nav');

  toggle?.addEventListener('click', () => {
    toggle.classList.toggle('active');
    menu.classList.toggle('active');
    if (menu.classList.contains('active') && nav) {
      menu.style.top = nav.offsetHeight + 'px';
    }
  });
</script>
