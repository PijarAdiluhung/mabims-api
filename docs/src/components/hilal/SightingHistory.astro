---
interface Props {
  items: string[];
  publicApiBase: string;
  hasMore: boolean;
}

const { items, publicApiBase, hasMore } = Astro.props;
---

<section class="hilal-history" id="riwayat">
  <header class="hilal-section-head">
    <h2>Riwayat <span class="accent">Hilal</span></h2>
    <p>
      Lihat detail visibilitas hilal di bulan-bulan yang telah lewat.
    </p>
  </header>

  <div class="hilal-history-list" data-history>
    {items.length > 0 ? (
      <Fragment set:html={items.join('')} />
    ) : (
      <p class="hilal-loading">Riwayat tidak tersedia.</p>
    )}
  </div>

  <div class="hilal-history-more">
    <button type="button" class="hilal-loadmore" data-more hidden={!hasMore}>
      Tampilkan lebih banyak
    </button>
  </div>
</section>
