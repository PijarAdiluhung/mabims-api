---
interface Props {
  fallback:
    | { day: number; month_name: string; year: number; greg: string }
    | null;
}

const { fallback } = Astro.props;
---

<section class="hilal-hero" id="sekarang">
  <div class="hilal-atmos" aria-hidden="true">
    <div class="hilal-stars"></div>
  </div>

  <div class="hilal-hero-grid">
    <div class="hilal-hero-text">
      <p class="hilal-eyebrow">Hari ini</p>
      <h1 class="hilal-date">
        <span class="hilal-date-num" data-today-day>{fallback?.day ?? '—'}</span>
        <span class="hilal-date-rest">
          <span class="hilal-date-month" data-today-month>{fallback?.month_name ?? 'Memuat…'}</span>
          <span class="hilal-date-year"><span data-today-year>{fallback?.year ?? ''}</span> H</span>
        </span>
      </h1>
      <p class="hilal-greg" data-today-greg>{fallback?.greg ?? 'Memuat tanggal…'}</p>
      <p class="hilal-method">Kriteria Neo MABIMS · altitude ≥ 3° · elongasi ≥ 6,4°</p>
      <a href="#berikutnya" class="btn btn-primary">
        Lihat visibilitas
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <div class="hilal-moon-stage">
      <div class="hilal-moon-glow" aria-hidden="true"></div>
      <div class="hilal-moon-aura" aria-hidden="true"></div>
      <svg viewBox="0 0 240 240" class="hilal-moon" role="img" aria-label="Fase bulan saat ini">
        <defs>
          <radialGradient id="hilal-moon-g" cx="35%" cy="28%" r="78%">
            <stop offset="0%" stop-color="#fff8d4"></stop>
            <stop offset="35%" stop-color="#fecf46"></stop>
            <stop offset="75%" stop-color="#d49424"></stop>
            <stop offset="100%" stop-color="#8a5814"></stop>
          </radialGradient>
          <radialGradient id="hilal-moon-halo" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#fecf46" stop-opacity="0.45"></stop>
            <stop offset="40%" stop-color="#fecf46" stop-opacity="0.12"></stop>
            <stop offset="100%" stop-color="#fecf46" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <circle cx="120" cy="120" r="118" fill="url(#hilal-moon-halo)"></circle>
        <circle cx="120" cy="120" r="70" fill="#13141c"></circle>
        <g transform="translate(120,120)">
          <path data-moon-lit fill="url(#hilal-moon-g)" d=""></path>
        </g>
      </svg>

      <div class="hilal-countdown-card">
        <p class="countdown-eyebrow">Malam penentuan berikutnya</p>
        <div class="countdown-row">
          <span class="countdown-value"><span data-count-days>—</span></span>
          <span class="countdown-unit" data-count-unit>hari lagi</span>
        </div>
        <p class="countdown-target" data-count-target>Menghitung…</p>
        <div class="lunation" aria-hidden="true">
          <div class="lunation-track">
            <div class="lunation-fill" data-moon-arc></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
