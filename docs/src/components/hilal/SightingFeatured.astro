---
---

<section class="hilal-featured" id="berikutnya">
  <header class="hilal-section-head">
    <h2>Malam Penentuan <span class="accent">Berikutnya</span></h2>
    <p data-featured-sub>Memuat visibilitas hilal untuk awal bulan Hijriah berikutnya…</p>
  </header>

  <div class="hilal-featured-grid">
    <figure class="hilal-graphic">
      <button class="hilal-zoom" type="button" data-zoom="map" aria-label="Perbesar peta wilayah visibilitas hilal">
        <img
          data-map-img
          alt="Peta wilayah visibilitas hilal"
          width="1440"
          height="1520"
          loading="eager"
          decoding="async"
        />
        <span class="hilal-zoom-hint">Perbesar</span>
      </button>
      <figcaption>
        <span class="hilal-graphic-title">Peta wilayah</span>
        <span class="hilal-graphic-date" data-map-date></span>
        <a class="hilal-download" data-map-dl download>Unduh kartu</a>
      </figcaption>
    </figure>

    <figure class="hilal-graphic">
      <button class="hilal-zoom" type="button" data-zoom="viz" aria-label="Perbesar grafik langit visibilitas hilal">
        <img
          data-viz-img
          alt="Grafik langit visibilitas hilal"
          width="1440"
          height="1520"
          loading="eager"
          decoding="async"
        />
        <span class="hilal-zoom-hint">Perbesar</span>
      </button>
      <figcaption>
        <span class="hilal-graphic-title">Grafik langit</span>
        <span class="hilal-graphic-date" data-viz-date></span>
        <a class="hilal-download" data-viz-dl download>Unduh kartu</a>
      </figcaption>
    </figure>
  </div>

  <div class="hilal-facts" data-featured-facts></div>
</section>
