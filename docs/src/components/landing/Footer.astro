---
---

<footer class="landing-footer">
  <div class="footer-content">
    <div class="footer-left">
      <span class="footer-text">Dibuat oleh</span>
      <a
        href="https://pixostudio.id"
        target="_blank"
        rel="noopener"
        class="pixo-link"
      >
        <img src="/pixostudio.png" alt="PIXO Studio" class="pixo-logo" />
      </a>
    </div>

    <div class="footer-center">
      <span class="footer-copyright">MABIMS adalah standar rukyah Kemenag RI. API ini bukan produk resmi MABIMS/Kemenag.</span>
    </div>

    <div class="footer-right">
      <a
        href="https://github.com/PijarAdiluhung/mabims-api"
        target="_blank"
        rel="noopener"
        class="gh-link"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .landing-footer {
    padding: 3rem 0 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  @media (min-width: 40rem) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
  }

  .footer-text {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .pixo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .pixo-logo {
    height: 20px;
    width: auto;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .pixo-link:hover .pixo-logo {
    opacity: 1;
  }

  .footer-center {
    text-align: center;
  }

  .footer-copyright {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .footer-right {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: flex-end;
  }

  .gh-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    transition: color 0.2s;
  }

  .gh-link:hover {
    color: var(--sl-color-white);
  }
</style>
