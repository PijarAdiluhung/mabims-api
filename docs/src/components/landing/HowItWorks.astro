---
const steps = [
  {
    number: '01',
    title: 'Panggil Endpoint',
    description: 'Gunakan /today atau /convert. Tidak perlu autentikasi.',
    code: 'GET /api/v1/today',
  },
  {
    number: '02',
    title: 'Dapat Tanggal MABIMS',
    description: 'Respons langsung menyertakan source: "mabims".',
    code: '{ "date": "1448-03-11", "source": "mabims" }',
  },
  {
    number: '03',
    title: 'Integrasikan',
    description: 'Tampilkan di aplikasi Anda. Cek warnings jika ada.',
    code: 'if (warnings.length) showNote();',
  },
];
---

<section class="how-section">
  <div class="how-header">
    <h2>Cara Kerjanya</h2>
    <p>Tiga langkah sederhana untuk tanggal Hijriah yang akurat.</p>
  </div>

  <div class="steps-grid">
    {steps.map((step, i) => (
      <div class="step-card">
        <div class="step-number">{step.number}</div>
        <div class="step-content">
          <h3>{step.title}</h3>
          <p>{step.description}</p>
          <code class="step-code">{step.code}</code>
        </div>
        {i < steps.length - 1 && (
          <div class="step-connector">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .how-section {
    padding: clamp(3rem, 6vw, 6rem) 0;
    background: linear-gradient(180deg, transparent 0%, rgba(254, 207, 70, 0.02) 50%, transparent 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .how-header {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 4rem;
  }

  .how-header h2 {
    font-size: clamp(1.75rem, 1rem + 3vw, 2.5rem);
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0 0 1rem;
  }

  .how-header p {
    font-size: clamp(1rem, 0.5rem + 1vw, 1.125rem);
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 64rem;
    margin: 0 auto;
  }

  @media (min-width: 40rem) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .step-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    overflow: hidden;
  }

  .step-number {
    font-size: 3rem;
    font-weight: 800;
    color: var(--sl-color-accent);
    opacity: 0.3;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.5rem 0;
  }

  .step-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
  }

  .step-content p {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.6;
    margin: 0;
  }

  .step-code {
    display: block;
    margin-top: 0.5rem;
    padding: 0.625rem 1rem;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.7rem;
    color: var(--sl-color-accent);
    white-space: nowrap;
    overflow-x: auto;
    max-width: 100%;
    text-overflow: ellipsis;
  }

  .step-connector {
    display: none;
  }

  @media (min-width: 40rem) {
    .step-connector {
      display: flex;
      position: absolute;
      right: -1.25rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--sl-color-gray-3);
      z-index: 1;
    }
  }

  @media (min-width: 64rem) {
    .step-card {
      padding: 2.5rem 1.5rem;
    }
  }
</style>
