---
import { Mosque, Zap, CalendarDays, Code, RefreshCcw, Package } from '@lucide/astro';

const features = [
  {
    icon: Mosque,
    title: 'Berdasarkan Data Kemenag',
    description: 'Menggunakan data publik tabel kalender dari Kementerian Agama RI, bukan mengikuti otoritas Saudi.',
    color: 'yellow',
  },
  {
    icon: Zap,
    title: 'Tanpa Autentikasi',
    description: 'Cukup panggil endpoint. Tidak perlu API key, tidak perlu registrasi.',
    color: 'green',
  },
  {
    icon: CalendarDays,
    title: 'Cakupan Luas',
    description: 'Data tabel 2024–2026, perhitungan komputasi maju sampai 2053.',
    color: 'purple',
  },
  {
    icon: Code,
    title: 'Open Source',
    description: 'Kode terbuka di GitHub. Transparan, bisa diverifikasi, kontribusi selalu diterima.',
    color: 'pink',
  },
  {
    icon: RefreshCcw,
    title: 'Kalender Bulanan & Tahunan',
    description: 'Tersedia endpoint /month dan /year. Semua hari dalam satu bulan atau satu tahun penuh.',
    color: 'orange',
  },
  {
    icon: Package,
    title: 'JavaScript SDK',
    description: 'Paket npm offline-first. Konversi tanggal, bulan penuh, data hilal, semuanya tanpa API key.',
    color: 'blue',
  },
];
---

<section class="features-section">
  <div class="features-header">
    <h2>Kalender Hijriah Indonesia, <span class="accent">Satu API</span></h2>
    <p>MABIMS.dev adalah API open-source unofficial gratis yang menyediakan ekosistem kalender Hijriah untuk Indonesia. Semuanya berdasarkan kriteria MABIMS.</p>
  </div>

  <div class="features-grid">
    {features.map((feature) => (
      <article class={`feature-card feature-card--${feature.color}`}>
        <div class="feature-icon"><feature.icon size={20} /></div>
        <h3>{feature.title}</h3>
        <p>{feature.description}</p>
      </article>
    ))}
  </div>

  <div class="features-cta">
    <a href="/about/" class="features-link">
      Selengkapnya tentang MABIMS.dev
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</section>

<style>
  .features-section {
    padding: clamp(3rem, 6vw, 6rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .features-header {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 2.5rem;
  }

  .features-header h2 {
    font-size: clamp(1.75rem, 1rem + 3vw, 2.5rem);
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .features-header h2 .accent {
    color: var(--sl-color-accent);
  }

  .features-header p {
    font-size: clamp(1rem, 0.5rem + 1vw, 1.125rem);
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 40rem) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .feature-card {
    padding: 1.75rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    transition: border-color 0.2s, transform 0.2s;
  }

  .feature-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    margin-bottom: 1.25rem;
  }

  .feature-card--yellow .feature-icon { background: rgba(254, 207, 70, 0.12); }
  .feature-card--green .feature-icon { background: rgba(34, 197, 94, 0.12); }
  .feature-card--purple .feature-icon { background: rgba(168, 85, 247, 0.12); }
  .feature-card--pink .feature-icon { background: rgba(236, 72, 153, 0.12); }
  .feature-card--blue .feature-icon { background: rgba(59, 130, 246, 0.12); }
  .feature-card--orange .feature-icon { background: rgba(249, 115, 22, 0.12); }

  .feature-card h3 {
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 0.75rem;
  }

  .feature-card p {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.7;
    margin: 0;
  }

  .features-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  .features-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  .features-link:hover {
    color: var(--sl-color-accent-high);
  }
</style>
