<script>
  const API = import.meta.env.PUBLIC_API_BASE ?? 'https://api.mabims.dev';

  const HIJRI_MONTHS = [
    'Muharram', 'Safar', 'Rabiul Awal', 'Rabiul Akhir',
    'Jumadil Awal', 'Jumadil Akhir', 'Rajab', "Sya'ban",
    'Ramadhan', 'Syawal', "Dzulqa'dah", 'Dzulhijjah',
  ];
  const GREG_MONTHS = [
    'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun',
    'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des',
  ];
  const HIJRI_MONTHS_SHORT = [
    'Muh', 'Saf', 'Rb. I', 'Rb. II', 'Jm. I', 'Jm. II', 'Raj', 'Syb',
    'Ram', 'Syw', 'Dq', 'Dh',
  ];
  const GREG_MONTHS_LONG = [
    'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
    'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember',
  ];
  const WEEKDAYS_FULL = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
  const EVENT_NAMES: Record<string, string> = {
    awal_ramadan: 'Awal Ramadan',
    idul_fitri: 'Idul Fitri',
    idul_adha: 'Idul Adha',
    '1_muharram': 'Tahun Baru Islam',
    maulid_nabi: 'Maulid Nabi Muhammad ﷺ',
  };

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);

  type DayItem = { gregorian: string; hijri: string; source: string };
  type EventItem = { event: string; name: string; hijri: string; gregorian: string };
  type Today = { day: number; month: number; month_name: string; year: number };

  const NOW = new Date();
  const state = {
    hijriYear: 1447,
    gregYear: new Date().getFullYear(),
    month: 1, // month within the active mode
    mode: 'hijri' as 'hijri' | 'gregorian',
    events: new Map<string, string>(),
    todayHijri: '',
    todayGreg: '',
    // hijri year the page opened on; hijri mode is pinned to it
    currentHijriYear: 1447,
    // Masehi bounds: gregorian months of the first & last day of the
    // current hijri year (fetched at boot). null = no clamp yet.
    gregCeil: null as { y: number; m: number } | null,
    gregFloor: null as { y: number; m: number } | null,
  };

  // Recover state from the server-rendered grid
  {
    const yearText = $<HTMLElement>('[data-month-year]')?.textContent?.trim() ?? '';
    state.hijriYear = Number(yearText.match(/\d{3,4}/)?.[0] ?? 1447);
    const firstCell = document.querySelector<HTMLElement>('.kc[data-hijri]');
    if (firstCell) {
      state.month = Number(firstCell.dataset.hijri!.slice(5, 7));
      state.gregYear = Number(firstCell.dataset.greg!.slice(0, 4));
    }
  }

  const weekdayIndex = (iso: string) => (new Date(`${iso}T00:00:00`).getDay() + 6) % 7;

  async function api(path: string, params?: Record<string, string>) {
    const url = new URL(`${API}${path}`);
    if (params) for (const [k, v] of Object.entries(params)) url.searchParams.set(k, v);
    const res = await fetch(url, { headers: { accept: 'application/json' } });
    if (!res.ok) throw new Error(String(res.status));
    return res.json();
  }

  function fmtDateLong(iso: string) {
    return new Intl.DateTimeFormat('id-ID', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
    }).format(new Date(`${iso}T00:00:00`));
  }

  function renderGridHijri(days: DayItem[]) {
    const grid = $('[data-grid]')!;
    let html = '';
    const leading = days.length ? weekdayIndex(days[0].gregorian) : 0;
    for (let i = 0; i < leading; i++) html += '<div class="kc is-empty"></div>';
    for (const item of days) {
      const hijriDay = Number(item.hijri.slice(8, 10));
      const [, gm, gd] = item.gregorian.split('-').map(Number);
      const isFri = weekdayIndex(item.gregorian) === 4;
      const isToday = item.hijri === state.todayHijri;
      const ev = state.events.get(item.hijri);
      const isWeekend = weekdayIndex(item.gregorian) >= 5;
      const sub = `${gd} ${GREG_MONTHS[gm - 1]}`;
      html += `<div class="kc${isFri ? ' is-fri' : ''}${isWeekend ? ' is-weekend' : ''}${isToday ? ' is-today' : ''}${ev ? ' has-event' : ''}" data-hijri="${item.hijri}" data-greg="${item.gregorian}">` +
        `<span class="kc-day">${hijriDay}</span>` +
        `<span class="kc-greg">${sub}</span>` +
        (ev ? `<span class="kc-ev"></span>` : '') +
        `</div>`;
    }
    const filled = leading + days.length;
    const total = Math.ceil(filled / 7) * 7;
    for (let i = filled; i < total; i++) html += '<div class="kc is-empty"></div>';
    grid.innerHTML = html;
    renderExtras(days);
  }

  function renderGridGregorian(cells: Array<{ day?: DayItem; gregDay?: number }>) {
    const grid = $('[data-grid]')!;
    let html = '';
    for (const cell of cells) {
      if (!cell.gregDay) { html += '<div class="kc is-empty"></div>'; continue; }
      const item = cell.day;
      const iso = `${state.gregYear}-${String(state.month).padStart(2, '0')}-${String(cell.gregDay).padStart(2, '0')}`;
      const isFri = weekdayIndex(iso) === 4;
      const isToday = item?.gregorian === state.todayGreg;
      const ev = item ? state.events.get(item.hijri) : undefined;
      const isWeekend = weekdayIndex(iso) >= 5;
      const small = item
        ? `${Number(item.hijri.slice(8, 10))} ${HIJRI_MONTHS_SHORT[Number(item.hijri.slice(5, 7)) - 1]}`
        : '';
      html += `<div class="kc${isFri ? ' is-fri' : ''}${isWeekend ? ' is-weekend' : ''}${isToday ? ' is-today' : ''}${ev ? ' has-event' : ''}"${item ? ` data-hijri="${item.hijri}" data-greg="${item.gregorian}"` : ''}>` +
        `<span class="kc-day">${cell.gregDay}</span>` +
        `<span class="kc-greg">${small}</span>` +
        (ev ? `<span class="kc-ev"></span>` : '') +
        `</div>`;
    }
    grid.innerHTML = html;
    renderExtras(cells.filter((c) => c.day).map((c) => c.day!));
  }

  function renderExtras(days: DayItem[]) {
    const monthEvents = [];
    const seen = new Set<string>();
    for (const d of days) {
      const name = state.events.get(d.hijri);
      if (!name || seen.has(d.hijri)) continue;
      seen.add(d.hijri);
      const label = `${Number(d.hijri.slice(8, 10))} ${HIJRI_MONTHS[Number(d.hijri.slice(5, 7)) - 1]} · ${name}`;
      monthEvents.push(label);
    }
    const evEl = $('[data-events]');
    if (evEl) {
      evEl.hidden = monthEvents.length === 0;
      evEl.innerHTML = monthEvents.map((e) => `<span class="kh-ev-badge">${e}</span>`).join('');
    }
  }

  function renderHeader() {
    const nameEl = $<HTMLElement>('[data-month-name]');
    const yearEl = $<HTMLElement>('[data-month-year]');
    if (nameEl) nameEl.textContent = state.mode === 'hijri' ? HIJRI_MONTHS[state.month - 1] : GREG_MONTHS_LONG[state.month - 1];
    if (yearEl) yearEl.textContent = state.mode === 'hijri' ? `${state.hijriYear} H` : `${state.gregYear} M`;
    const prev = $('[data-prev]') as HTMLButtonElement | null;
    const next = $('[data-next]') as HTMLButtonElement | null;
    if (prev) prev.disabled = state.mode === 'gregorian'
      ? (state.gregFloor !== null &&
          (state.gregYear < state.gregFloor.y || (state.gregYear === state.gregFloor.y && state.month === state.gregFloor.m)))
      : state.month === 1;
    if (next) next.disabled = state.mode === 'gregorian'
      ? (state.gregCeil !== null &&
          (state.gregYear > state.gregCeil.y || (state.gregYear === state.gregCeil.y && state.month >= state.gregCeil.m)))
      : state.month === 12;
  }

  let loadToken = 0;

  // Memory cache, populated wholesale from one /year call per hijri year:
  //   monthCache: `hijri:YYYY-M` → DayItem[]
  //   monthRange: `hijri:YYYY-M` → { start, end } greg bounds (for convert math)
  //   convertCache: greg ISO → { y, m } (derived locally when possible)
  const monthCache = new Map<string, DayItem[]>();
  const monthRange = new Map<string, { start: string; end: string }>();
  const convertCache = new Map<string, { year: number; month: number }>();
  const yearCache = new Set<number>();
  const cachedMonth = (y: number, m: number) => monthCache.get(`hijri:${y}-${m}`) ?? null;

  async function getHijriYear(y: number): Promise<boolean> {
    if (yearCache.has(y)) return true;
    const body = await api('/api/v1/year', { year: String(y), calendar: 'hijri' });
    const months = (body.months ?? {}) as Record<string, DayItem[]>;
    for (let m = 1; m <= 12; m++) {
      const items = months[String(m)] ?? months[m as unknown as number] ?? [];
      if (!items.length) continue;
      monthCache.set(`hijri:${y}-${m}`, items);
      monthRange.set(`hijri:${y}-${m}`, { start: items[0].gregorian, end: items[items.length - 1].gregorian });
    }
    yearCache.add(y);
    return true;
  }

  async function getHijriMonth(y: number, m: number): Promise<DayItem[]> {
    const hit = cachedMonth(y, m);
    if (hit) return hit;
    await getHijriYear(y);
    return cachedMonth(y, m) ?? [];
  }

  // resolve greg ISO → hijri {year, month}: local math when the year is
  // cached, network convert otherwise
  async function getConvertMonth(iso: string): Promise<{ year: number; month: number }> {
    const hit = convertCache.get(iso);
    if (hit) return hit;
    for (const key of monthRange.keys()) {
      const range = monthRange.get(key)!;
      if (iso >= range.start && iso <= range.end) {
        const out = { year: Number(key.slice(6, 10)), month: Number(key.slice(11)) };
        convertCache.set(iso, out);
        return out;
      }
    }
    const body = await api('/api/v1/convert', { date: iso, calendar: 'gregorian' });
    const out = { year: body.output.year, month: body.output.month };
    convertCache.set(iso, out);
    return out;
  }

  async function loadMonth(dir = 0) {
    const token = ++loadToken;
    renderHeader();
    const grid = $('[data-grid]');
    const status = $('[data-status]');
    if (status) status.hidden = true;
    if (grid) grid.style.setProperty('--kh-dir', String(dir));
    const fresh = () => token === loadToken; // newest-load guard

    // render with a one-shot keyframe animation (always visible, no races)
    const animateIn = (fn: () => void) => {
      if (!grid) { fn(); return; }
      fn();
      grid.classList.remove('kh-in'); // restart if mid-flight
      void grid.getBoundingClientRect();
      grid.classList.add('kh-in');
      window.setTimeout(() => grid?.classList.remove('kh-in'), 560);
    };

    const startIso = (y: number, m: number) =>
      `${y}-${String(m).padStart(2, '0')}-01`;
    const fmtDMY = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    // convert resolver that only uses warm data (no network)
    const convertMonthSync = (iso: string): { year: number; month: number } | null => {
      const hit = convertCache.get(iso);
      if (hit) return hit;
      for (const key of monthRange.keys()) {
        const range = monthRange.get(key)!;
        if (iso >= range.start && iso <= range.end) {
          const out = { year: Number(key.slice(6, 10)), month: Number(key.slice(11)) };
          convertCache.set(iso, out);
          return out;
        }
      }
      return null;
    };

    // ── warm path: everything resolved from memory, quick fade swap ──
    const buildCells = (): Array<{ day?: DayItem; gregDay?: number }> | null => {
      const start = new Date(state.gregYear, state.month - 1, 1);
      const end = new Date(state.gregYear, state.month, 0);
      const s = start ? convertMonthSync(fmtDMY(start)) : null;
      const e = end ? convertMonthSync(fmtDMY(end)) : null;
      if (!s || !e) return null;
      const monthsToFetch: Array<{ y: number; m: number }> = [{ y: s.year, m: s.month }];
      if (e.year !== s.year || e.month !== s.month) monthsToFetch.push({ y: e.year, m: e.month });
      const all: DayItem[] = [];
      for (const { y, m } of monthsToFetch) {
        const bucket = cachedMonth(y, m);
        if (!bucket) return null;
        all.push(...bucket);
      }
      const inMonth = all.filter((d) =>
        d.gregorian.startsWith(`${state.gregYear}-${String(state.month).padStart(2, '0')}`));
      const byGreg = new Map(inMonth.map((d) => [d.gregorian, d]));
      const cells: Array<{ day?: DayItem; gregDay?: number }> = [];
      for (let i = 0; i < weekdayIndex(fmtDMY(start)); i++) cells.push({});
      for (let d = 1; d <= end.getDate(); d++) {
        const iso = fmtDMY(new Date(state.gregYear, state.month - 1, d));
        cells.push({ day: byGreg.get(iso), gregDay: d });
      }
      return cells;
    };

    // hijri: fully cached → fade swap, done
    if (grid && state.mode === 'hijri') {
      const hit = cachedMonth(state.hijriYear, state.month);
      if (hit) {
        animateIn(() => renderGridHijri(hit));
        return;
      }
    }
    // gregorian: fully cached → fade swap, done
    if (grid && state.mode === 'gregorian') {
      const cells = buildCells();
      if (cells) {
        animateIn(() => renderGridGregorian(cells));
        return;
      }
    }

    if (grid) {
      // fade out + stable-height skeleton (fixed 6 rows) while navigating
      grid.classList.add('is-swapping');
      grid.innerHTML = Array.from({ length: 42 }, () => '<div class="kc is-skel kh-skel"></div>').join('');
    }
    const reveal = () => requestAnimationFrame(() => grid?.classList.remove('is-swapping'));
    try {
      if (state.mode === 'hijri') {
        const items = await getHijriMonth(state.hijriYear, state.month);
        if (!fresh()) return;
        renderGridHijri(items);
        reveal();
        prefetchNeighbors();
      } else {
        // gregorian mode: build a standard gregorian month whose cells pair
        // each gregorian day with its hijri counterpart (big greg, small hijri)
        const start = new Date(state.gregYear, state.month - 1, 1);
        const end = new Date(state.gregYear, state.month, 0);
        const fmt = fmtDMY;
        const [startH, endH] = await Promise.all([
          getConvertMonth(fmt(start)),
          getConvertMonth(fmt(end)),
        ]);
        if (!fresh()) return;
        const s = { year: startH.year, month: startH.month };
        const e = { year: endH.year, month: endH.month };
        const monthsToFetch: Array<{ y: number; m: number }> = [{ y: s.year, m: s.month }];
        if (e.year !== s.year || e.month !== s.month) monthsToFetch.push({ y: e.year, m: e.month });
        // overlapping hijri years are pulled whole (one /year request each)
        // and cached per month, so repeat navigation is instant
        const needed = monthsToFetch.some(({ y, m }) => !cachedMonth(y, m));
        if (needed) {
          await Promise.all(monthsToFetch.map(({ y }) => getHijriYear(y)));
          if (!fresh()) return;
        }
        const all: DayItem[] = monthsToFetch.flatMap(({ y, m }) => cachedMonth(y, m) ?? []);
        if (!fresh()) return;
        const inMonth = all.filter((d) =>
          d.gregorian.startsWith(`${state.gregYear}-${String(state.month).padStart(2, '0')}`));
        const byGreg = new Map(inMonth.map((d) => [d.gregorian, d]));
        const leading = weekdayIndex(fmt(start));
        const daysInMonth = end.getDate();
        const cells: Array<{ day?: DayItem; gregDay?: number }> = [];
        for (let i = 0; i < leading; i++) cells.push({});
        for (let d = 1; d <= daysInMonth; d++) {
          const iso = fmt(new Date(state.gregYear, state.month - 1, d));
          cells.push({ day: byGreg.get(iso), gregDay: d });
        }
        renderGridGregorian(cells);
        reveal();
      }
    } catch {
      // only surface failures for the newest load; stale loads are superseded
      if (!fresh()) return;
      reveal();
      const status = $('[data-status]');
      if (status) {
        status.hidden = false;
        status.textContent = 'Gagal memuat kalender — coba muat ulang halaman.';
      }
    }
  }

  $('[data-prev]')?.addEventListener('click', () => {
    if (state.month > 1) {
      state.month -= 1;
    } else if (state.mode === 'gregorian' && state.gregFloor !== null && state.gregYear > state.gregFloor.y) {
      // wrap across the gregorian year boundary (jan → dec of prev year)
      state.gregYear -= 1;
      state.month = 12;
    } else {
      return;
    }
    loadMonth(-1);
  });
  $('[data-next]')?.addEventListener('click', () => {
    const atCeil = state.mode === 'gregorian' && state.gregCeil !== null &&
      (state.gregYear > state.gregCeil.y || (state.gregYear === state.gregCeil.y && state.month >= state.gregCeil.m));
    if (state.month < 12) {
      state.month += 1;
    } else if (state.mode === 'gregorian' && !atCeil) {
      state.gregYear += 1;
      state.month = 1;
    } else {
      return;
    }
    loadMonth(1);
  });
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.kh-toggle-btn')) {
    btn.addEventListener('click', () => {
      if (btn.dataset.mode === state.mode) return;
      state.mode = btn.dataset.mode as 'hijri' | 'gregorian';
      // carry the current view across modes via the visible grid's dates
      if (state.mode === 'gregorian') {
        const firstCell = document.querySelector<HTMLElement>('.kc[data-greg]');
        const laterCell = document.querySelector<HTMLElement>('.kc[data-greg]:nth-last-child(8)') ?? firstCell;
        const anchorIso = laterCell?.dataset.greg ?? firstCell?.dataset.greg;
        if (anchorIso) {
          parseIso(anchorIso);
          // clamp into the hijri year's gregorian window (floor…ceil)
          if (state.gregFloor) {
            const f = state.gregFloor;
            if (state.gregYear < f.y || (state.gregYear === f.y && state.month < f.m)) { state.gregYear = f.y; state.month = f.m; }
          }
          if (state.gregCeil) {
            const c = state.gregCeil;
            if (state.gregYear > c.y || (state.gregYear === c.y && state.month > c.m)) { state.gregYear = c.y; state.month = c.m; }
          }
        }
      } else if (state.mode === 'hijri') {
        const firstHijri = document.querySelector<HTMLElement>('.kc[data-hijri]');
        const laterHijri = document.querySelector<HTMLElement>('.kc[data-hijri]:nth-last-child(8)') ?? firstHijri;
        const anchorIso = laterHijri?.dataset.hijri ?? firstHijri?.dataset.hijri ?? state.todayHijri;
        // hijri mode is pinned to the year the page opened on — an anchor
        // past the year boundary (Dzulhijjah → Muharram 1449 in June 2027)
        // maps back into Dzulhijjah of the current year, never 1449
        state.hijriYear = state.currentHijriYear;
        const anchorYear = Number(anchorIso.slice(0, 4));
        if (anchorYear > state.currentHijriYear) {
          state.month = 12; // Muharram of the next year → Dzulhijjah
        } else if (anchorYear < state.currentHijriYear) {
          state.month = 1; // back below the year start
        } else {
          state.month = Number(anchorIso.slice(5, 7));
        }
      }
      for (const b of document.querySelectorAll('.kh-toggle-btn')) b.classList.toggle('is-active', b === btn);
      loadMonth(0);
    });
  }

  // silently warm the cache for the adjacent hijri months while idle —
  // makes the next prev/next click render instantly (both modes benefit:
  // masehi reuses the same hijri month data)
  function prefetchNeighbors() {
    const jobs: Array<{ y: number; m: number }> = [];
    if (state.mode === 'hijri') {
      if (state.month > 1) jobs.push({ y: state.hijriYear, m: state.month - 1 });
      if (state.month < 12) jobs.push({ y: state.hijriYear, m: state.month + 1 });
    }
    for (const { y, m } of jobs) {
      if (!cachedMonth(y, m)) void getHijriMonth(y, m).catch(() => {});
    }
  }

  /* ── Boot: today refresh + events + today highlight ── */
  (async function boot() {
    try {
      const browserTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      let today: any;
      try {
        today = await api('/api/v1/today', browserTz ? { tz: browserTz } : undefined);
      } catch {
        today = await api('/api/v1/today');
      }
      const o = today.output as Today;
      state.todayHijri = `${o.year}-${String(o.month).padStart(2, '0')}-${String(o.day).padStart(2, '0')}`;
      state.todayGreg = today.input.date;
      state.currentHijriYear = o.year;

      const hijriEl = $('[data-today-hijri]');
      const gD = new Date(`${today.input.date}T00:00:00`);
      const gWeekday = new Intl.DateTimeFormat('id-ID', { weekday: 'long' }).format(gD);
      const gDate = new Intl.DateTimeFormat('id-ID', {
        day: 'numeric', month: 'long', year: 'numeric',
      }).format(gD);
      if (hijriEl) hijriEl.textContent = `${gWeekday}, ${o.day} ${o.month_name} ${o.year} H · ${gDate}`;

      // If the build snapshot drifted (e.g. yesterday's deploy), resync the grid
      const buildToday = state.hijriYear === o.year && state.month === o.month;
      if (!buildToday) {
        state.hijriYear = o.year;
        state.month = o.month;
      }

      const evBody = await api('/api/v1/events', { year: String(o.year), calendar: 'hijri' });
      state.events = new Map(
        ((evBody.events ?? []) as EventItem[]).map((e) => [e.hijri, EVENT_NAMES[e.event] ?? e.name])
      );

      // Masehi clamp bounds: the gregorian months containing the first day
      // (Muharram) and last day (Dzulhijjah) of the current hijri year
      try {
        const [mu, dh] = await Promise.all([
          api('/api/v1/month', { year: String(o.year), month: '1', calendar: 'hijri' }),
          api('/api/v1/month', { year: String(o.year), month: '12', calendar: 'hijri' }),
        ]);
        const first = (mu.items ?? [])[0];
        const last = (dh.items ?? []).at(-1);
        if (first) state.gregFloor = { y: Number(first.gregorian.slice(0, 4)), m: Number(first.gregorian.slice(5, 7)) };
        if (last) state.gregCeil = { y: Number(last.gregorian.slice(0, 4)), m: Number(last.gregorian.slice(5, 7)) };
        renderHeader();
      } catch {}

      // Render events list section (fresh, in case SSR failed)
      const list = $('[data-events-list]');
      if (list && evBody.events?.length) {
        list.innerHTML = (evBody.events as EventItem[]).map((e) => {
          const g = new Date(`${e.gregorian}T00:00:00`);
          const day = g.getDate();
          const mon = `${GREG_MONTHS[g.getMonth()]} ${g.getFullYear()}`;
          return `<article class="kh-event-row"><div class="kh-event-date"><span class="kh-event-day">${day}</span>` +
            `<span class="kh-event-month">${mon}</span></div><div class="kh-event-body">` +
            `<span class="kh-event-name">${EVENT_NAMES[e.event] ?? e.name}</span>` +
            `<span class="kh-event-hijri">${e.hijri}</span></div></article>`;
        }).join('');
      }

      await loadMonth();
    } catch {
      // keep SSR content
    }
  })();

  function parseIso(iso: string) {
    // set gregorian mode state from an ISO gregorian date
    state.gregYear = Number(iso.slice(0, 4));
    state.month = Number(iso.slice(5, 7));
  }

  // expose for the toggle wiring above (same script scope hoisting)
  void parseIso;
</script>

<dialog class="kh-lightbox" data-lightbox>
  <button type="button" class="kh-lightbox-close" data-lightbox-close aria-label="Tutup">×</button>
  <img data-lightbox-img src="" alt="" />
</dialog>
<style>
  .kh-lightbox {
    width: min(96vw, 900px);
    max-width: none;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }
  .kh-lightbox::backdrop {
    background: rgba(10, 10, 14, 0.86);
    backdrop-filter: blur(4px);
  }
  .kh-lightbox img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 82vh;
    object-fit: contain;
    border-radius: 12px;
    background: #1f1235;
  }
  .kh-lightbox-close {
    position: absolute;
    top: -2.6rem;
    right: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const zoom = target.closest('[data-zoom]');
    if (zoom && lightbox) {
      const img = zoom.querySelector('img');
      const lightboxImg = lightbox.querySelector<HTMLImageElement>('[data-lightbox-img]');
      if (img && lightboxImg) {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox.showModal();
      }
      return;
    }
    if (target.closest('[data-lightbox-close]')) lightbox?.close();
  });
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });
</script>
