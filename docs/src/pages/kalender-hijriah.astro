        <div class="kh-fact"><span class="kh-fact-label">Sumber data</span><span class="kh-fact-value">Kemenag RI</span></div>
      </div>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="kh-faq" id="faq">
