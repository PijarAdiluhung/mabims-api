---
import LandingLayout from '../components/LandingLayout.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.mabims.dev';

const HIJRI_MONTHS = [
  'Muharram', 'Safar', 'Rabiul Awal', 'Rabiul Akhir',
  'Jumadil Awal', 'Jumadil Akhir', 'Rajab', "Sya'ban",
  'Ramadhan', 'Syawal', "Dzulqa'dah", 'Dzulhijjah',
];
const WEEKDAYS = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'];
const WEEKDAYS_FULL_NAME = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'];
const WEEKDAYS_FULL = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
const GREG_MONTHS = [
  'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun',
  'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des',
];
const EVENT_NAMES: Record<string, string> = {
  awal_ramadan: 'Awal Ramadan',
  idul_fitri: 'Idul Fitri',
  idul_adha: 'Idul Adha',
  '1_muharram': 'Tahun Baru Islam',
  maulid_nabi: "Maulid Nabi Muhammad ﷺ",
};

type DayItem = { gregorian: string; hijri: string; source: string };
type EventItem = { event: string; name: string; hijri: string; gregorian: string };
type Today = { day: number; month: number; month_name: string; year: number };

/* ── SSR fetch (build-time snapshot; client refresh keeps it current) ── */
let todayOut: Today | null = null;
let todayGregLine: { hijri: string; greg: string } | null = null;
try {
  const res = await fetch(`${apiBase}/api/v1/today`, { headers: { accept: 'application/json' } });
  if (res.ok) {
    const body = await res.json();
    todayOut = body.output;
    const d = new Date(`${body.input.date}T00:00:00`);
    const weekday = new Intl.DateTimeFormat('id-ID', { weekday: 'long' }).format(d);
    const greg = new Intl.DateTimeFormat('id-ID', {
      day: 'numeric', month: 'long', year: 'numeric',
    }).format(d);
    const gParts = { weekday, greg };
    todayGregLine = {
      hijriNumber: `${weekday}, ${todayOut.day} ${todayOut.month_name} ${todayOut.year} H · ${greg}`,
      hijri: `${todayOut.day} ${todayOut.month_name} ${todayOut.year} H`,
      greg: greg,
    };
  }
} catch {}

const events: EventItem[] = [];
if (todayOut) {
  try {
    const res = await fetch(`${apiBase}/api/v1/events?year=${todayOut.year}&calendar=hijri`);
    if (res.ok) events.push(...(await res.json()).events ?? []);
  } catch {}
}

const currentMonth = todayOut ? todayOut.month : 1;
const currentYear = todayOut ? todayOut.year : 1447;

/* Initial month grid, server-rendered so the HTML is crawlable */
const initialDays: DayItem[] = [];
if (todayOut) {
  try {
    const res = await fetch(`${apiBase}/api/v1/month?year=${currentYear}&month=${currentMonth}&calendar=hijri`);
    if (res.ok) initialDays.push(...(await res.json()).items ?? []);
  } catch {}
}

const todayHijri = todayOut
  ? `${currentYear}-${String(currentMonth).padStart(2, '0')}-${String(todayOut.day).padStart(2, '0')}`
  : '';
const initialSource = initialDays[0]?.source ?? 'mabims';
const sourceLabel = initialSource === 'mabims' ? 'Data publik Kemenag' : 'Perhitungan Neo MABIMS';

/* Hilal bare cards for the current month's deciding evening */
const hilalQuery = todayOut
  ? `month=${currentMonth}&year=${currentYear}`
  : 'month=1&year=1447';

const title = `Kalender Hijriah ${currentYear} H — Kalender MABIMS Indonesia`;
const description =
  `Kalender Hijriah ${currentYear} H lengkap berdasarkan kriteria MABIMS Kementerian Agama RI. ` +
  `Tanggal Hijriah hari ini, konversi Masehi–Hijriah, hari penting Islam, dan visibilitas hilal. Gratis & open-source.`;

const faqs = [
  {
    q: 'Apa itu Kalender MABIMS?',
    a: 'Kalender MABIMS adalah kalender Hijriah yang awal bulannya ditentukan dengan kriteria Neo MABIMS dari Kementerian Agama Republik Indonesia: tinggi bulan minimal 3 derajat dan elongasi minimal 6,4 derajat saat matahari terbenam, diuji di 25 titik pengamatan pesisir Indonesia.',
  },
  {
    q: 'Apakah kalender ini sama dengan kalender Kemenag?',
    a: `Ya. Untuk rentang tahun yang tercakup tabel resmi, data diambil langsung dari kalender publik Kementerian Agama RI. Di luar rentang tersebut, tanggal dihitung dengan kriteria Neo MABIMS dan ditandai sebagai perhitungan.`,
  },
  {
    q: 'Bagaimana cara mengonversi tanggal Masehi ke Hijriah?',
    a: 'Gunakan kolom konversi di halaman ini, atau panggil endpoint API gratis https://api.mabims.dev/api/v1/convert?date=YYYY-MM-DD&calendar=gregorian.',
  },
  {
    q: 'Apakah data ini bisa dipakai di aplikasi saya?',
    a: 'Bisa. Semua data di halaman ini tersedia melalui API publik gratis tanpa autentikasi di mabims.dev, atau melalui paket npm offline mabims-hijri.',
  },
];

const monthName = HIJRI_MONTHS[currentMonth - 1];
const weekdayIndex = (iso: string) => (new Date(`${iso}T00:00:00`).getDay() + 6) % 7;
const eventsByHijri = new Map(events.map((e) => [e.hijri, e.name]));

/* Build initial grid cells (shared logic with client via data attrs) */
let gridHTML = '';
{
  const days = initialDays;
  const leading = days.length ? weekdayIndex(days[0].gregorian) : 0;
  for (let i = 0; i < leading; i++) gridHTML += '<div class="kc is-empty"></div>';
  for (const item of days) {
    const hijriDay = Number(item.hijri.slice(8, 10));
    const [, gm, gd] = item.gregorian.split('-').map(Number);
    const isFri = weekdayIndex(item.gregorian) === 4;
    const isToday = item.hijri === todayHijri;
    const ev = eventsByHijri.get(item.hijri);
    const isWeekend = weekdayIndex(item.gregorian) >= 5;
    gridHTML += `<div class="kc${isFri ? ' is-fri' : ''}${isWeekend ? ' is-weekend' : ''}${isToday ? ' is-today' : ''}${ev ? ' has-event' : ''}" data-hijri="${item.hijri}" data-greg="${item.gregorian}">` +
      `<span class="kc-day">${hijriDay}</span><span class="kc-greg">${gd} ${GREG_MONTHS[gm - 1]}</span>` +
      (ev ? '<span class="kc-ev"></span>' : '') +
      `</div>`;
  }
  const filled = leading + days.length;
  const total = Math.ceil(filled / 7) * 7;
  for (let i = filled; i < total; i++) gridHTML += '<div class="kc is-empty"></div>';
}
const HIJRI_MONTHS_SHORT = [
  'Muh', 'Saf', 'Rb. I', 'Rb. II', 'Jm. I', 'Jm. II', 'Raj', 'Syb',
  'Ram', 'Syw', 'Dq', 'Dh',
];
const initialMonthEvents = initialDays
  .map((d) => {
    const name = eventsByHijri.get(d.hijri);
    if (!name) return null;
    const label = `${Number(d.hijri.slice(8, 10))} ${HIJRI_MONTHS[Number(d.hijri.slice(5, 7)) - 1]} · ${name}`;
    return label;
  })
  .filter((v): v is string => Boolean(v));
---

<LandingLayout
  title={title}
  description={description}
  lang="id"
  canonical="https://mabims.dev/kalender-hijriah/"
  altId="https://mabims.dev/kalender-hijriah/"
  altEn="https://mabims.dev/en/hijri-calendar/"
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Kalender Hijriah MABIMS",
        "url": "https://mabims.dev/kalender-hijriah/",
        "inLanguage": "id",
        "isPartOf": { "@type": "WebSite", "name": "mabims.dev", "url": "https://mabims.dev" },
        "about": "Kalender Hijriah Indonesia berdasarkan kriteria Neo MABIMS Kementerian Agama RI."
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })} />
  </Fragment>

  {/* ── Hero ── */}
  <section class="kh-hero" id="kalender">
    <div class="kh-stars" aria-hidden="true">
      <span class="star" style="top:12%;left:8%;opacity:.6"></span>
      <span class="star" style="top:25%;left:72%;opacity:.5"></span>
      <span class="star" style="top:68%;left:88%;opacity:.55"></span>
      <span class="star" style="top:45%;left:18%;opacity:.45"></span>
      <span class="star" style="top:80%;left:55%;opacity:.5"></span>
      <span class="star" style="top:15%;left:45%;opacity:.6"></span>
      <span class="star" style="top:55%;left:92%;opacity:.45"></span>
      <span class="star" style="top:72%;left:30%;opacity:.55"></span>
    </div>
    <div class="kh-hero-inner">
      <h1 class="kh-title">Kalender Hijriah <span class="kh-accent">MABIMS</span></h1>
      <p class="kh-today" data-today>
        <span class="kh-today-line" data-today-hijri>
          {todayOut && todayGregLine ? `${todayGregLine.hijriNumber} ` : '…'}
        </span>
      </p>
      <p class="kh-criteria">Berdasarkan kalender Kemenag · kriteria Neo MABIMS</p>
    </div>
  </section>

  {/* ── Month grid ── */}
  <section class="kh-cal">
    <div class="kh-cal-head">
      <div class="kh-cal-nav">
        <button type="button" class="kh-nav-btn" data-prev aria-label="Bulan sebelumnya">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <h2 class="kh-month-title">
          <span data-month-name>{monthName}</span>
          <span class="kh-month-year" data-month-year>{currentYear} H</span>
        </h2>
        <button type="button" class="kh-nav-btn" data-next aria-label="Bulan berikutnya">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
      <div class="kh-cal-tools">
        <div class="kh-toggle" role="group" aria-label="Tampilan tanggal">
          <button type="button" class="kh-toggle-btn is-active" data-mode="hijri">Hijriah</button>
          <button type="button" class="kh-toggle-btn" data-mode="gregorian">Masehi</button>
        </div>
      </div>
    </div>

    <div class="kh-card">
      <div class="kh-week">
        {WEEKDAYS.map((d, i) => (
    <span class:list={['kh-dow', { 'is-fri': i === 4 }]}>
      <span class="kh-dow-short">{d}</span>
      <span class="kh-dow-full">{WEEKDAYS_FULL_NAME[i]}</span>
    </span>
  ))}
      </div>
      <div class="kh-grid" data-grid set:html={gridHTML} />
      <div class="kh-events" data-events hidden={initialMonthEvents.length === 0}>
        {initialMonthEvents.map((e) => <span class="kh-ev-badge">{e}</span>)}
      </div>
    </div>

    <p class="kh-status" data-status hidden></p>
  </section>

  {/* ── Hilal cards ── */}
  <section class="kh-hilal" id="hilal">
    <div class="kh-section-head">
      <h2>Kenapa bulan ini <span class="accent">dimulai saat itu?</span></h2>
      <p>
        Awal bulan Hijriah ditentukan malam hari ke-29. Jika bulan sabit memenuhi kriteria
        Neo MABIMS — tinggi minimal 3° dan elongasi minimal 6,4° saat matahari terbenam di
        salah satu dari 25 titik pengamatan pesisir Indonesia — bulan berusia 29 hari.
        Berikut kondisi langit untuk penentuan awal <strong data-hilal-month>{monthName}</strong>.
      </p>
    </div>
    <div class="kh-hilal-grid">
      <figure class="kh-hilal-figure">
        <button type="button" class="kh-zoom" data-zoom="viz" aria-label="Perbesar grafik langit hilal">
          <img
            data-viz-img
            src={`${apiBase}/api/v1/hilal/viz?${hilalQuery}&bare=true`}
            alt={`Grafik langit visibilitas hilal ${monthName} ${currentYear} H`}
            loading="lazy"
          />
        </button>
        <figcaption>
          <span class="kh-graphic-title">Grafik langit</span>
          <a class="kh-download" href={`${apiBase}/api/v1/hilal/viz?${hilalQuery}&download=true`} download="hilal-viz.png">Unduh PNG</a>
        </figcaption>
      </figure>
      <figure class="kh-hilal-figure">
        <button type="button" class="kh-zoom" data-zoom="map" aria-label="Perbesar peta visibilitas hilal">
          <img
            data-map-img
            src={`${apiBase}/api/v1/hilal/map?${hilalQuery}&bare=true`}
            alt={`Peta wilayah visibilitas hilal ${monthName} ${currentYear} H`}
            loading="lazy"
          />
        </button>
        <figcaption>
          <span class="kh-graphic-title">Peta Indonesia</span>
          <a class="kh-download" href={`${apiBase}/api/v1/hilal/map?${hilalQuery}&download=true`} download="hilal-map.png">Unduh PNG</a>
        </figcaption>
      </figure>
    </div>
    <p class="kh-hilal-note">
      Ingin melihat riwayat penentuan sejak 1444 H? Kunjungi halaman <a href="/hilal/">Hilal</a>.
    </p>
  </section>

  {/* ── Tanggal penting ── */}
  <section class="kh-events-section" id="tanggal-penting">
    <div class="kh-section-head">
      <h2>Tanggal penting <span class="accent">{currentYear} H</span></h2>
      <p>Hari-hari istimewa dalam tahun Hijriah {currentYear}, berdasarkan kalender MABIMS.</p>
    </div>
    <div class="kh-events-list" data-events-list>
      {events.length === 0 && <p class="kh-loading">Memuat tanggal penting…</p>}
      {events.map((e) => {
        const g = new Date(`${e.gregorian}T00:00:00`);
        return (
          <article class="kh-event-row">
            <div class="kh-event-date">
              <span class="kh-event-day">{g.getDate()}</span>
              <span class="kh-event-month">{GREG_MONTHS[g.getMonth()]} {g.getFullYear()}</span>
            </div>
            <div class="kh-event-body">
              <span class="kh-event-name">{EVENT_NAMES[e.event] ?? e.name}</span>
              <span class="kh-event-hijri">{e.hijri}</span>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  {/* ── MABIMS blurb ── */}
  <section class="kh-about" id="tentang">
    <div class="kh-section-head">
      <h2>Tentang <span class="accent">kriteria MABIMS</span></h2>
    </div>
    <div class="kh-about-grid">
      <div class="kh-about-text">
        <p>
          <strong>MABIMS</strong> (Majelis Keputusan Bersama) adalah standar hisab awal bulan
          Hijriah dari <strong>Kementerian Agama Republik Indonesia</strong>. Kriteria terbaru,
          <em>Neo MABIMS</em>, mensyaratkan tinggi bulan sabit minimal <strong>3°</strong> dan
          elongasi minimal <strong>6,4°</strong> saat matahari terbenam — diuji di 25 titik
          pengamatan pesisir dari Aceh sampai Rote.
        </p>
        <p>
          Halaman ini menyajikan kalender tersebut secara gratis dan terbuka. Semua data berasal
          dari <a href="/">mabims.dev</a>, API kalender Hijriah open-source yang bisa kamu pakai
          di aplikasi, website, atau perangkat apapun — tanpa API key.
        </p>
        <p class="kh-disclaimer">
          MABIMS API adalah proyek independen dan tidak berafiliasi dengan Kementerian Agama RI.
          Hasil perhitungan bersifat estimasi astronomis, bukan pengumuman resmi.
        </p>
      </div>
      <div class="kh-about-facts">
        <div class="kh-fact"><span class="kh-fact-label">Ketinggian bulan</span><span class="kh-fact-value">≥ 3,0°</span></div>
        <div class="kh-fact"><span class="kh-fact-label">Elongasi</span><span class="kh-fact-value">≥ 6,4°</span></div>
        <div class="kh-fact"><span class="kh-fact-label">Titik pengamatan</span><span class="kh-fact-value">25 pesisir</span></div>
        <div class="kh-fact"><span class="kh-fact-label">Sumber data</span><span class="kh-fact-value">Kemenag RI</span></div>
      </div>
    </div>
  </section>

  {/* ── CTA ── */}
  <section class="kh-cta">
    <div class="kh-cta-card">
      <h2>Pakai data ini di aplikasi kamu</h2>
      <p>Satu endpoint, tanpa registrasi. Data kalender yang sama dengan halaman ini:</p>
      <div class="kh-cta-code"><code>curl "https://api.mabims.dev/api/v1/today"</code></div>
      <div class="kh-cta-actions">
        <a href="/quickstart/" class="btn btn-primary">Quickstart</a>
        <a href="https://api.mabims.dev/playground" class="btn btn-secondary" target="_blank" rel="noopener">Coba Playground</a>
      </div>
      <p class="kh-cta-hint">Lebih suka offline? <a href="/en/sdk/">Pakai paket npm mabims-hijri</a>.</p>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="kh-faq" id="faq">
    <div class="kh-section-head">
      <h2>Pertanyaan yang <span class="accent">sering diajukan</span></h2>
    </div>
    {faqs.map((f) => (
      <details class="kh-faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
</LandingLayout>

<style is:global>
  /* ── Hero ── */
  .kh-hero {
    position: relative;
    padding: clamp(4rem, 10vw, 7rem) 0 clamp(2.5rem, 5vw, 4rem);
    text-align: center;
    overflow: hidden;
  }
  .kh-stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .kh-stars .star {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
  }
  .kh-hero-inner { position: relative; z-index: 1; }
  .kh-title {
    margin: 0;
    font-size: clamp(2.4rem, 1.2rem + 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--sl-color-white);
  }
  .kh-title .kh-accent { color: var(--sl-color-accent); }
  .kh-today {
    margin: 1.1rem 0 0;
  }
  .kh-today-line {
    display: block;
    font-size: clamp(1.05rem, 0.6rem + 1.5vw, 1.4rem);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .kh-criteria {
    margin: 0.35rem 0 0;
    font-size: clamp(1.05rem, 0.6rem + 1.5vw, 1.4rem);
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  @media (max-width: 47.9rem) {
    .kh-criteria { display: none; }
  }

  /* ── Calendar ── */
  .kh-cal { padding: clamp(2rem, 4vw, 3rem) 0; }
  .kh-cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  @media (max-width: 53.99rem) {
    .kh-cal-head {
      flex-direction: column;
      justify-content: center;
      gap: 0.65rem;
    }
    .kh-cal-nav { order: 1; }
    .kh-cal-tools { order: 2; width: 100%; display: flex; justify-content: center; }
  }
  .kh-cal-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
  }
  .kh-cal-nav .kh-nav-btn:first-of-type { justify-self: start; }
  .kh-cal-nav .kh-nav-btn:last-of-type, .kh-cal-nav [data-next] { justify-self: end; }
  .kh-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .kh-nav-btn:hover:not(:disabled) {
    border-color: rgba(254, 207, 70, 0.4);
    color: var(--sl-color-accent);
  }
  .kh-nav-btn:disabled { opacity: 0.35; cursor: default; }
  .kh-nav-btn svg { width: 18px; height: 18px; }
  .kh-month-title {
    margin: 0;
    /* fixed at the width of "Jumadil Akhir" + year so the block never re-sizes */
    min-width: 10.4em;
    text-align: center;
    font-size: clamp(1.3rem, 1rem + 1.5vw, 1.8rem);
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .kh-month-year {
    font-weight: 400;
    font-size: 0.75em;
    color: var(--sl-color-gray-3);
    margin-left: 0.35rem;
  }
  .kh-toggle {
    display: inline-flex;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    overflow: hidden;
  }
  .kh-toggle-btn {
    padding: 0.5rem 1rem;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .kh-toggle-btn.is-active {
    background: var(--sl-color-accent);
    color: #1a1a2e;
  }
  .kh-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
  }
  .kh-week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .kh-dow {
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .kh-dow-short { display: inline; }
  .kh-dow-full { display: none; }
