    bottom: 0.85rem;
    left: 50%;
    transform: translateX(-50%);
    max-width: min(88vw, 720px);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.85rem;
    line-height: 1.4;
    text-align: center;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }
  .pswp__hilal-caption:empty {
    display: none;
  }
</style>
<script>
  import { openPswp } from '../lib/pswp-lightbox.ts';

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const zoom = target.closest<HTMLElement>('[data-zoom]');
    if (zoom) {
      const img = zoom.querySelector<HTMLImageElement>('img');
      if (img?.src) openPswp(img.src, img.alt, 1440, 1520);
      return;
    }
  });
</script>
