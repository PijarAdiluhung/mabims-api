---
import LandingLayout from '../components/LandingLayout.astro';
import Cta from '../components/landing/Cta.astro';

export const prerender = false;

/* Server render hits the API over the compose network (apiBase); anything
   printed into the markup that browsers fetch directly uses the public base
   (publicApiBase) so crawlers and no-JS visitors get working URLs. */
const apiBase = import.meta.env.INTERNAL_API_BASE
  ?? (typeof process !== 'undefined' ? process.env.INTERNAL_API_BASE : undefined)
  ?? 'http://localhost:8000';
const publicApiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.mabims.dev';

/* Core content must never render as an empty shell: a failure here throws and
   the request fails (never cached with placeholders until midnight). */
async function fetchCoreJson(path: string) {
  const res = await fetch(`${apiBase}${path}`, { headers: { accept: 'application/json' } });
  if (!res.ok) throw new Error(`SSR fetch failed: ${path} → ${res.status}`);
  return res.json();
}

const HIJRI_MONTHS = [
  'Muharram', 'Safar', 'Rabiul Awal', 'Rabiul Akhir',
  'Jumadil Awal', 'Jumadil Akhir', 'Rajab', "Sya'ban",
  'Ramadhan', 'Syawal', "Dzulqa'dah", 'Dzulhijjah',
];
const WEEKDAYS = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Ahd'];
const WEEKDAYS_FULL_NAME = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Ahad'];
const WEEKDAYS_FULL = ['Ahd', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
const ahad = (s: string) => s.replace('Minggu', 'Ahad');
const GREG_MONTHS = [
  'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun',
  'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des',
];
const EVENT_NAMES: Record<string, string> = {
  awal_ramadan: 'Awal Ramadan',
  idul_fitri: 'Idul Fitri',
  idul_adha: 'Idul Adha',
  '1_muharram': 'Tahun Baru Islam',
  maulid_nabi: "Maulid Nabi Muhammad ﷺ",
};

type DayItem = { gregorian: string; hijri: string; source: string };
type EventItem = {
  event: string; name: string; hijri: string; gregorian: string;
  date_range: { hijri_start: string; hijri_end: string; gregorian_start: string; gregorian_end: string } | null;
};
type Today = { day: number; month: number; month_name: string; year: number; weekday?: string };

/* ── SSR fetch (fresh per request; client script stays the tz/maghrib layer) ── */
const todayBody = await fetchCoreJson('/api/v1/today');
const todayOut: Today = todayBody.output;
const todayGregIso: string = todayBody.input.date;
let todayGregLine: { hijriNumber: string; weekday: string; hijriLabel: string; greg: string } | null = null;
{
  const d = new Date(`${todayGregIso}T00:00:00`);
  const weekday = todayOut.weekday ?? ahad(new Intl.DateTimeFormat('id-ID', { weekday: 'long' }).format(d));
  const greg = new Intl.DateTimeFormat('id-ID', {
    day: 'numeric', month: 'long', year: 'numeric',
  }).format(d);
  todayGregLine = {
    hijriNumber: `${weekday}, ${todayOut.day} ${todayOut.month_name} ${todayOut.year} H · ${greg}`,
    weekday,
    hijriLabel: `${todayOut.day} ${todayOut.month_name} ${todayOut.year} H`,
    greg: greg,
  };
}

/* Cache till midnight Jakarta like the API's /today: Bunny caches per edge up
   to a day, origin renders at most once per region per day. */
{
  const jkt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
  }).formatToParts(new Date());
  const get = (t: string) => Number(jkt.find((p) => p.type === t)?.value ?? 0);
  const secsOfDay = get('hour') * 3600 + get('minute') * 60 + get('second');
  const ttl = 86400 - secsOfDay;
  Astro.response.headers.set('Cache-Control', `public, max-age=0, s-maxage=${ttl}`);
}

const events: EventItem[] = [];
{
  const body = await fetchCoreJson(`/api/v1/events?year=${todayOut.year}&calendar=hijri&include=all`);
  events.push(...(body.events ?? []));
}

const currentMonth = todayOut.month;
const currentYear = todayOut.year;

/* Initial month grid, server-rendered so the HTML is crawlable */
const initialDays: DayItem[] = (await fetchCoreJson(
  `/api/v1/month?year=${currentYear}&month=${currentMonth}&calendar=hijri`,
)).items ?? [];

const todayHijri = `${currentYear}-${String(currentMonth).padStart(2, '0')}-${String(todayOut.day).padStart(2, '0')}`;
const initialSource = initialDays[0]?.source ?? 'mabims';
const sourceLabel = initialSource === 'mabims' ? 'Data publik Kemenag' : 'Perhitungan Neo MABIMS';

/* 12-month overview, server-rendered so it's crawlable */
const dateId = (iso: string) =>
  new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
    .format(new Date(`${iso}T00:00:00`));
const yearRows: { name: string; start: string; end: string; days: number }[] = [];
{
  const months = ((await fetchCoreJson(`/api/v1/year?year=${currentYear}&calendar=hijri`)).months ?? {}) as Record<string, DayItem[]>;
    for (let m = 1; m <= 12; m++) {
      const items = months[String(m)] ?? [];
      if (!items.length) continue;
      yearRows.push({
        name: `${HIJRI_MONTHS[m - 1]} ${currentYear} H`,
        start: dateId(items[0].gregorian),
        end: dateId(items[items.length - 1].gregorian),
        days: items.length,
      });
    }
}

/* Hilal featured: the month whose start the next sighting evening decides */
type HilalEvening = {
  hijri_date: string;
  hijri_day: number;
  gregorian_date: string;
  sunset: string;
  moonset: string;
  moon_alt_deg: number;
  elongation_deg: number;
  illumination_pct: number;
  age_hours: number;
  deciding_site: { name: string };
  visible: boolean;
  alt_ok: boolean;
  elong_ok: boolean;
};
type HilalInfo = {
  month: { name: string; number: number; year: number; start: string };
  previous_month: { name: string; number: number; year: number; length: number };
  evening: HilalEvening;
  warnings: string[];
};

let hilalTarget = { month: currentMonth, year: currentYear };
{
  const add = todayOut.day <= 29 ? 1 : 2;
  let m = todayOut.month + add;
  let y = currentYear;
  while (m > 12) { m -= 12; y += 1; }
  hilalTarget = { month: m, year: y };
}

/* Hilal is a non-critical feature section: on failure the placeholder stays and
   the client script (loadHilal) refills it, so never fail the page over it. */
let hilalItem: HilalInfo | null = null;
try {
  const res = await fetch(`${apiBase}/api/v1/hilal/info?month=${hilalTarget.month}&year=${hilalTarget.year}`);
  if (res.ok) hilalItem = await res.json();
} catch {}

const numId = (v: number) => v.toFixed(1).replace('.', ',');
const fmtAltId = (v: number) => `${v > 0 ? '+' : ''}${numId(v)}°`;
const idDate = (iso: string) =>
  ahad(new Intl.DateTimeFormat('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
    .format(new Date(`${iso}T00:00:00`)));

let hilalExplainHtml = 'Memuat…';
let hilalFactsHtml = '';
if (hilalItem) {
  const ev = hilalItem.evening;
  const ok = ev.visible;
  const borderline = (hilalItem.warnings ?? []).some((w) => /threshold|ambang/i.test(w));
  const len = hilalItem.previous_month.length;
  const addStep = len === 29 || (len !== 30 && ok) ? 1 : 2;
  const startDt = new Date(`${ev.gregorian_date}T00:00:00`);
  startDt.setDate(startDt.getDate() + addStep);
  const startIso = startDt.toISOString().slice(0, 10);
  const isPast = todayGregIso !== '' && ev.gregorian_date < todayGregIso;

  hilalExplainHtml =
    `Kapan <b class="exp-month">${hilalItem.month.name}</b> dimulai? ` +
    `Berdasarkan kriteria Neo MABIMS, kondisi bulan pada tanggal ${ev.hijri_day} ` +
    `${hilalItem.previous_month.name} ` +
    (ok ? '<b class="is-exp-ok">memenuhi kriteria</b>' : '<b class="is-exp-bad">tidak memenuhi kriteria</b>') +
    `. Sehingga ${isPast ? '' : 'kemungkinan '}${hilalItem.month.name} dimulai tanggal <b>${idDate(startIso)}</b>. ` +
    'Rincian pemenuhan kriteria Neo MABIMS bisa dilihat di grafik di bawah.';

  const verdictCls = ok && borderline ? 'is-borderline' : ok ? 'is-ok' : 'is-bad';
  const verdictLabel = ok && borderline ? 'Mendekati batas' : ok ? 'Memenuhi kriteria' : 'Tidak memenuhi kriteria';
  const chip = (okParam: boolean | null) =>
    okParam == null ? '' : `<span class="fact-chip ${okParam ? 'is-ok' : 'is-bad'}">${okParam ? 'Lolos' : 'Gagal'}</span>`;
  const fmtPctId = (v: number) => `${v.toFixed(2).replace('.', ',')}%`;
  hilalFactsHtml =
    `<div class="kh-facts-head"><span class="kh-verdict ${verdictCls}">${verdictLabel}</span>` +
    `<span class="kh-facts-note">1 ${hilalItem.month.name} ${hilalItem.month.year} H · malam ${idDate(ev.gregorian_date)}</span></div>` +
    `<div class="kh-facts-grid">` +
    `<div class="kh-fact"><span class="kh-fact-label">Tinggi bulan</span><span class="kh-fact-value">${fmtAltId(ev.moon_alt_deg)}${chip(ev.alt_ok)}</span><span class="kh-fact-min">min. 3,0°</span></div>` +
    `<div class="kh-fact"><span class="kh-fact-label">Elongasi</span><span class="kh-fact-value">${numId(ev.elongation_deg)}°${chip(ev.elong_ok)}</span><span class="kh-fact-min">min. 6,4°</span></div>` +
    `<div class="kh-fact"><span class="kh-fact-label">Iluminasi</span><span class="kh-fact-value">${fmtPctId(ev.illumination_pct)}</span></div>` +
    `<div class="kh-fact"><span class="kh-fact-label">Umur bulan</span><span class="kh-fact-value">${numId(ev.age_hours)} jam</span></div>` +
    `<div class="kh-fact"><span class="kh-fact-label">Matahari terbenam</span><span class="kh-fact-value">${ev.sunset}</span></div>` +
    `<div class="kh-fact"><span class="kh-fact-label">Bulan terbenam</span><span class="kh-fact-value">${ev.moonset}</span></div>` +
    `<div class="kh-fact"><span class="kh-fact-label">Titik pengamat</span><span class="kh-fact-value">${ev.deciding_site.name}</span></div>` +
    `</div>`;
}

const hilalQuery = `month=${hilalTarget.month}&year=${hilalTarget.year}`;
const hilalDateShort = hilalItem
  ? new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })
      .format(new Date(`${hilalItem.evening.gregorian_date}T00:00:00`))
  : '';

const masehiYear = Number(todayGregIso.slice(0, 4)) || 2026;
const title = `Kalender Hijriah MABIMS ${currentYear} (${masehiYear}) • Kriteria Kemenag Neo MABIMS`;
const description =
  `Kalender Hijriah ${currentYear} H (${masehiYear}) berdasarkan kriteria MABIMS Kementerian Agama RI. ` +
  `Tanggal Hijriah hari ini, awal tiap bulan, hari penting Islam, dan data visibilitas hilal. Gratis & open-source.`;

const awalRamadan = events.find((e) => e.event === 'awal_ramadan') ?? null;
const faqs = [
  {
    q: 'Apa itu Kalender MABIMS?',
    a: 'Kalender MABIMS adalah kalender Hijriah yang awal bulannya ditentukan dengan kriteria Neo MABIMS dari Kementerian Agama Republik Indonesia: tinggi bulan minimal 3 derajat dan elongasi minimal 6,4 derajat saat matahari terbenam, diuji di 25 titik pengamatan pesisir Indonesia.',
  },
  {
    q: 'Apakah kalender ini sama dengan kalender Kemenag?',
    a: `Ya. Untuk rentang tahun yang tercakup tabel resmi, data diambil langsung dari kalender publik Kementerian Agama RI. Di luar rentang tersebut, tanggal dihitung dengan kriteria Neo MABIMS dan ditandai sebagai perhitungan.`,
  },
  {
    q: 'Bagaimana cara mengonversi tanggal Masehi ke Hijriah?',
    aPlain: 'Gunakan konverter di mabims.dev/demo/converter, atau panggil endpoint API gratis https://api.mabims.dev/api/v1/convert?date=YYYY-MM-DD&calendar=gregorian.',
    aHtml: 'Gunakan <a href="/demo/converter/" style="color:var(--sl-color-accent)">konverter di halaman demo</a>, atau panggil endpoint API gratis <code>https://api.mabims.dev/api/v1/convert?date=YYYY-MM-DD&calendar=gregorian</code>.',
  },
  {
    q: 'Apakah data ini bisa dipakai di aplikasi saya?',
    a: 'Bisa. Semua data di halaman ini tersedia melalui API publik gratis tanpa autentikasi di mabims.dev, atau melalui paket npm offline mabims-hijri.',
  },
  ...(awalRamadan
    ? [{
        q: `1 Ramadhan ${currentYear} H jatuh pada tanggal berapa?`,
        a: `Berdasarkan kriteria Neo MABIMS (data publik Kemenag), 1 Ramadhan ${currentYear} H diperkirakan jatuh pada ${dateId(awalRamadan.gregorian)}. Awal bulan tetap dikonfirmasi lewat hasil rukyah dan sidang isbat Kementerian Agama.`,
      }]
    : []),
  {
    q: 'Kapan tanggal Hijriah berganti menjadi hari berikutnya?',
    a: 'Dalam penetapan Kemenag dan standar MABIMS, tanggal Hijriah berganti saat matahari terbenam (maghrib), bukan pukul 00.00 seperti kalender Masehi. Karena itu kegiatan malam setelah maghrib sudah dihitung sebagai tanggal Hijriah berikutnya.',
  },
  {
    q: 'Mengapa kalender Hijriah di HP atau Google berbeda beberapa hari dengan MABIMS?',
    a: "Sebagian besar aplikasi dan Google Calendar memakai kalender Umm al-Qura (standar Arab Saudi), sedangkan kalender MABIMS mengikuti rukyah dan keputusan Kementerian Agama RI. Metode dan lokasi pengamatannya berbeda, sehingga hasilnya bisa selisih ±1 hari, terutama pada awal Ramadhan, Syawal, dan Dzulhijjah.",
  },
];

const monthName = HIJRI_MONTHS[currentMonth - 1];
const weekdayIndex = (iso: string) => (new Date(`${iso}T00:00:00`).getDay() + 6) % 7;
const eventsByHijri = new Map<string, string>();
for (const e of events) {
  const name = EVENT_NAMES[e.event] ?? e.name;
  if (e.date_range) {
    const ym = e.hijri.slice(0, 8);
    const sd = Number(e.date_range.hijri_start.slice(8, 10));
    const ed = Number(e.date_range.hijri_end.slice(8, 10));
    for (let d = sd; d <= ed; d++) {
      eventsByHijri.set(`${ym}${String(d).padStart(2, '0')}`, name);
    }
  } else {
    eventsByHijri.set(e.hijri, name);
  }
}

/* Build initial grid cells (shared logic with client via data attrs) */
let gridHTML = '';
{
  const days = initialDays;
  const leading = days.length ? weekdayIndex(days[0].gregorian) : 0;
  for (let i = 0; i < leading; i++) gridHTML += '<div class="kc is-empty"></div>';
  for (const item of days) {
    const hijriDay = Number(item.hijri.slice(8, 10));
    const [, gm, gd] = item.gregorian.split('-').map(Number);
    const isFri = weekdayIndex(item.gregorian) === 4;
    const isToday = item.hijri === todayHijri;
    const ev = eventsByHijri.get(item.hijri);
    const isWeekend = weekdayIndex(item.gregorian) >= 5;
    gridHTML += `<div class="kc${isFri ? ' is-fri' : ''}${isWeekend ? ' is-weekend' : ''}${isToday ? ' is-today' : ''}${ev ? ' has-event' : ''}" data-hijri="${item.hijri}" data-greg="${item.gregorian}">` +
      `<span class="kc-day">${hijriDay}</span><span class="kc-greg">${gd} ${GREG_MONTHS[gm - 1]}</span>` +
      (ev ? '<span class="kc-ev"></span>' : '') +
      `</div>`;
  }
  const filled = leading + days.length;
  const total = Math.ceil(filled / 7) * 7;
  for (let i = filled; i < total; i++) gridHTML += '<div class="kc is-empty"></div>';
}
const HIJRI_MONTHS_SHORT = [
  'Muh', 'Saf', 'Rb. I', 'Rb. II', 'Jm. I', 'Jm. II', 'Raj', 'Syb',
  'Ram', 'Syw', 'Dq', 'Dh',
];
const initialMonthEvents: string[] = [];
{
  const ym = `${currentYear}-${String(currentMonth).padStart(2, '0')}`;
  for (const e of events) {
    if (e.hijri.slice(0, 7) !== ym) continue;
    const name = EVENT_NAMES[e.event] ?? e.name;
    if (e.date_range) {
      initialMonthEvents.push(
        `${Number(e.date_range.hijri_start.slice(8, 10))}–${Number(e.date_range.hijri_end.slice(8, 10))} ${monthName} · ${name}`,
      );
    } else {
      initialMonthEvents.push(`${Number(e.hijri.slice(8, 10))} ${monthName} · ${name}`);
    }
  }
}
---

<LandingLayout
  title={title}
  description={description}
  lang="id"
  canonical="https://mabims.dev/kalender-hijriah/"
  altId="https://mabims.dev/kalender-hijriah/"
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Kalender Hijriah MABIMS",
        "url": "https://mabims.dev/kalender-hijriah/",
        "inLanguage": "id",
        "isPartOf": { "@type": "WebSite", "name": "mabims.dev", "url": "https://mabims.dev" },
        "about": "Kalender Hijriah Indonesia berdasarkan kriteria Neo MABIMS Kementerian Agama RI."
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.aPlain ?? f.a },
      })),
    })} />
  </Fragment>

  {/* ── Hero ── */}
  <section class="kh-hero" id="kalender">
    <div class="kh-stars" aria-hidden="true">
      <span class="star" style="top:12%;left:8%;opacity:.6"></span>
      <span class="star" style="top:25%;left:72%;opacity:.5"></span>
      <span class="star" style="top:68%;left:88%;opacity:.55"></span>
      <span class="star" style="top:45%;left:18%;opacity:.45"></span>
      <span class="star" style="top:80%;left:55%;opacity:.5"></span>
      <span class="star" style="top:15%;left:45%;opacity:.6"></span>
      <span class="star" style="top:55%;left:92%;opacity:.45"></span>
      <span class="star" style="top:72%;left:30%;opacity:.55"></span>
    </div>
    <div class="kh-hero-inner">
      <h1 class="kh-title">Kalender Hijriah <span class="kh-accent">MABIMS</span></h1>
      <p class="kh-today" data-today>
        <span class="kh-today-line" data-today-hijri>
          {todayOut && todayGregLine ? (
            <Fragment>{todayGregLine.weekday}, <span class="kh-today-hj">{todayGregLine.hijriLabel}</span><span class="kh-today-greg"> · {todayGregLine.greg}</span></Fragment>
          ) : '…'}
        </span>
      </p>
      <p class="kh-criteria">Berdasarkan kalender Kemenag · kriteria Neo MABIMS</p>
    </div>
  </section>

  {/* ── Month grid ── */}
  <section class="kh-cal">
    <div class="kh-cal-head">
      <div class="kh-cal-nav">
        <button type="button" class="kh-nav-btn" data-prev aria-label="Bulan sebelumnya">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <h2 class="kh-month-title">
          <span data-month-name>{monthName}</span>
          <span class="kh-month-year" data-month-year>{currentYear} H</span>
        </h2>
        <button type="button" class="kh-nav-btn" data-next aria-label="Bulan berikutnya">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
      <div class="kh-cal-tools">
        <div class="kh-toggle" role="group" aria-label="Tampilan tanggal">
          <button type="button" class="kh-toggle-btn is-active" data-mode="hijri">Hijriah</button>
          <button type="button" class="kh-toggle-btn" data-mode="gregorian">Masehi</button>
        </div>
      </div>
    </div>

    <div class="kh-card">
      <div class="kh-week">
        {WEEKDAYS.map((d, i) => (
    <span class:list={['kh-dow', { 'is-fri': i === 4 }]}>
      <span class="kh-dow-short">{d}</span>
      <span class="kh-dow-full">{WEEKDAYS_FULL_NAME[i]}</span>
    </span>
  ))}
      </div>
      <div class="kh-grid" data-grid set:html={gridHTML} />
      <div class="kh-events" data-events hidden={initialMonthEvents.length === 0}>
        {initialMonthEvents.map((e) => <span class="kh-ev-badge">{e}</span>)}
      </div>
    </div>

    <p class="kh-status" data-status hidden></p>

    {yearRows.length > 0 && (
    <details class="kh-year-details">
      <summary>Tampilkan rentang per bulan (12 bulan, {currentYear} H)</summary>
      <div class="kh-year-table-wrap">
        <table class="kh-year-table">
          <thead>
            <tr><th>Bulan Hijriah</th><th>Tanggal Masehi</th><th>Jumlah hari</th></tr>
          </thead>
          <tbody>
            {yearRows.map((r) => (
              <tr>
                <th scope="row">{r.name}</th>
                <td>{r.start === r.end ? r.start : `${r.start} – ${r.end}`}</td>
                <td>{r.days}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="kh-year-note">
          Ukuran kalender Hijriah berbasis data publik Kemenag. Bulan berikutnya tetap dikonfirmasi
          lewat hasil rukyah dan sidang isbat.
        </p>
      </div>
    </details>
    )}
  </section>

  {/* ── Hilal cards (featured, hijri month nav) ── */}
  <section class="kh-hilal" id="hilal">
    <div class="kh-hilal-head">
    <h2 class="kh-section-title">Grafik <span class="accent">Visibilitas</span></h2>
    <div class="kh-hilal-nav">
      <button type="button" class="kh-nav-btn" data-hprev aria-label="Bulan sebelumnya" disabled={hilalTarget.month <= 1}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <h3 class="kh-hilal-title">
        <span data-hmonth>{hilalItem?.month.name ?? HIJRI_MONTHS[hilalTarget.month - 1]}</span>
        <span class="kh-month-year" data-hyear>{hilalTarget.year} H</span>
      </h3>
      <button type="button" class="kh-nav-btn" data-hnext aria-label="Bulan berikutnya" disabled={hilalTarget.month >= 12}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
      <p class="kh-hilal-explain" data-explain set:html={hilalExplainHtml} />
      <p class="kh-hilal-disclaimer">Hanya estimasi, bukan pengumuman resmi.</p>
    </div>

    <div class="kh-hilal-grid">
      <figure class="kh-hilal-figure">
        <button type="button" class="kh-zoom" data-zoom="map" aria-label="Perbesar peta wilayah visibilitas hilal">
          <img
            data-map-img
            src={`${publicApiBase}/api/v1/hilal/map?${hilalQuery}&bare=true`}
            alt={`Peta wilayah visibilitas hilal ${hilalTarget.month}/${hilalTarget.year}`}
            width="1440"
            height="1520"
            loading="lazy"
            decoding="async"
          />
          <span class="kh-zoom-hint">Perbesar</span>
        </button>
        <figcaption>
          <span class="kh-graphic-title">Peta wilayah</span>
          <span class="kh-graphic-date" data-map-date>{hilalDateShort}</span>
          <a class="kh-download" data-map-dl href={`${publicApiBase}/api/v1/hilal/map?${hilalQuery}&download=true`} download="hilal-map.png">Unduh kartu</a>
        </figcaption>
      </figure>

      <figure class="kh-hilal-figure">
        <button type="button" class="kh-zoom" data-zoom="viz" aria-label="Perbesar grafik langit visibilitas hilal">
          <img
            data-viz-img
            src={`${publicApiBase}/api/v1/hilal/viz?${hilalQuery}&bare=true`}
            alt={`Grafik langit visibilitas hilal ${hilalTarget.month}/${hilalTarget.year}`}
            width="1440"
            height="1520"
            loading="lazy"
            decoding="async"
          />
          <span class="kh-zoom-hint">Perbesar</span>
