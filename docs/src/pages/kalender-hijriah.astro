        const g = new Date(`${e.gregorian}T00:00:00`);
        return (
          <article class="kh-event-row">
            <div class="kh-event-date">
              <span class="kh-event-day">{g.getDate()} {GREG_MONTHS[g.getMonth()]}</span>
              <span class="kh-event-year">{g.getFullYear()}</span>
            </div>
            <div class="kh-event-body">
              <span class="kh-event-name">{EVENT_NAMES[e.event] ?? e.name}</span>
              <span class="kh-event-hijri">
                {e.date_range
