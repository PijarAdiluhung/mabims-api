</style>

<script>
  const API = import.meta.env.PUBLIC_API_BASE ?? 'https://api.mabims.dev';
  const PAGE = 12;

  const $ = (sel: string, root: ParentNode = document) => root.querySelector<HTMLElement>(sel);
  const $$ = (sel: string, root: ParentNode = document) =>
    Array.from(root.querySelectorAll<HTMLElement>(sel));

  type Site = { name: string; lat: number; lon: number; elev_m: number; tz: string };
  type Evening = {
    hijri_date: string;
    hijri_day: number;
    gregorian_date: string;
    sunset: string;
    moonset: string;
    moon_alt_deg: number;
    moon_az_deg: number;
    sun_alt_deg: number;
    elongation_deg: number;
    illumination_pct: number;
    age_hours: number;
    deciding_site: Site;
    sites_checked: number;
    alt_ok: boolean;
    elong_ok: boolean;
    visible: boolean;
  };
  type Item = {
    month: { name: string; number: number; year: number; start: string };
    previous_month: { name: string; number: number; year: number; length: number };
    evening: Evening;
    source: string;
    warnings: string[];
  };

  const state = { history: [] as Item[], shown: PAGE };
  let upcoming: Item | null = null;

  const DAY_FMT = new Intl.DateTimeFormat('id-ID', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
  const SHORT_FMT = new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });

  const SOURCE_LABELS: Record<string, string> = {
    mabims: 'Tabel resmi Kemenag',
    'mabims-computed': 'Perhitungan Neo MABIMS',
    'mabims-retro': 'Proyeksi retro',
  };

  const ahad = (s: string) => s.replace('Minggu', 'Ahad');
  const fmtDate = (iso: string) => ahad(DAY_FMT.format(new Date(`${iso}T00:00:00`)));
  const fmtDateShort = (iso: string) => SHORT_FMT.format(new Date(`${iso}T00:00:00`));
  const fmtNum = (v: number) => v.toFixed(1).replace('.', ',');
  const fmtAlt = (v: number) => `${v > 0 ? '+' : ''}${fmtNum(v)}°`;
  const fmtElong = (v: number) => `${fmtNum(v)}°`;
  const fmtPct = (v: number) => `${v.toFixed(2).replace('.', ',')}%`;
  const keyOf = (item: Item) => `${item.month.year}-${String(item.month.number).padStart(2, '0')}`;

  async function api(path: string, params?: Record<string, string>): Promise<any> {
    const url = new URL(`${API}${path}`);
    if (params) for (const [k, v] of Object.entries(params)) url.searchParams.set(k, v);
    const res = await fetch(url, { headers: { accept: 'application/json' } });
    if (!res.ok) throw new Error(`${res.status}`);
    return res.json();
  }

  function nextTarget(current: { day: number; month: number; year: number }) {
    const add = current.day <= 29 ? 1 : 2;
    let month = current.month + add;
    let year = current.year;
    while (month > 12) {
      month -= 12;
      year += 1;
    }
    return { month, year };
  }

  function minutesUntilSunset(ev: Evening): number {
    // Sunset wall-clock time at the deciding site → minutes from now.
    const [hh, mm] = ev.sunset.split(':').map(Number);
    const [y, m, d] = ev.gregorian_date.split('-').map(Number);
    const wall = Date.UTC(y, m - 1, d) + hh * 3600e3 + mm * 60e3;
    const dtf = new Intl.DateTimeFormat('en-US', {
      timeZone: ev.deciding_site.tz,
      hour12: false,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    });
    // Convert wall-time in site tz to a UTC instant: measure the site's
    // offset at our guess, then correct once (covers sub-day DST quirks).
    const round = (u: number) => {
      const p = dtf.formatToParts(new Date(u));
      const get = (t: string) => Number(p.find((x) => x.type === t)?.value ?? '0');
      return Date.UTC(get('year'), get('month') - 1, get('day'), get('hour') % 24, get('minute'), get('second'));
    };
    const instant = 2 * wall - round(wall);
    return Math.max(0, (instant - Date.now()) / 60e3);
  }

  function verdictInfo(item: Item, upcoming = false) {
    const borderline = (item.warnings ?? []).some((w) => /threshold|ambang/i.test(w));
    if (item.evening.visible && borderline) return { cls: 'is-borderline', label: 'Mendekati batas' };
    if (item.evening.visible) {
      return { cls: 'is-ok', label: upcoming ? 'Memenuhi kriteria' : 'Terlihat' };
    }
    return { cls: 'is-bad', label: upcoming ? 'Tidak memenuhi kriteria' : 'Tidak terlihat' };
  }

  function fact(label: string, value: string, min = '', ok: boolean | null = null) {
    const chip = ok == null ? '' : `<span class="fact-chip ${ok ? 'is-ok' : 'is-bad'}">${ok ? 'Lolos' : 'Gagal'}</span>`;
    const minEl = min ? `<span class="fact-min">${min}</span>` : '';
    return `<div class="fact"><span class="fact-label">${label}</span><span class="fact-value">${value}${chip}</span>${minEl}</div>`;
  }

  function factsHTML(item: Item, upcoming = false) {
    const ev = item.evening;
    const vi = verdictInfo(item, upcoming);
    const cells = [
      fact('Tinggi bulan', fmtAlt(ev.moon_alt_deg), 'min. 3,0°', ev.alt_ok),
      fact('Elongasi', fmtElong(ev.elongation_deg), 'min. 6,4°', ev.elong_ok),
      fact('Iluminasi', fmtPct(ev.illumination_pct)),
      fact('Umur bulan', `${fmtNum(ev.age_hours)} jam`),
      fact('Matahari terbenam', ev.sunset),
      fact('Bulan terbenam', ev.moonset),
      fact('Titik pengamat', ev.deciding_site.name),
    ].join('');
    return (
      `<div class="hilal-facts-head"><span class="verdict-badge ${vi.cls}">${vi.label}</span>` +
      `<span class="facts-note">1 ${item.month.name} ${item.month.year} H · malam ${fmtDate(ev.gregorian_date)}</span></div>` +
      `<div class="facts-grid">${cells}</div>`
    );
  }

  const PHASE_LABELS: Array<[number, string]> = [
    [1.5, 'New Moon'],
    [6, 'Waxing Crescent'],
    [8.5, 'First Quarter'],
    [13.5, 'Waxing Gibbous'],
    [16.5, 'Full Moon'],
    [21, 'Waning Gibbous'],
    [23, 'Last Quarter'],
    [29.4, 'Waning Crescent'],
    [30.5, 'New Moon'],
  ];
  const moonPhaseLabel = (moonDay: number) =>
    PHASE_LABELS.find(([limit]) => moonDay <= limit)?.[1] ?? 'New Moon';

  function renderToday(today: any) {
    const o = today.output;
    const day = $('[data-card-day]');
    const month = $('[data-card-month]');
    const year = $('[data-card-year]');
    const greg = $('[data-card-greg]');
    const phaseEl = $('[data-card-phase]');
    if (day) day.textContent = String(o.day);
    if (month) month.textContent = o.month_name;
    if (year) year.textContent = String(o.year);
    if (greg) greg.textContent = fmtDate(today.input.date);
    if (phaseEl) phaseEl.textContent = moonPhaseLabel(o.day);
  }

  const MOON_R = 70;

  // Correct moon phase: lit disc = half-circle outer arc + half-ellipse
  // terminator (semi-minor axis r*|cos(2π·phase)|). phase: 0=new, 0.5=full.
  function moonLitPath(phase: number) {
    if (phase < 0.001) return '';
    const r = MOON_R;
    if (phase > 0.999) {
      return `M 0 ${-r} A ${r} ${r} 0 1 1 0 ${r} A ${r} ${r} 0 1 1 0 ${-r} Z`;
    }
    const cosPhase = Math.cos(2 * Math.PI * phase);
    const minor = Math.abs(cosPhase) * r;
    const waxing = phase < 0.5;
    const outerSweep = waxing ? 1 : 0;
    // Crescent: terminator hugs the lit rim; gibbous: bulges into the dark
    // half. For waxing that needs sweep 1 when gibbous, for waning sweep 0.
    const innerSweep = (cosPhase < 0) === waxing ? 1 : 0;
    return (
      `M 0 ${-r}` +
      ` A ${r} ${r} 0 0 ${outerSweep} 0 ${r}` +
      ` A ${minor} ${r} 0 0 ${innerSweep} 0 ${-r}` +
      ' Z'
    );
  }

  function renderCountdown(today: any, item: Item) {
    const days = Math.round(
      (Date.parse(`${item.evening.gregorian_date}T00:00:00Z`) -
        Date.parse(`${today.input.date}T00:00:00Z`)) /
        86400000
    );
    const valueEl = $('[data-count-days]');
    const unitEl = $('[data-count-unit]');
    const hilalEl = $('[data-count-hilal]');
    const targetGreg = $('[data-target-greg]');
    if (hilalEl) hilalEl.textContent = item.month.name;
    if (targetGreg) targetGreg.textContent = fmtDate(item.evening.gregorian_date);
    if (days <= 0) {
      // Penentuan is tonight: count down to sunset at the deciding site.
      if (valueEl) valueEl.style.display = '';
      const minutes = minutesUntilSunset(item.evening);
      if (minutes <= 60) {
        if (valueEl) valueEl.textContent = String(Math.max(0, Math.round(minutes)));
        if (unitEl) unitEl.textContent = 'Menit Lagi';
      } else {
        if (valueEl) valueEl.textContent = String(Math.max(1, Math.ceil(minutes / 60)));
        if (unitEl) unitEl.textContent = 'Jam Lagi';
      }
    } else {
      if (valueEl) {
        valueEl.style.display = '';
        valueEl.textContent = String(days);
      }
      if (unitEl) unitEl.textContent = 'Hari Lagi';
    }

    const moonDay = today.output.day;
    const ev = item.evening;
    const phaseEl = $('[data-card-phase]');
    if (phaseEl) phaseEl.textContent = moonPhaseLabel(moonDay);
    const pct = Math.min(100, Math.max(0, (moonDay / 29) * 100));
    const arc = $('[data-moon-arc]') as HTMLElement | null;
    if (arc) arc.style.width = `${pct}%`;

    // Symodic phase centered mid-day: day 1 → thin waxing sliver, day ~15 →
    // full, day 29 → near-conjunction dark, day 30 → new moon.
    const phase = Math.min(0.999, Math.max(0.02, (moonDay - 0.5) / 29.53));
    const d = moonLitPath(phase);
    const lit = $('[data-moon-lit]');
    if (lit) lit.setAttribute('d', d);
    const litClip = $('[data-moon-litclip]');
    if (litClip) litClip.setAttribute('d', d);

    const setGauge = (
      valSel: string,
      chipSel: string,
      value: string,
      ok: boolean | null
    ) => {
      const valEl = $(valSel);
      if (valEl) valEl.textContent = value;
      const chip = $(chipSel);
      if (!chip) return;
      if (ok == null) {
        chip.hidden = true;
        return;
      }
      chip.hidden = false;
      chip.className = `fact-chip ${ok ? 'is-ok' : 'is-bad'}`;
      chip.textContent = ok ? 'Lolos' : 'Gagal';
    };
    setGauge('[data-gauge-alt]', '[data-gauge-alt-chip]', fmtAlt(ev.moon_alt_deg), ev.alt_ok);
    setGauge('[data-gauge-elong]', '[data-gauge-elong-chip]', fmtElong(ev.elongation_deg), ev.elong_ok);

    const siteEl = $('[data-count-site]');
    if (siteEl) siteEl.textContent = `Titik penentuan: ${ev.deciding_site.name}`;
  }

  function wireImage(
    zoom: HTMLElement,
    img: HTMLImageElement,
    etaEl: HTMLElement | null,
    label: string,
    etaStart: number
  ) {
    let timer: number | null = null;
    if (etaEl && etaStart > 0) {
      let remaining = etaStart;
      const tick = () => {
        etaEl.textContent =
          remaining > 0 ? `${label}… ~${remaining}s` : `Menyelesaikan ${label.toLowerCase()}…`;
      };
      tick();
      timer = window.setInterval(() => {
        remaining -= 1;
        tick();
        if (remaining <= -5 && timer !== null) window.clearInterval(timer);
      }, 1000);
    }
    img.addEventListener('load', () => {
      if (timer !== null) window.clearInterval(timer);
      zoom.classList.add('is-loaded');
    });
    img.addEventListener('error', () => {
      if (timer !== null) window.clearInterval(timer);
      if (etaEl) etaEl.textContent = 'Gagal memuat gambar — coba muat ulang.';
    });
  }

  function renderFeatured(item: Item) {
    upcoming = item;
    const q = `month=${item.month.number}&year=${item.month.year}`;
    const mapImg = $('[data-map-img]') as HTMLImageElement | null;
    const vizImg = $('[data-viz-img]') as HTMLImageElement | null;
    const mapZoom = $('[data-zoom="map"]');
    const vizZoom = $('[data-zoom="viz"]');
    if (mapImg && mapZoom) wireImage(mapZoom, mapImg, $('[data-map-eta]'), 'Merender peta', 35);
    if (vizImg && vizZoom) wireImage(vizZoom, vizImg, $('[data-viz-eta]'), 'Merender grafik', 0);
    if (mapImg) mapImg.src = `${API}/api/v1/hilal/map?${q}&bare=true`;
    if (vizImg) vizImg.src = `${API}/api/v1/hilal/viz?${q}&bare=true`;
    const dateEls = $$('[data-map-date],[data-viz-date]');
    for (const el of dateEls) el.textContent = fmtDateShort(item.evening.gregorian_date);
    const mapDl = $('[data-map-dl]') as HTMLAnchorElement | null;
    const vizDl = $('[data-viz-dl]') as HTMLAnchorElement | null;
    if (mapDl) mapDl.href = `${API}/api/v1/hilal/map?${q}&download=true`;
    if (vizDl) vizDl.href = `${API}/api/v1/hilal/viz?${q}&download=true`;
    const exp = $('[data-explain]');
    if (exp) {
      const ev = item.evening;
      const ok = ev.visible;
      const len = item.previous_month.length;
      const add = len === 29 || (len !== 30 && ok) ? 1 : 2;
      const start = new Date(`${ev.gregorian_date}T00:00:00`);
      start.setDate(start.getDate() + add);
      const startIso = `${start.getFullYear()}-${String(start.getMonth() + 1).padStart(2, '0')}-${String(start.getDate()).padStart(2, '0')}`;
      const name = `<b class="exp-month">${item.month.name}</b>`;
      exp.innerHTML =
        `Kapan ${name} dimulai? Berdasarkan kriteria Neo MABIMS, kondisi bulan pada tanggal ${ev.hijri_day} ` +
        `${item.previous_month.name} ` +
        (ok ? '<b class="is-exp-ok">memenuhi kriteria</b>' : '<b class="is-exp-bad">tidak memenuhi kriteria</b>') +
        `. Sehingga kemungkinan ${name} dimulai tanggal <b>${fmtDate(startIso)}</b>. ` +
        `Rincian pemenuhan kriteria Neo MABIMS bisa dilihat di grafik di bawah, atau lihat periode bulannya di ` +
        `<a href="/kalender-hijriah/" style="color:var(--sl-color-accent)">kalender Hijriah</a>.`;
    }
    const facts = $('[data-featured-facts]');
    if (facts) facts.innerHTML = factsHTML(item, true);
  }

  function rowHTML(item: Item) {
    const ev = item.evening;
    const vi = verdictInfo(item);
    const key = keyOf(item);
    const q = `month=${item.month.number}&year=${item.month.year}`;
    return (
      `<article class="history-item" data-key="${key}">` +
      '<div class="history-row">' +
      `<div class="history-id"><span class="history-name">${item.month.name}</span><span class="history-year">${item.month.year} H</span></div>` +
      `<div class="history-eve"><span class="history-evedate">${fmtDateShort(ev.gregorian_date)}</span><span class="history-eyecap">malam ${ev.hijri_date}</span></div>` +
      '<div class="history-mid">' +
      `<span class="verdict-badge ${vi.cls}">${vi.label}</span>` +
      `<span class="mini-chip ${ev.alt_ok ? 'is-ok' : 'is-bad'}">Alt ${fmtAlt(ev.moon_alt_deg)}</span>` +
      `<span class="mini-chip ${ev.elong_ok ? 'is-ok' : 'is-bad'}">Elong ${fmtElong(ev.elongation_deg)}</span>` +
      '</div>' +
      '<div class="history-actions">' +
      '<button type="button" data-info aria-expanded="false">Lihat detail</button>' +
      '</div></div>' +
      '<div class="history-panel" hidden>' +
      '<div class="history-media">' +
      `<figure><button type="button" class="history-zoom" data-zoom="map" aria-label="Perbesar peta ${item.month.name} ${item.month.year} H">` +
      `<img alt="Peta wilayah visibilitas hilal ${item.month.name} ${item.month.year} H" data-map data-src="${API}/api/v1/hilal/map?${q}&bare=true">` +
      `</button><figcaption><a class="hilal-download" href="${API}/api/v1/hilal/map?${q}&download=true" download="hilal-map-${key}.png">Unduh PNG</a></figcaption></figure>` +
      `<figure><button type="button" class="history-zoom" data-zoom="viz" aria-label="Perbesar grafik ${item.month.name} ${item.month.year} H">` +
      `<img alt="Grafik langit visibilitas hilal ${item.month.name} ${item.month.year} H" data-viz data-src="${API}/api/v1/hilal/viz?${q}&bare=true">` +
      `</button><figcaption><a class="hilal-download" href="${API}/api/v1/hilal/viz?${q}&download=true" download="hilal-viz-${key}.png">Unduh PNG</a></figcaption></figure>` +
      '</div>' +
      `<div class="hilal-facts">${factsHTML(item)}</div>` +
      '</div>' +
      '</article>'
    );
  }

  function renderHistory() {
    const list = $('[data-history]');
    if (!list) return;
    if (!state.history.length) {
      list.innerHTML = '<p class="hilal-loading">Riwayat tidak tersedia.</p>';
      return;
    }
    const rows = state.history.slice(0, state.shown);
    list.innerHTML = rows.map(rowHTML).join('');
    const more = $('[data-more]');
    if (more) more.hidden = state.shown >= state.history.length;
  }

  // ── Lightbox (PhotoSwipe) ──
  import { openPswp } from '../lib/pswp-lightbox.ts';

  function openLightbox(src: string, caption: string) {
    openPswp(src, caption, 1440, 1520);
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const zoom = target.closest('[data-zoom]') as HTMLElement | null;
    if (zoom) {
      const isMap = zoom.dataset.zoom === 'map';
      const scope = zoom.closest('.history-panel');
      const img = (
        scope
          ? scope.querySelector<HTMLImageElement>(isMap ? '[data-map]' : '[data-viz]')
          : $(isMap ? '[data-map-img]' : '[data-viz-img]')
      ) as HTMLImageElement | null;
      if (img?.src) {
        openLightbox(img.src, img.alt);
      }
      return;
    }

    const info = target.closest('[data-info]') as HTMLButtonElement | null;
    if (info) {
      const panel = info.closest('.history-item')?.querySelector('.history-panel') as HTMLElement | null;
      if (!panel) return;
      const open = info.getAttribute('aria-expanded') === 'true';
      info.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
      if (!open) {
        for (const img of panel.querySelectorAll<HTMLImageElement>('img[data-src]')) {
          img.src = img.dataset.src!;
          img.removeAttribute('data-src');
        }
      }
      return;
    }

    if (target.closest('[data-more]')) {
      state.shown += PAGE;
      renderHistory();
    }
  });

  async function setup() {
    try {
      const browserTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      let today: any;
      try {
        today = await api('/api/v1/today', browserTz ? { tz: browserTz } : undefined);
      } catch {
        today = await api('/api/v1/today');
      }
      renderToday(today);

      const hist = await api('/api/v1/hilal/history');
      const byKey = new Map<string, Item>(hist.months.map((it: Item) => [keyOf(it), it]));

      const target = nextTarget(today.output);
      const targetKey = `${target.year}-${String(target.month).padStart(2, '0')}`;
      const item = byKey.get(targetKey) ?? (await api('/api/v1/hilal/info', { month: String(target.month), year: String(target.year) }));

      renderCountdown(today, item);
      renderFeatured(item);

      state.history = hist.months
        .filter((it: Item) => keyOf(it) < targetKey)
        .sort((a: Item, b: Item) => (keyOf(a) < keyOf(b) ? 1 : -1));
      renderHistory();
    } catch (error) {
      const list = $('[data-history]');
      if (list) {
        list.innerHTML = `<p class="hilal-note">Gagal memuat data hilal (${String(error)}). Coba muat ulang halaman.</p>`;
      }
    }
  }

  setup();
</script>
