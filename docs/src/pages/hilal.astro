---
import LandingLayout from '../components/LandingLayout.astro';
import HilalHero from '../components/hilal/HilalHero.astro';
import SightingFeatured from '../components/hilal/SightingFeatured.astro';
import SightingHistory from '../components/hilal/SightingHistory.astro';
import HilalLightbox from '../components/hilal/HilalLightbox.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.mabims.dev';

let fallback: { day: number; month_name: string; year: number; greg: string } | null = null;
try {
  const res = await fetch(`${apiBase}/api/v1/today`);
  if (res.ok) {
    const body = await res.json();
    const d = new Date(`${body.input.date}T00:00:00`);
    const greg = new Intl.DateTimeFormat('id-ID', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(d);
    fallback = {
      day: body.output.day,
      month_name: body.output.month_name,
      year: body.output.year,
      greg: `${greg} · ${body.input.tz}`,
    };
  }
} catch {}

const title = 'Hilal — Visibilitas & Riwayat Penentuan Awal Bulan Hijriah';
const description =
  'Tanggal Hijriah hari ini, hitung mundur malam penentuan hilal, peta wilayah visibilitas, grafik langit, dan riwayat penentuan hilal sejak 1444 H berdasarkan kriteria Neo MABIMS.';
---

<LandingLayout title={title} description={description} lang="id" canonical="https://mabims.dev/hilal/">
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Hilal — Visibilitas & Riwayat Penentuan Awal Bulan Hijriah",
        "url": "https://mabims.dev/hilal/",
        "inLanguage": "id",
        "isPartOf": { "@type": "WebSite", "name": "mabims.dev", "url": "https://mabims.dev" },
        "about": "Visibilitas hilal Neo MABIMS: ketinggian bulan dan elongasi saat matahari terbenam di titik pengamatan pesisir Indonesia."
      }
    </script>
  </Fragment>

  <HilalHero fallback={fallback} />
  <SightingFeatured />
  <SightingHistory />
  <HilalLightbox />
</LandingLayout>

<style is:global>
  #sekarang,
  #berikutnya,
  #riwayat {
    scroll-margin-top: 5rem;
  }

  /* ── Hero ── */
  .hilal-hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding: clamp(2.5rem, 7vw, 4.5rem) 0 clamp(3.5rem, 8vw, 6.5rem);
    align-items: center;
    overflow: hidden;
  }

  @media (min-width: 64rem) {
    .hilal-hero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 4rem;
      min-height: min(calc(100svh - 6rem), 52rem);
    }
  }

  .hilal-grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1.5px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 95% 75% at 50% 40%, #000 35%, transparent 80%);
    mask-image: radial-gradient(ellipse 95% 75% at 50% 40%, #000 35%, transparent 80%);
    pointer-events: none;
  }

  .hilal-hero-copy {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .hilal-hero-copy {
      text-align: left;
    }
  }

  .hilal-eyebrow {
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }

  .hilal-date {
    margin: 0;
    font-size: clamp(2.25rem, 7vw, 4.25rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--sl-color-white);
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }

  .hilal-date-month {
    color: var(--sl-color-accent);
  }

  .hilal-date-year {
    font-size: 0.45em;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }

  .hilal-greg {
    margin: 0.85rem 0 0;
    font-size: clamp(0.95rem, 2.4vw, 1.1rem);
    color: var(--sl-color-gray-2);
  }

  .hilal-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 64rem) {
    .hilal-hero-actions {
      justify-content: flex-start;
    }
  }

  .hilal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: var(--sl-text-sm);
    text-decoration: none;
    transition: all 0.2s;
  }

  .hilal-btn-primary {
    background: var(--sl-color-accent);
    color: #1a1a2e !important;
    font-weight: 700;
  }

  .hilal-btn-primary:hover {
    background: var(--sl-color-accent-high);
    transform: translateY(-1px);
  }

  .hilal-btn-ghost {
    background: rgba(255, 255, 255, 0.07);
    color: var(--sl-color-white) !important;
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(4px);
  }

  .hilal-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.13);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .hilal-method {
    position: relative;
    margin: 1.25rem 0 0;
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }

  .hilal-countdown {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: clamp(1.75rem, 4vw, 2.25rem);
    text-align: center;
    background: rgba(35, 38, 47, 0.92);
    border: 1px solid rgba(254, 207, 70, 0.2);
    border-radius: 20px;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(6px);
  }

  @media (min-width: 28rem) {
    .hilal-countdown {
      grid-template-columns: auto 1fr;
      align-items: center;
      text-align: left;
      gap: 1.75rem;
    }
  }

  .countdown-arc {
    justify-self: center;
  }

  @media (min-width: 28rem) {
    .countdown-arc {
      justify-self: start;
    }
  }

  .countdown-arc svg {
    display: block;
    width: clamp(104px, 26vw, 140px);
    height: auto;
  }

  .arc-track {
    fill: none;
    stroke: rgba(255, 255, 255, 0.09);
    stroke-width: 6;
  }

  .arc-fill {
    fill: none;
    stroke: var(--sl-color-accent);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.8s ease;
    filter: drop-shadow(0 0 6px rgba(254, 207, 70, 0.45));
  }

  .moon-dark {
    fill: rgba(255, 255, 255, 0.1);
  }

  .countdown-eyebrow {
    position: relative;
    margin: 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sl-color-gray-3);
  }

  .countdown-value {
    position: relative;
    margin: 0.35rem 0;
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--sl-color-accent);
  }

  .countdown-unit {
    font-size: 0.32em;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }

  .countdown-target {
    position: relative;
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: var(--sl-color-gray-2);
  }

  .countdown-gauges {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .gauge-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0.55rem 0.75rem;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    font-size: 0.85rem;
  }

  .gauge-label {
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .gauge-value {
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .gauge-threshold {
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
  }

  .countdown-site {
    position: relative;
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  /* ── Section head ── */
  .hilal-section-head {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .hilal-section-head h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.6rem, 1rem + 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--sl-color-white);
  }

  .hilal-section-head .accent {
    color: var(--sl-color-accent);
  }

  .hilal-section-head p {
    max-width: 52rem;
    margin: 0;
    font-size: clamp(0.95rem, 0.5rem + 1vw, 1.05rem);
    line-height: 1.75;
    color: var(--sl-color-gray-2);
  }

  /* ── Featured ── */
  .hilal-featured {
    padding: clamp(3rem, 6vw, 6rem) 0;
  }

  .hilal-featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 64rem) {
    .hilal-featured-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .hilal-graphic {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
  }

  .hilal-zoom {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    background: #1f1235;
    cursor: zoom-in;
    line-height: 0;
  }

  .hilal-zoom img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 1520;
    object-fit: cover;
    opacity: 0;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .hilal-zoom.is-loaded img {
    opacity: 1;
  }

  .hilal-zoom:hover img {
    transform: scale(1.02);
  }

  .hilal-skeleton {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    line-height: 1.4;
    background: linear-gradient(110deg, rgba(255, 255, 255, 0.04) 30%, rgba(255, 255, 255, 0.09) 45%, rgba(255, 255, 255, 0.04) 60%);
    background-size: 200% 100%;
    animation: hilal-shimmer 1.4s ease-in-out infinite;
  }

  .hilal-zoom.is-loaded .hilal-skeleton {
    display: none;
  }

  .hilal-spinner {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 4px solid rgba(255, 255, 255, 0.12);
    border-top-color: var(--sl-color-accent);
    animation: hilal-spin 0.9s linear infinite;
  }

  .hilal-eta {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  @keyframes hilal-shimmer {
    to {
      background-position: -200% 0;
    }
  }

  @keyframes hilal-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hilal-zoom-hint {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    backdrop-filter: blur(4px);
  }

  .hilal-graphic figcaption {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }

  .hilal-graphic-title {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .hilal-download {
    margin-left: auto;
    color: var(--sl-color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .hilal-download:hover {
    text-decoration: underline;
  }

  /* ── Facts ── */
  .hilal-facts {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .hilal-facts-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .facts-note {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
  }

  .fact-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
  }

  .fact-value {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .fact-min {
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
  }

  .fact-chip {
    padding: 0.12rem 0.4rem;
    border-radius: 999px;
    font-size: 0.64rem;
    font-weight: 700;
  }

  /* ── Verdict + chips ── */
  .verdict-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .verdict-badge::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .verdict-badge.is-ok,
  .fact-chip.is-ok,
  .mini-chip.is-ok {
    color: #7ed957;
    background: rgba(126, 217, 87, 0.12);
  }

  .verdict-badge.is-bad,
  .fact-chip.is-bad,
  .mini-chip.is-bad {
    color: #ff6b6b;
    background: rgba(255, 107, 107, 0.12);
  }

  .verdict-badge.is-borderline {
    color: var(--sl-color-accent);
    background: rgba(254, 207, 70, 0.12);
  }

  /* ── History ── */
  .hilal-history {
    padding: clamp(3rem, 6vw, 6rem) 0;
  }

  .hilal-history-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .history-item {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    transition: border-color 0.2s;
  }

  .history-item:hover {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .history-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "id actions"
      "eve eve"
      "mid mid";
    gap: 0.5rem 1rem;
    align-items: center;
    padding: 1rem 1.1rem;
  }

  .history-mid {
    grid-area: mid;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .history-mid .verdict-badge {
    margin-inline-end: 0.4rem;
  }

  @media (min-width: 64rem) {
    .history-row {
      grid-template-columns: 11rem 13.5rem minmax(0, 1fr) auto;
      grid-template-areas: "id eve mid actions";
      gap: 1rem;
    }
  }

  .history-actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .history-actions .hilal-detail-btn,
  .history-actions button.hilal-detail,
  .history-actions button[data-info] {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid rgba(254, 207, 70, 0.35);
    border-radius: 999px;
    background: rgba(254, 207, 70, 0.08);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }

  .history-actions button[data-info]:hover {
    background: rgba(254, 207, 70, 0.16);
    border-color: rgba(254, 207, 70, 0.55);
  }

  .history-id {
    grid-area: id;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .history-name {
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .history-year {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  .history-eve {
    display: flex;
    flex-direction: column;
  }

  .history-evedate {
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }

  .history-eyecap {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .mini-chip {
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .history-actions {
    display: flex;
    align-items: center;
    justify-content: end;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .history-panel {
    display: grid;
    gap: 1.25rem;
    padding: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .history-panel[hidden] {
    display: none;
  }

  .history-media {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .history-media {
      grid-template-columns: 1fr 1fr;
    }
  }

  .history-media figure {
    margin: 0;
  }

  .history-zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    background: #1f1235;
    cursor: zoom-in;
    line-height: 0;
  }

  .history-zoom img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 1520;
    object-fit: cover;
    animation: hilal-spin-in 0.4s ease;
  }

  .history-zoom:hover img {
    transform: scale(1.02);
  }

  .history-media figcaption {
    text-align: right;
  }

  .history-media figcaption a {
    font-size: 0.8rem;
  }

  @keyframes hilal-spin-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .hilal-loading {
    margin: 0;
    color: var(--sl-color-gray-3);
  }

  .hilal-history-more {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .hilal-loadmore {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 10px;
    background: var(--sl-color-accent);
    color: #1a1a2e;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .hilal-loadmore:hover {
    background: var(--sl-color-accent-high);
    transform: translateY(-1px);
  }

  .hilal-note {
    margin: 1.5rem 0 0;
    font-weight: 600;
    color: #ff8f8f;
  }

  /* ── Lightbox ── */
  .hilal-lightbox {
    width: min(96vw, 900px);
    max-width: none;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }

  .hilal-lightbox::backdrop {
    background: rgba(10, 10, 14, 0.86);
    backdrop-filter: blur(4px);
  }

  .hilal-lightbox img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 82vh;
    object-fit: contain;
    border-radius: 12px;
    background: #1f1235;
  }

  .hilal-lightbox-caption {
    margin: 0.75rem 0 0;
    text-align: center;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }

  .hilal-lightbox-close {
    position: absolute;
    top: -2.6rem;
    right: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }

  @media (max-width: 40rem) {
    .hilal-lightbox-close {
      top: 0.5rem;
      right: 0.5rem;
      background: rgba(0, 0, 0, 0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hilal-zoom img,
    .arc-fill,
    .hilal-loadmore {
      transition: none !important;
    }

    .hilal-skeleton,
    .hilal-spinner {
      animation: none !important;
    }
  }
</style>

<script>
  const API = import.meta.env.PUBLIC_API_BASE ?? 'https://api.mabims.dev';
  const PAGE = 12;

  const $ = (sel: string, root: ParentNode = document) => root.querySelector<HTMLElement>(sel);
  const $$ = (sel: string, root: ParentNode = document) =>
    Array.from(root.querySelectorAll<HTMLElement>(sel));

  type Site = { name: string; lat: number; lon: number; elev_m: number; tz: string };
  type Evening = {
    hijri_date: string;
    hijri_day: number;
    gregorian_date: string;
    sunset: string;
    moonset: string;
    moon_alt_deg: number;
    moon_az_deg: number;
    sun_alt_deg: number;
    elongation_deg: number;
    illumination_pct: number;
    age_hours: number;
    deciding_site: Site;
    sites_checked: number;
    alt_ok: boolean;
    elong_ok: boolean;
    visible: boolean;
  };
  type Item = {
    month: { name: string; number: number; year: number; start: string };
    previous_month: { name: string; number: number; year: number; length: number };
    evening: Evening;
    source: string;
    warnings: string[];
  };

  const state = { history: [] as Item[], shown: PAGE };
  let upcoming: Item | null = null;

  const DAY_FMT = new Intl.DateTimeFormat('id-ID', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
  const SHORT_FMT = new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });

  const SOURCE_LABELS: Record<string, string> = {
    mabims: 'Tabel resmi Kemenag',
    'mabims-computed': 'Perhitungan Neo MABIMS',
    'mabims-retro': 'Proyeksi retro',
  };

  const fmtDate = (iso: string) => DAY_FMT.format(new Date(`${iso}T00:00:00`));
  const fmtDateShort = (iso: string) => SHORT_FMT.format(new Date(`${iso}T00:00:00`));
  const fmtNum = (v: number) => v.toFixed(1).replace('.', ',');
  const fmtAlt = (v: number) => `${v > 0 ? '+' : ''}${fmtNum(v)}°`;
  const fmtElong = (v: number) => `${fmtNum(v)}°`;
  const fmtPct = (v: number) => `${v.toFixed(2).replace('.', ',')}%`;
  const keyOf = (item: Item) => `${item.month.year}-${String(item.month.number).padStart(2, '0')}`;

  async function api(path: string, params?: Record<string, string>): Promise<any> {
    const url = new URL(`${API}${path}`);
    if (params) for (const [k, v] of Object.entries(params)) url.searchParams.set(k, v);
    const res = await fetch(url, { headers: { accept: 'application/json' } });
    if (!res.ok) throw new Error(`${res.status}`);
    return res.json();
  }

  function nextTarget(current: { day: number; month: number; year: number }) {
    const add = current.day <= 29 ? 1 : 2;
    let month = current.month + add;
    let year = current.year;
    while (month > 12) {
      month -= 12;
      year += 1;
    }
    return { month, year };
  }

  function verdictInfo(item: Item, upcoming = false) {
    const borderline = (item.warnings ?? []).some((w) => /threshold|ambang/i.test(w));
    if (item.evening.visible && borderline) return { cls: 'is-borderline', label: 'Mendekati batas' };
    if (item.evening.visible) {
      return { cls: 'is-ok', label: upcoming ? 'Memenuhi kriteria' : 'Terlihat' };
    }
    return { cls: 'is-bad', label: upcoming ? 'Tidak memenuhi kriteria' : 'Tidak terlihat' };
  }

  function fact(label: string, value: string, min = '', ok: boolean | null = null) {
    const chip = ok == null ? '' : `<span class="fact-chip ${ok ? 'is-ok' : 'is-bad'}">${ok ? 'Lolos' : 'Gagal'}</span>`;
    const minEl = min ? `<span class="fact-min">${min}</span>` : '';
    return `<div class="fact"><span class="fact-label">${label}</span><span class="fact-value">${value}${chip}</span>${minEl}</div>`;
  }

  function factsHTML(item: Item, upcoming = false) {
    const ev = item.evening;
    const vi = verdictInfo(item, upcoming);
    const cells = [
      fact('Tinggi bulan', fmtAlt(ev.moon_alt_deg), 'min. 3,0°', ev.alt_ok),
      fact('Elongasi', fmtElong(ev.elongation_deg), 'min. 6,4°', ev.elong_ok),
      fact('Iluminasi', fmtPct(ev.illumination_pct)),
      fact('Umur bulan', `${fmtNum(ev.age_hours)} jam`),
      fact('Matahari terbenam', ev.sunset),
      fact('Bulan terbenam', ev.moonset),
      fact('Titik pengamat', ev.deciding_site.name),
    ].join('');
    return (
      `<div class="hilal-facts-head"><span class="verdict-badge ${vi.cls}">${vi.label}</span>` +
      `<span class="facts-note">1 ${item.month.name} ${item.month.year} H · malam ${fmtDate(ev.gregorian_date)}</span></div>` +
      `<div class="facts-grid">${cells}</div>`
    );
  }

  function renderToday(today: any) {
    const o = today.output;
    const day = $('[data-today-day]');
    const month = $('[data-today-month]');
    const year = $('[data-today-year]');
    const greg = $('[data-today-greg]');
    if (day) day.textContent = String(o.day);
    if (month) month.textContent = o.month_name;
    if (year) year.textContent = String(o.year);
    if (greg) greg.textContent = `${fmtDate(today.input.date)} · ${today.input.tz}`;
  }

  const MOON_R = 40;

  // Correct moon phase: lit disc = half-circle outer arc + half-ellipse
  // terminator (semi-minor axis r*|cos(2π·phase)|). phase: 0=new, 0.5=full.
  function moonLitPath(phase: number) {
    if (phase < 0.001) return '';
    const r = MOON_R;
    if (phase > 0.999) {
      return `M 0 ${-r} A ${r} ${r} 0 1 1 0 ${r} A ${r} ${r} 0 1 1 0 ${-r} Z`;
    }
    const cosPhase = Math.cos(2 * Math.PI * phase);
    const minor = Math.abs(cosPhase) * r;
    const waxing = phase < 0.5;
    const outerSweep = waxing ? 1 : 0;
    // Crescent: terminator hugs the lit rim; gibbous: bulges into the dark
    // half. For waxing that needs sweep 1 when gibbous, for waning sweep 0.
    const innerSweep = (cosPhase < 0) === waxing ? 1 : 0;
    return (
      `M 0 ${-r}` +
      ` A ${r} ${r} 0 0 ${outerSweep} 0 ${r}` +
      ` A ${minor} ${r} 0 0 ${innerSweep} 0 ${-r}` +
      ' Z'
    );
  }

  function renderCountdown(today: any, item: Item) {
    const days = Math.round(
      (Date.parse(`${item.evening.gregorian_date}T00:00:00Z`) -
        Date.parse(`${today.input.date}T00:00:00Z`)) /
        86400000
    );
    const valueEl = $('[data-count-days]');
    const unitEl = $('[data-count-unit]');
    if (valueEl) valueEl.textContent = days <= 0 ? 'Malam ini' : String(days);
    if (unitEl) unitEl.textContent = days <= 0 ? '' : days === 1 ? 'besok' : 'hari lagi';
    const ev = item.evening;
    const sunset = ev.sunset.split(':').slice(0, 2).join(':');
    const eveLabel = ev.hijri_day === 29
      ? `Malam 29 ${item.previous_month.name} ${item.previous_month.year} H`
      : `Malam ${ev.hijri_day} ${item.previous_month.name} ${item.previous_month.year} H`;
    const target = $('[data-count-target]');
    if (target) {
      target.textContent = days <= 0
        ? `${eveLabel} · matahari terbenam ${sunset}`
        : `${eveLabel} · ${fmtDate(ev.gregorian_date)}`;
    }

    const pct = Math.min(100, Math.max(0, (today.output.day / 29) * 100));
    const arc = $('[data-moon-arc]') as SVGGeometryElement | null;
    if (arc) arc.style.strokeDashoffset = String(100 - pct);

    // Symodic phase centered mid-day: day 1 → thin waxing sliver, day ~15 →
    // full, day 29 → near-conjunction dark, day 30 → new moon.
    const phase = Math.min(0.999, Math.max(0.02, (today.output.day - 0.5) / 29.53));
    const lit = $('[data-moon-lit]');
    if (lit) lit.setAttribute('d', moonLitPath(phase));

    const setGauge = (
      valSel: string,
      chipSel: string,
      value: string,
      ok: boolean | null
    ) => {
      const valEl = $(valSel);
      if (valEl) valEl.textContent = value;
      const chip = $(chipSel);
      if (!chip) return;
      if (ok == null) {
        chip.hidden = true;
        return;
      }
      chip.hidden = false;
      chip.className = `fact-chip ${ok ? 'is-ok' : 'is-bad'}`;
      chip.textContent = ok ? 'Lolos' : 'Gagal';
    };
    setGauge('[data-gauge-alt]', '[data-gauge-alt-chip]', fmtAlt(ev.moon_alt_deg), ev.alt_ok);
    setGauge('[data-gauge-elong]', '[data-gauge-elong-chip]', fmtElong(ev.elongation_deg), ev.elong_ok);

    const siteEl = $('[data-count-site]');
    if (siteEl) siteEl.textContent = `Titik penentuan: ${ev.deciding_site.name}`;
  }

  function wireImage(
    zoom: HTMLElement,
    img: HTMLImageElement,
    etaEl: HTMLElement | null,
    label: string,
    etaStart: number
  ) {
    let timer: number | null = null;
    if (etaEl && etaStart > 0) {
      let remaining = etaStart;
      const tick = () => {
        etaEl.textContent =
          remaining > 0 ? `${label}… ~${remaining}s` : `Menyelesaikan ${label.toLowerCase()}…`;
      };
      tick();
      timer = window.setInterval(() => {
        remaining -= 1;
        tick();
        if (remaining <= -5 && timer !== null) window.clearInterval(timer);
      }, 1000);
    }
    img.addEventListener('load', () => {
      if (timer !== null) window.clearInterval(timer);
      zoom.classList.add('is-loaded');
    });
    img.addEventListener('error', () => {
      if (timer !== null) window.clearInterval(timer);
      if (etaEl) etaEl.textContent = 'Gagal memuat gambar — coba muat ulang.';
    });
  }

  function renderFeatured(item: Item) {
    upcoming = item;
    const q = `month=${item.month.number}&year=${item.month.year}`;
    const mapImg = $('[data-map-img]') as HTMLImageElement | null;
    const vizImg = $('[data-viz-img]') as HTMLImageElement | null;
    const mapZoom = $('[data-zoom="map"]');
    const vizZoom = $('[data-zoom="viz"]');
    if (mapImg && mapZoom) wireImage(mapZoom, mapImg, $('[data-map-eta]'), 'Merender peta', 35);
    if (vizImg && vizZoom) wireImage(vizZoom, vizImg, $('[data-viz-eta]'), 'Merender grafik', 0);
    if (mapImg) mapImg.src = `${API}/api/v1/hilal/map?${q}&bare=true`;
    if (vizImg) vizImg.src = `${API}/api/v1/hilal/viz?${q}&bare=true`;
    const dateEls = $$('[data-map-date],[data-viz-date]');
    for (const el of dateEls) el.textContent = fmtDateShort(item.evening.gregorian_date);
    const mapDl = $('[data-map-dl]') as HTMLAnchorElement | null;
    const vizDl = $('[data-viz-dl]') as HTMLAnchorElement | null;
    if (mapDl) mapDl.href = `${API}/api/v1/hilal/map?${q}&download=true`;
    if (vizDl) vizDl.href = `${API}/api/v1/hilal/viz?${q}&download=true`;
    const sub = $('[data-featured-sub]');
    if (sub) {
      sub.textContent = `Awal 1 ${item.month.name} ${item.month.year} H, ditentukan malam ${fmtDate(item.evening.gregorian_date)}.`;
    }
    const facts = $('[data-featured-facts]');
    if (facts) facts.innerHTML = factsHTML(item, true);
  }

  function rowHTML(item: Item) {
    const ev = item.evening;
    const vi = verdictInfo(item);
    const key = keyOf(item);
    const q = `month=${item.month.number}&year=${item.month.year}`;
    return (
      `<article class="history-item" data-key="${key}">` +
      '<div class="history-row">' +
      `<div class="history-id"><span class="history-name">${item.month.name}</span><span class="history-year">${item.month.year} H</span></div>` +
      `<div class="history-eve"><span class="history-evedate">${fmtDateShort(ev.gregorian_date)}</span><span class="history-eyecap">malam ${ev.hijri_date}</span></div>` +
      '<div class="history-mid">' +
      `<span class="verdict-badge ${vi.cls}">${vi.label}</span>` +
      `<span class="mini-chip ${ev.alt_ok ? 'is-ok' : 'is-bad'}">Alt ${fmtAlt(ev.moon_alt_deg)}</span>` +
      `<span class="mini-chip ${ev.elong_ok ? 'is-ok' : 'is-bad'}">Elong ${fmtElong(ev.elongation_deg)}</span>` +
      '</div>' +
      '<div class="history-actions">' +
      '<button type="button" data-info aria-expanded="false">Lihat detail</button>' +
      '</div></div>' +
      '<div class="history-panel" hidden>' +
      '<div class="history-media">' +
      `<figure><button type="button" class="history-zoom" data-zoom="map" aria-label="Perbesar peta ${item.month.name} ${item.month.year} H">` +
      `<img alt="Peta wilayah visibilitas hilal ${item.month.name} ${item.month.year} H" data-map data-src="${API}/api/v1/hilal/map?${q}&bare=true">` +
      `</button><figcaption><a class="hilal-download" href="${API}/api/v1/hilal/map?${q}&download=true" download="hilal-map-${key}.png">Unduh PNG</a></figcaption></figure>` +
      `<figure><button type="button" class="history-zoom" data-zoom="viz" aria-label="Perbesar grafik ${item.month.name} ${item.month.year} H">` +
      `<img alt="Grafik langit visibilitas hilal ${item.month.name} ${item.month.year} H" data-viz data-src="${API}/api/v1/hilal/viz?${q}&bare=true">` +
      `</button><figcaption><a class="hilal-download" href="${API}/api/v1/hilal/viz?${q}&download=true" download="hilal-viz-${key}.png">Unduh PNG</a></figcaption></figure>` +
      '</div>' +
      `<div class="hilal-facts">${factsHTML(item)}</div>` +
      '</div>' +
      '</article>'
    );
  }

  function renderHistory() {
    const list = $('[data-history]');
    if (!list) return;
    if (!state.history.length) {
      list.innerHTML = '<p class="hilal-loading">Riwayat tidak tersedia.</p>';
      return;
    }
    const rows = state.history.slice(0, state.shown);
    list.innerHTML = rows.map(rowHTML).join('');
    const more = $('[data-more]');
    if (more) more.hidden = state.shown >= state.history.length;
  }

  function openLightbox(src: string, caption: string) {
    const dlg = $('[data-lightbox]') as HTMLDialogElement | null;
    const img = $('[data-lightbox-img]') as HTMLImageElement | null;
    const cap = $('[data-lightbox-caption]');
    if (!dlg || !img) return;
    img.src = src;
    img.alt = caption;
    if (cap) cap.textContent = caption;
    if (typeof dlg.showModal === 'function') dlg.showModal();
    else dlg.setAttribute('open', '');
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const zoom = target.closest('[data-zoom]') as HTMLElement | null;
    if (zoom) {
      const isMap = zoom.dataset.zoom === 'map';
      const scope = zoom.closest('.history-panel');
      const img = (
        scope
          ? scope.querySelector<HTMLImageElement>(isMap ? '[data-map]' : '[data-viz]')
          : $(isMap ? '[data-map-img]' : '[data-viz-img]')
      ) as HTMLImageElement | null;
      if (img?.src) {
        openLightbox(img.src, img.alt);
      }
      return;
    }

    if (target.closest('[data-lightbox-close]')) {
      ($('[data-lightbox]') as HTMLDialogElement | null)?.close();
      return;
    }

    const info = target.closest('[data-info]') as HTMLButtonElement | null;
    if (info) {
      const panel = info.closest('.history-item')?.querySelector('.history-panel') as HTMLElement | null;
      if (!panel) return;
      const open = info.getAttribute('aria-expanded') === 'true';
      info.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
      if (!open) {
        for (const img of panel.querySelectorAll<HTMLImageElement>('img[data-src]')) {
          img.src = img.dataset.src!;
          img.removeAttribute('data-src');
        }
      }
      return;
    }

    if (target.closest('[data-more]')) {
      state.shown += PAGE;
      renderHistory();
    }
  });

  const lightbox = $('[data-lightbox]') as HTMLDialogElement | null;
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });

  async function setup() {
    try {
      const browserTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      let today: any;
      try {
        today = await api('/api/v1/today', browserTz ? { tz: browserTz } : undefined);
      } catch {
        today = await api('/api/v1/today');
      }
      const testDay = Number(new URLSearchParams(location.search).get('day'));
      if (testDay >= 1 && testDay <= 30) today.output.day = testDay;
      renderToday(today);

      const hist = await api('/api/v1/hilal/history');
      const byKey = new Map<string, Item>(hist.months.map((it: Item) => [keyOf(it), it]));

      const target = nextTarget(today.output);
      const targetKey = `${target.year}-${String(target.month).padStart(2, '0')}`;
      const item = byKey.get(targetKey) ?? (await api('/api/v1/hilal/info', { month: String(target.month), year: String(target.year) }));

      renderCountdown(today, item);
      renderFeatured(item);

      state.history = hist.months
        .filter((it: Item) => keyOf(it) < targetKey)
        .sort((a: Item, b: Item) => (keyOf(a) < keyOf(b) ? 1 : -1));
      renderHistory();
    } catch (error) {
      const list = $('[data-history]');
      if (list) {
        list.innerHTML = `<p class="hilal-note">Gagal memuat data hilal (${String(error)}). Coba muat ulang halaman.</p>`;
      }
    }
  }

  setup();
</script>
