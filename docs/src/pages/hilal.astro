---
import LandingLayout from '../components/LandingLayout.astro';
import HilalHero from '../components/hilal/HilalHero.astro';
import SightingFeatured from '../components/hilal/SightingFeatured.astro';
import SightingHistory from '../components/hilal/SightingHistory.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://api.mabims.dev';

const ahad = (s: string) => s.replace('Minggu', 'Ahad');

let fallback: { day: number; month_name: string; year: number; greg: string } | null = null;
try {
  const res = await fetch(`${apiBase}/api/v1/today`);
  if (res.ok) {
    const body = await res.json();
    const d = new Date(`${body.input.date}T00:00:00`);
    const greg = ahad(new Intl.DateTimeFormat('id-ID', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(d));
    fallback = {
      day: body.output.day,
      month_name: body.output.month_name,
      year: body.output.year,
      greg: `${greg} · ${body.input.tz}`,
    };
  }
} catch {}

const title = 'Hilal — Visibilitas & Riwayat Penentuan Awal Bulan Hijriah';
const description =
  'Tanggal Hijriah hari ini, hitung mundur malam penentuan hilal, peta wilayah visibilitas, grafik langit, dan riwayat penentuan hilal sejak 1444 H berdasarkan kriteria Neo MABIMS.';
---

<LandingLayout title={title} description={description} lang="id" canonical="https://mabims.dev/hilal/" altId="https://mabims.dev/hilal/" altEn="">
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Hilal — Visibilitas & Riwayat Penentuan Awal Bulan Hijriah",
        "url": "https://mabims.dev/hilal/",
        "inLanguage": "id",
        "isPartOf": { "@type": "WebSite", "name": "mabims.dev", "url": "https://mabims.dev" },
        "about": "Visibilitas hilal Neo MABIMS: ketinggian bulan dan elongasi saat matahari terbenam di titik pengamatan pesisir Indonesia."
      }
    </script>
  </Fragment>

  <HilalHero fallback={fallback} />
  <SightingFeatured />
  <SightingHistory />
</LandingLayout>

<style is:global>
  #sekarang,
  #berikutnya,
  #riwayat {
    scroll-margin-top: 5rem;
  }

  /* ── Hero ── */
  .hilal-hero {
    position: relative;
    padding: clamp(5rem, 22vw, 7rem) 0 clamp(5rem, 10vw, 7rem);
    overflow: visible;
    isolation: isolate;
  }

  @media (max-width: 53.99rem) {
    .hilal-hero {
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - 4rem);
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }
    .hilal-hero-grid {
      margin: auto 0;
    }
  }

  @media (min-width: 54rem) {
    .hilal-hero {
      padding-top: clamp(2rem, 4vw, 3rem);
    }
  }

  .hilal-atmos {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
  }

  .hilal-stars {
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    background-image:
      radial-gradient(1px at 2.9% 9.9%, rgba(255, 255, 255, 0.7) 99%, transparent),
      radial-gradient(1.5px at 13.8% 31.8%, rgba(255, 255, 255, 0.9) 99%, transparent),
      radial-gradient(1px at 24.6% 53.7%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1px at 35.4% 75.6%, rgba(255, 255, 255, 0.6) 99%, transparent),
      radial-gradient(1.2px at 46.2% 8.6%, rgba(255, 255, 255, 0.8) 99%, transparent),
      radial-gradient(1px at 57% 30.4%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1px at 67.8% 52.3%, rgba(255, 255, 255, 0.7) 99%, transparent),
      radial-gradient(1.5px at 78.6% 74.2%, rgba(255, 255, 255, 0.9) 99%, transparent),
      radial-gradient(1px at 89.4% 7.2%, rgba(255, 255, 255, 0.6) 99%, transparent),
      radial-gradient(1px at 0.3% 29.1%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1.4px at 11.1% 51%, rgba(255, 255, 255, 0.8) 99%, transparent),
      radial-gradient(1px at 21.9% 72.9%, rgba(255, 255, 255, 0.6) 99%, transparent),
      radial-gradient(1px at 32.7% 5.9%, rgba(255, 255, 255, 0.7) 99%, transparent),
      radial-gradient(1.2px at 43.5% 27.8%, rgba(255, 255, 255, 0.75) 99%, transparent),
      radial-gradient(1px at 54.3% 49.7%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1.1px at 65.1% 71.6%, rgba(255, 255, 255, 0.8) 99%, transparent),
      radial-gradient(1px at 75.9% 4.6%, rgba(255, 255, 255, 0.6) 99%, transparent),
      radial-gradient(1.3px at 86.8% 26.4%, rgba(255, 255, 255, 0.85) 99%, transparent),
      radial-gradient(1px at 97.6% 48.3%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1px at 8.4% 70.2%, rgba(255, 255, 255, 0.6) 99%, transparent),
      radial-gradient(1.2px at 19.2% 3.2%, rgba(255, 255, 255, 0.8) 99%, transparent),
      radial-gradient(1px at 30% 25.1%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1px at 40.8% 47%, rgba(255, 255, 255, 0.7) 99%, transparent),
      radial-gradient(1px at 51.6% 68.9%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1.4px at 62.4% 1.9%, rgba(255, 255, 255, 0.9) 99%, transparent),
      radial-gradient(1px at 73.3% 23.8%, rgba(255, 255, 255, 0.6) 99%, transparent),
      radial-gradient(1px at 84.1% 45.7%, rgba(255, 255, 255, 0.7) 99%, transparent),
      radial-gradient(1.5px at 94.9% 67.6%, rgba(255, 255, 255, 0.85) 99%, transparent),
      radial-gradient(1px at 5.7% 0.6%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1px at 16.5% 22.4%, rgba(255, 255, 255, 0.6) 99%, transparent),
      radial-gradient(1.2px at 27.3% 44.3%, rgba(255, 255, 255, 0.8) 99%, transparent),
      radial-gradient(1px at 38.1% 66.2%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1px at 48.9% 88.1%, rgba(255, 255, 255, 0.6) 99%, transparent),
      radial-gradient(1.3px at 59.8% 21.1%, rgba(255, 255, 255, 0.9) 99%, transparent),
      radial-gradient(1px at 70.6% 43%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1.1px at 81.4% 64.9%, rgba(255, 255, 255, 0.8) 99%, transparent),
      radial-gradient(1px at 92.2% 86.8%, rgba(255, 255, 255, 0.6) 99%, transparent),
      radial-gradient(1px at 3% 19.8%, rgba(255, 255, 255, 0.5) 99%, transparent),
      radial-gradient(1px at 13.8% 41.7%, rgba(255, 255, 255, 0.6) 99%, transparent);
    opacity: 0.85;
  }

  .hilal-stars::before,
  .hilal-stars::after {
    content: '';
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    animation: hilal-twinkle 4s ease-in-out infinite;
  }

  .hilal-stars::before {
    background-image:
      radial-gradient(2px at 13.8% 31.8%, #fff 99%, transparent),
      radial-gradient(1.8px at 67.8% 52.3%, #fff 99%, transparent),
      radial-gradient(1.5px at 35.4% 75.6%, #fff 99%, transparent);
    animation-delay: -1s;
    animation-duration: 3.5s;
  }

  .hilal-stars::after {
    background-image:
      radial-gradient(1.6px at 89.4% 7.2%, #fff 99%, transparent),
      radial-gradient(1.4px at 43.5% 27.8%, #fff 99%, transparent);
    animation-delay: -2.5s;
    animation-duration: 4.8s;
  }

  @keyframes hilal-twinkle {
    0%, 100% { opacity: 0.18; }
    50% { opacity: 1; }
  }

  .hilal-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: center;
  }

  @media (min-width: 54rem) {
    .hilal-hero-grid {
      grid-template-columns: 1fr 1fr;
      min-height: min(64svh, 540px);
      gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .hilal-hero-grid {
      min-height: min(72svh, 580px);
      gap: 2.5rem;
    }
  }

  .hilal-hero-text {
    max-width: 36rem;
    margin-inline: auto;
    text-align: left;
  }

  @media (min-width: 48rem) {
    .hilal-hero-text {
      padding-inline-start: clamp(1.25rem, 4vw, 3rem);
    }
  }

  @media (min-width: 54rem) {
    .hilal-hero-text {
      margin-inline: 0;
    }
  }

  .hilal-eyebrow {
    margin: 0 0 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }

  .hilal-date {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin: 0;
    font-weight: 800;
    line-height: 0.95;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.4);
  }

  .hilal-date-rest {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .hilal-date-num {
    font-size: clamp(5.5rem, 12vw, 7.5rem);
    line-height: 1;
    color: var(--sl-color-white);
    font-variant-numeric: tabular-nums;
  }

  .hilal-date-month {
    font-size: clamp(2.6rem, 5.5vw, 3.75rem);
    line-height: 1;
    color: var(--sl-color-accent);
    white-space: nowrap;
  }

  .hilal-date-year {
    font-size: clamp(1rem, 1.5vw, 1.4rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--sl-color-gray-2);
    margin-top: 0.8em;
  }

  .hilal-greg {
    margin: 1rem 0 0;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    color: var(--sl-color-gray-2);
    letter-spacing: 0.01em;
  }

  .hilal-date-year .hilal-count-name {
    color: var(--sl-color-white);
    font-weight: 700;
  }

  .hilal-countdown-card {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(250px, 96%, 430px);
    padding: clamp(1rem, 2vw, 1.4rem);
    text-align: center;
    background: rgba(18, 20, 28, 0.78);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    z-index: 5;
  }

  @media (min-width: 64rem) {
    .hilal-countdown-card {
      bottom: 12%;
      width: clamp(260px, 70%, 360px);
    }
  }

  .countdown-eyebrow {
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }

  .countdown-eyebrow .accent-month {
    color: var(--sl-color-accent);
    font-weight: 700;
  }

  .countdown-eyebrow .card-phase {
    color: var(--sl-color-white);
    font-weight: 700;
  }

  .countdown-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
  }

  .countdown-value {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 800;
    line-height: 1;
    color: var(--sl-color-accent);
    font-variant-numeric: tabular-nums;
  }

  .countdown-unit {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 800;
    line-height: 1;
    color: var(--sl-color-accent);
  }

  .countdown-target {
    margin: 0.35rem 0 0.85rem;
    font-size: 0.88rem;
    color: var(--sl-color-gray-2);
  }

  .lunation-track {
    position: relative;
    height: 3px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
    border-radius: 999px;
  }

  .lunation-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 0;
    background: linear-gradient(90deg, rgba(254, 207, 70, 0.25), var(--sl-color-accent) 60%, #fff3c4);
    border-radius: 999px;
    transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 0 14px rgba(254, 207, 70, 0.5);
  }

  .lunation-fill::after {
    content: '';
    position: absolute;
    right: -4px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff3c4;
    box-shadow: 0 0 10px rgba(254, 207, 70, 0.8);
    transform: translateY(-50%);
  }

  .hilal-cta-row {
    display: none;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
  }

  @media (min-width: 54rem) {
    .hilal-cta-row {
      display: flex;
    }
  }

  .hilal-hero-text .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: var(--sl-text-sm);
    text-decoration: none;
    cursor: pointer;
    transition: gap 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .hilal-hero-text .btn-ghost {
    color: var(--sl-color-gray-2);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .hilal-hero-text .btn-ghost:hover {
    color: var(--sl-color-white);
    border-color: rgba(254, 207, 70, 0.4);
  }

  .hilal-hero-text .btn-primary {
    font-weight: 700;
  }

  .hilal-hero-text .btn-primary:hover {
    gap: 0.8rem;
  }

  .hilal-moon-stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 0.25rem;
    min-height: clamp(340px, 62vw, 400px);
  }

  @media (min-width: 64rem) {
    .hilal-moon-stage {
      padding-top: 4%;
      min-height: clamp(440px, 52vw, 540px);
    }
  }

  @media (min-width: 54rem) {
    .hilal-moon-stage {
      padding-top: 2%;
      min-height: clamp(380px, 44vw, 480px);
    }
  }

  @media (min-width: 64rem) {
    .hilal-moon-stage {
      padding-top: 4%;
      min-height: clamp(440px, 52vw, 540px);
    }
  }

  .hilal-moon {
    width: clamp(280px, 62vw, 420px);
    height: auto;
    filter: drop-shadow(0 24px 60px rgba(254, 207, 70, 0.15));
    animation: hilal-moon-breathe 6s ease-in-out infinite;
  }

  @media (min-width: 54rem) {
    .hilal-moon {
      width: clamp(280px, 42vw, 420px);
    }
  }

  @keyframes hilal-moon-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.015); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hilal-moon,
    .hilal-stars::before,
    .hilal-stars::after,
    .lunation-fill {
      animation: none !important;
      transition: none !important;
    }
  }

  /* ── Section head ── */
  .hilal-section-head {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .hilal-section-head h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.6rem, 1rem + 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--sl-color-white);
  }

  .hilal-section-head .accent {
    color: var(--sl-color-accent);
  }

  .hilal-section-head p {
    max-width: 52rem;
    margin: 0;
    font-size: clamp(0.95rem, 0.5rem + 1vw, 1.05rem);
    line-height: 1.75;
    color: var(--sl-color-gray-2);
  }

  .hilal-section-head p + p {
    margin-top: 0.6rem;
  }

  .hilal-section-head p[data-featured-sub] {
    color: var(--sl-color-gray-3);
    font-size: clamp(0.88rem, 0.5rem + 0.8vw, 0.98rem);
  }

  .hilal-explain {
    max-width: 52rem;
    font-size: clamp(0.9rem, 0.5rem + 1vw, 1.02rem);
    line-height: 1.75;
  }

  .hilal-explain .exp-month {
    color: var(--sl-color-white);
    font-weight: 700;
  }

  .hilal-explain b {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .hilal-explain b.is-exp-ok {
    color: #7ed957;
  }

  .hilal-explain b.is-exp-bad {
    color: #ff6b6b;
  }

  .hilal-section-head p.hilal-disclaimer {
    max-width: 52rem;
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.42);
  }

  .hilal-section-head strong {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  /* ── Featured ── */
  .hilal-featured {
    padding: clamp(3rem, 6vw, 6rem) 0;
  }

  .hilal-featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 64rem) {
    .hilal-featured-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .hilal-graphic {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
  }

  .hilal-zoom {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    background: #1f1235;
    cursor: zoom-in;
    line-height: 0;
  }

  .hilal-zoom img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 1520;
    object-fit: cover;
    opacity: 0;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .hilal-zoom.is-loaded img {
    opacity: 1;
  }

  .hilal-zoom:hover img {
    transform: scale(1.02);
  }

  .hilal-skeleton {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    line-height: 1.4;
    background: linear-gradient(110deg, rgba(255, 255, 255, 0.04) 30%, rgba(255, 255, 255, 0.09) 45%, rgba(255, 255, 255, 0.04) 60%);
    background-size: 200% 100%;
    animation: hilal-shimmer 1.4s ease-in-out infinite;
  }

  .hilal-zoom.is-loaded .hilal-skeleton {
    display: none;
  }

  .hilal-spinner {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 4px solid rgba(255, 255, 255, 0.12);
    border-top-color: var(--sl-color-accent);
    animation: hilal-spin 0.9s linear infinite;
  }

  .hilal-eta {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  @keyframes hilal-shimmer {
    to {
      background-position: -200% 0;
    }
  }

  @keyframes hilal-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hilal-zoom-hint {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    backdrop-filter: blur(4px);
  }

  .hilal-graphic figcaption {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }

  .hilal-graphic-title {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .hilal-download {
    margin-left: auto;
    color: var(--sl-color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .hilal-download:hover {
    text-decoration: underline;
  }

  /* ── Facts ── */
  .hilal-facts {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .hilal-facts-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .facts-note {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
  }

  .fact-label {
    font-size: 0.7rem;
    text-transform: uppercase;
