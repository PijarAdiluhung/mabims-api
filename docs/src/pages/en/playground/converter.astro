---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'http://localhost:8000';
---

<StarlightPage
  frontmatter={{
    title: 'Playground',
    description: 'Convert real dates against the live MABIMS API.',
  }}
>
  <div class="pg-status" id="status" role="status">Checking API status…</div>

  <p>
    This page is a sample of two MABIMS API functionalities:
    displaying today's date and converting dates.
  </p>

  <form id="conv-form" class="pg-form">
    <label>
      Date
      <input type="text" id="date" readonly placeholder="YYYY-MM-DD" required />
    </label>
    <label>
      Calendar
      <select id="calendar">
        <option value="gregorian">Gregorian → Hijri</option>
        <option value="hijri">Hijri → Gregorian</option>
      </select>
    </label>
    <button type="submit" class="pg-btn">Convert</button>
  </form>

  <pre class="pg-result" id="result" hidden></pre>

  <script>
    import { Calendar } from 'vanilla-calendar-pro';
    import 'vanilla-calendar-pro/styles/index.css';

    let cleanup: (() => void) | null = null;

    function initPicker() {
      const el = document.querySelector<HTMLInputElement>('#date');
      if (!el) return;

      cleanup?.();
      cleanup = null;

      const now = new Date();
      const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
      el.value = today;

      const calendar = new Calendar(el, {
        inputMode: true,
        positionToInput: 'bottom',
        openOnFocus: true,
        selectionDatesMode: 'single',
        selectedTheme: 'dark',
        dateMin: '2024-01-01',
        dateMax: '2052-12-31',
        selectedDates: [today],
        onChangeToInput(self) {
          const [date] = self.context.selectedDates;
          if (date) {
            el.value = date;
            calendar.hide();
          }
        },
      });

      calendar.init();
      cleanup = () => calendar.destroy();
    }

    initPicker();
    document.addEventListener('astro:page-load', initPicker);
  </script>

  <script define:vars={{ apiBase }}>
    const statusEl = document.getElementById('status');
    const form = document.getElementById('conv-form');
    const dateEl = document.getElementById('date');
    const calEl = document.getElementById('calendar');
    const resultEl = document.getElementById('result');

    async function loadStatus() {
      try {
        const res = await fetch(`${apiBase}/api/v1/meta`);
        if (!res.ok) throw new Error(res.status);
        const meta = await res.json();
        statusEl.className = 'pg-status pg-ok';
        statusEl.textContent =
          `Authoritative MABIMS data from Kemenag · coverage ${meta.coverage.first} → ${meta.coverage.last}` +
          (meta.fallback_active
            ? ' · dates outside this range use Neo MABIMS computation'
            : '');
      } catch {
        statusEl.className = 'pg-status pg-warn';
        statusEl.textContent = 'API unreachable from here — it may not be deployed yet.';
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      resultEl.hidden = false;
      resultEl.textContent = 'Converting…';
      const params = new URLSearchParams({ date: dateEl.value, calendar: calEl.value });
      try {
        const res = await fetch(`${apiBase}/api/v1/convert?${params}`);
        const body = await res.json();
        if (!res.ok) {
          resultEl.textContent = `${res.status} ${body?.error?.code ?? ''}: ${body?.error?.message ?? res.statusText}`;
        } else {
          resultEl.textContent = JSON.stringify(body, null, 2);
          resultEl.classList.toggle('pg-fallback', body.source !== 'mabims');
        }
      } catch (error) {
        resultEl.textContent = String(error);
      }
    });

    loadStatus();
  </script>

  <style>
    .pg-status {
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      margin-bottom: 1.5rem;
      border: 1px solid var(--sl-color-gray-5);
    }
    .pg-ok {
      background: color-mix(in srgb, var(--sl-color-green-high) 15%, transparent);
    }
    .pg-warn {
      background: color-mix(in srgb, var(--sl-color-orange-high) 18%, transparent);
    }
    .pg-form {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: end;
      margin-bottom: 1.5rem;
    }
    .pg-form label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      font-size: 0.875rem;
      font-weight: 600;
    }
    .pg-form input,
    .pg-form select {
      padding: 0.45rem 0.6rem;
      border-radius: 0.375rem;
      border: 1px solid var(--sl-color-gray-4);
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
    }
    .pg-form input#date {
      cursor: pointer;
      min-width: 9.5rem;
    }
    .pg-form input#date:focus {
      outline: none;
      border-color: var(--sl-color-accent);
    }
    .pg-btn {
      padding: 0.5rem 1.25rem;
      border-radius: 0.375rem;
      border: none;
      background: var(--sl-color-accent);
      color: var(--sl-color-black);
      font-weight: 700;
      cursor: pointer;
    }
    .pg-result {
      padding: 1rem;
      border-radius: 0.5rem;
      background: var(--sl-color-bg-code);
      overflow-x: auto;
    }
    .pg-result.pg-fallback {
      outline: 2px solid var(--sl-color-orange-high);
    }
  </style>

  <style is:global>
    /* Calendar is appended to document.body in input mode */
    [data-vc='calendar'][data-vc-input] {
      --vc-bg: #1a1c24;
      --vc-color: #c4c4c4;
      --vc-focus-outline-color: #fecf46;
      --vc-header-color: #ffffff;
      --vc-title-color: #ffffff;
      --vc-title-color-hover: #fecf46;
      --vc-months-years-bg: transparent;
      --vc-months-years-color: #c4c4c4;
      --vc-months-years-bg-hover: #262933;
      --vc-months-years-bg-selected: #fecf46;
      --vc-months-years-color-selected: #17181c;
      --vc-week-day-color: #888888;
      --vc-week-day-off-color: #c98080;
      --vc-date-bg: transparent;
      --vc-date-color: #b8bcc8;
      --vc-date-color-hover: #ffffff;
      --vc-date-bg-hover: #262933;
      --vc-date-hover-bg: #262933;
      --vc-date-outside-color: #55575f;
      --vc-date-disabled-color: #4a4d57;
      --vc-date-today-bg: #262933;
      --vc-date-today-color: #fecf46;
      --vc-date-selected-bg: #fecf46;
      --vc-date-selected-color: #17181c;
      --vc-date-selected-outside-bg: #262933;
      --vc-date-selected-outside-color: #fecf46;
      --vc-date-weekend-color: #c98080;
      --vc-date-weekend-bg-hover: #262933;
      --vc-date-weekend-hover-bg: #262933;
      --vc-date-weekend-outside-bg: transparent;
      --vc-date-weekend-outside-color: #8a6f6f;
      z-index: 50;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.55);
    }
  </style>
</StarlightPage>
