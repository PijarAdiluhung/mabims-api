---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'http://localhost:8000';
const hijriMonths = [
  'Muharram', 'Safar', 'Rabi al-Awwal', 'Rabi al-Thani',
  'Jumada al-Ula', 'Jumada al-Akhirah', 'Rajab', "Sha'ban",
  'Ramadhan', 'Shawwal', "Dhu al-Qi'dah", 'Dhu al-Hijjah',
];
const weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const gregMonths = [
  'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
];
const eventShortNames = {
  '1_muharram': '1 Muharram',
  maulid_nabi: 'Maulid',
  awal_ramadan: '1 Ramadhan',
  idul_fitri: '1 Shawwal',
  idul_adha: '10 Dhu al-Hijjah',
};
---

<StarlightPage
  frontmatter={{
    title: 'Calendar Playground',
    description:
      'A full Hijri year calendar, rendered live from official Kemenag data.',
  }}
>
  <p>
    A <strong>Hijri</strong> calendar for the current year, rendered straight
    from the <code>/month</code> and <code>/events</code> endpoints. Large number = Hijri date, small
    number = Gregorian date. <strong>Friday</strong> is marked yellow.
  </p>

  <div class="pg-status" id="status" role="status">Checking API status…</div>

  <div class="kal-head">
    <h2 class="kal-title">Hijri Calendar <span id="kal-year">…</span></h2>
    <span class="kal-source" id="kal-source"></span>
  </div>

  <div class="kal-legend">
    <span class="legend-item"><span class="legend-chip legend-fri"></span> Friday</span>
    <span class="legend-item"><span class="legend-ring"></span> Today</span>
  </div>

  <div class="kal-wall" id="wall">
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
    <div class="kal-skel"><div class="skel-head"></div><div class="skel-week"></div><div class="skel-grid"></div></div>
  </div>

  <details>
    <summary>Full JSON response (/month + /events)</summary>
    <pre class="pg-result" id="raw"></pre>
  </details>

  <script>
    import {
      WEEKDAYS, GREG_MONTHS, MONTH_NAMES, EVENT_SHORT,
      fetchStatus, fetchToday, fetchMonth, fetchHijriEvents, buildWall,
    } from "../../../lib/kalender.core.js";

    const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:8000";

    const statusEl = document.getElementById("status");
    const yearEl = document.getElementById("kal-year");
    const sourceEl = document.getElementById("kal-source");
    const wallEl = document.getElementById("wall");
    const rawEl = document.getElementById("raw");

    let todayHijri = null;
    let currentYear = null;

    async function load() {
      try {
        const today = await fetchToday(apiBase);
        const year = today.output.year;
        todayHijri = today.output.date;
        if (currentYear !== year) {
          currentYear = year;
          yearEl.textContent = year;
          sourceEl.textContent = today.source === "mabims" ? "Official Kemenag data" : "Neo MABIMS";
          const months = await Promise.all(
            Array.from({ length: 12 }, (_, i) => fetchMonth(apiBase, year, i + 1))
          );
          const events = await fetchHijriEvents(apiBase, year);
          const monthsByKey = new Map();
          for (let m = 0; m < 12; m++) {
            const body = months[m];
            if (body) monthsByKey.set(m + 1, body.items ?? []);
          }
          buildWall(wallEl, year, monthsByKey, events, todayHijri, {
            weekdays: WEEKDAYS, gregMonths: GREG_MONTHS, hijriMonths: MONTH_NAMES, eventShortNames: EVENT_SHORT,
          });
          rawEl.textContent = JSON.stringify(
            { months: months.filter(Boolean), events },
            null,
            2
          );
        }
      } catch {
        statusEl.className = "pg-status pg-warn";
        statusEl.textContent =
          "API unreachable from here — it may not be deployed yet.";
      }
    }

    loadStatus();
    load();

    async function loadStatus() {
      fetchStatus(apiBase, statusEl, "en");
    }

    // auto-switch year: re-check after midnight and on focus
    async function checkYear() {
      try {
        const today = await fetchToday(apiBase);
        if (today.output.year !== currentYear) await load();
      } catch {
        /* keep current view */
      }
    }
    const now = new Date();
    const untilMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 1, 0).getTime() - now.getTime();
    setTimeout(checkYear, Math.min(untilMidnight, 0x7fffffff));
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) checkYear();
    });
  </script>

  <style is:global>
    .pg-status {
      margin-bottom: 1.5rem;
    }
    .kal-head {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }
    .kal-title {
      margin: 0;
      font-size: 1.35rem;
      font-weight: 700;
    }
    .kal-title #kal-year {
      color: var(--sl-color-accent);
    }
    .kal-source {
      font-size: 0.8rem;
      color: var(--sl-color-gray-3);
    }
    .kal-legend {
      display: flex;
      gap: 1.25rem;
      margin-bottom: 1.25rem;
      font-size: 0.8rem;
      color: var(--sl-color-gray-3);
    }
    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .legend-chip {
      width: 0.8rem;
      height: 0.8rem;
      border-radius: 0.25rem;
    }
    .legend-chip.legend-fri {
      background: color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
      border: 1px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    }
    .legend-ring {
      width: 0.8rem;
      height: 0.8rem;
      border-radius: 0.25rem;
      border: 2px dashed var(--sl-color-accent);
    }
    .kal-wall {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
    @media (max-width: 47.9rem) {
      .kal-wall {
        grid-template-columns: 1fr;
      }
    }
    .kal-card {
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.75rem;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.015);
    }
    .kal-card-head {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      padding: 0.6rem 0.85rem;
      border-bottom: 1px solid var(--sl-color-gray-5);
    }
    .kal-mnum {
      font-size: 0.85rem;
      font-weight: 800;
      color: var(--sl-color-accent);
    }
    .kal-mname {
      margin: 0;
      font-size: 0.95rem;
      font-weight: 700;
    }
    .kal-myear {
      font-weight: 400;
      color: var(--sl-color-gray-3);
      font-size: 0.8rem;
    }
    .kal-week {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      padding: 0.35rem 0.45rem;
      border-bottom: 1px solid var(--sl-color-gray-6);
    }
    .kal-week > * {
      margin: 0;
    }
    .kal-dow {
      text-align: center;
      font-size: 0.65rem;
      font-weight: 600;
      color: var(--sl-color-gray-4);
    }
    .kal-dow.is-fri {
      color: var(--sl-color-accent);
    }
    .kal-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      padding: 0 0.45rem;
    }
    .kal-grid > * {
      margin: 0;
    }
    .kal-cell {
      position: relative;
      min-height: 2.4rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.1rem;
      border-bottom: 1px solid var(--sl-color-gray-6);
      border-right: 1px solid var(--sl-color-gray-6);
      padding: 0.15rem 0.1rem;
    }
    .kal-cell:nth-child(7n) {
      border-right: none;
    }
    .kal-cell.is-empty {
      border-color: transparent;
      background: transparent;
    }
    .kal-day {
      font-size: 0.85rem;
      font-weight: 700;
      line-height: 1;
      color: var(--sl-color-text);
    }
    .kal-cell.is-fri .kal-day {
      color: var(--sl-color-accent);
    }
    .kal-cell.is-today .kal-day {
      color: var(--sl-color-accent);
    }
    .kal-greg {
      font-size: 0.55rem;
      color: var(--sl-color-gray-3);
      line-height: 1;
    }
    .kal-cell.has-event::after {
      content: "";
      position: absolute;
      top: 0.2rem;
      right: 0.2rem;
      width: 0.3rem;
      height: 0.3rem;
      border-radius: 50%;
      background: var(--sl-color-accent);
    }
    .kal-cell.is-today {
      outline: 2px dashed var(--sl-color-accent);
      outline-offset: -2px;
    }
    .kal-events {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      padding: 0.4rem 0.55rem;
      border-top: 1px solid var(--sl-color-gray-6);
      font-size: 0.55rem;
      color: var(--sl-color-gray-3);
    }
    .kal-ev-badge {
      padding: 0.1rem 0.35rem;
      border-radius: 0.25rem;
      background: color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
      color: var(--sl-color-accent);
      font-weight: 600;
      white-space: nowrap;
    }
    .pg-result {
      padding: 1rem;
      border-radius: 0.5rem;
      background: var(--sl-color-bg-code);
      overflow-x: auto;
    }
    details summary {
      cursor: pointer;
    }
    .kal-skel {
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.75rem;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.015);
    }
    .skel-head, .skel-week, .skel-grid {
      background: linear-gradient(90deg, var(--sl-color-gray-6) 25%, var(--sl-color-gray-5) 50%, var(--sl-color-gray-6) 75%);
      background-size: 200% 100%;
      animation: skel-shimmer 1.5s ease-in-out infinite;
      border-radius: 0.3rem;
    }
    .skel-head {
      height: 2rem;
      margin: 0.6rem 0.85rem;
    }
    .skel-week {
      height: 1.2rem;
      margin: 0.35rem 0.45rem;
    }
    .skel-grid {
      height: 8rem;
      margin: 0.4rem 0.45rem 0.6rem;
    }
    @keyframes skel-shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
  </style>
</StarlightPage>