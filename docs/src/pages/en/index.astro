---
import LandingLayout from '../../components/LandingLayout.astro';
import Hero from '../../components/landing-en/Hero.astro';
import Problem from '../../components/landing-en/Problem.astro';
import Marquee from '../../components/landing-en/Marquee.astro';
import Features from '../../components/landing-en/Features.astro';
import VisualisasiHilal from '../../components/landing-en/VisualisasiHilal.astro';
import CompareTable from '../../components/landing-en/CompareTable.astro';
import Endpoints from '../../components/landing-en/Endpoints.astro';
import Cta from '../../components/landing-en/Cta.astro';

const title = 'MABIMS.dev • Open-Source Hijri Calendar API for Indonesia';
const description = 'Free open-source API for Hijri dates based on official MABIMS criteria from Indonesia\'s Ministry of Religious Affairs (Kemenag RI). No API key, ready for web and mobile apps.';
---

<LandingLayout
  title={title}
  description={description}
  lang="en"
  canonical="https://mabims.dev/en/"
  altId="https://mabims.dev/"
  altEn="https://mabims.dev/en/"
>
  <Fragment slot="head">
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "mabims.dev",
        "url": "https://mabims.dev",
        "description": "Integrate the MABIMS Hijri calendar into your website or app. Single endpoint, no authentication, data from publicly available Kemenag tables.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://mabims.dev/en/faq/?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "MABIMS API",
        "url": "https://mabims.dev",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Cross-platform",
        "description": "Integrate the MABIMS Hijri calendar into your website or app. Single endpoint, no authentication, data from publicly available Kemenag tables.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "author": {
          "@type": "Person",
          "name": "Pijar Adiluhung"
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareSourceCode",
        "name": "MABIMS API",
        "codeRepository": "https://github.com/PijarAdiluhung/mabims-api",
        "programmingLanguage": "Python",
        "license": "https://opensource.org/licenses/MIT",
        "runtimePlatform": "FastAPI",
        "description": "Open-source Hijri-Gregorian date conversion API using Indonesia's official MABIMS criteria"
      }
    </script>
  </Fragment>

  <Hero />
  <Problem />
  <Marquee />
  <CompareTable />
  <Features />
  <VisualisasiHilal />
  <Endpoints />
  <Cta />
</LandingLayout>
