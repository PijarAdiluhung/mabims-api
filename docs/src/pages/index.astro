---
import LandingLayout from '../components/LandingLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Problem from '../components/landing/Problem.astro';
import Marquee from '../components/landing/Marquee.astro';
import Features from '../components/landing/Features.astro';
import VisualisasiHilal from '../components/landing/VisualisasiHilal.astro';
import CompareTable from '../components/landing/CompareTable.astro';
import Endpoints from '../components/landing/Endpoints.astro';
import Cta from '../components/landing/Cta.astro';

const title = 'MABIMS.dev — API Kalender Hijriah Open-Source untuk Indonesia';
const description = 'API open-source gratis menampilkan tanggal Hijriah berdasarkan kriteria MABIMS Kementerian Agama RI. Tanpa API key, cocok untuk web dan aplikasi Indonesia.';
---

<LandingLayout
  title={title}
  description={description}
  lang="id"
  canonical="https://mabims.dev/"
  altId="https://mabims.dev/"
  altEn="https://mabims.dev/en/"
>
  <Fragment slot="head">
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "mabims.dev",
        "url": "https://mabims.dev",
        "description": "Integrasikan kalender Hijriah MABIMS ke web / aplikasi Anda. Satu endpoint, tanpa autentikasi, data publik dari Kemenag.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://mabims.dev/faq/?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "MABIMS API",
        "url": "https://mabims.dev",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Cross-platform",
        "description": "Integrasikan kalender Hijriah MABIMS ke web / aplikasi Anda. Satu endpoint, tanpa autentikasi, data publik dari Kemenag.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "author": {
          "@type": "Person",
          "name": "Pijar Adiluhung"
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareSourceCode",
        "name": "MABIMS API",
        "codeRepository": "https://github.com/PijarAdiluhung/mabims-api",
        "programmingLanguage": "Python",
        "license": "https://opensource.org/licenses/MIT",
        "runtimePlatform": "FastAPI",
        "description": "Open-source Hijri-Gregorian date conversion API using Indonesia's official MABIMS criteria"
      }
    </script>
  </Fragment>

  <Hero />
  <Problem />
  <Marquee />
  <CompareTable />
  <Features />
  <VisualisasiHilal />
  <Endpoints />
  <Cta />
</LandingLayout>
