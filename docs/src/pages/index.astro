---
import Hero from '../components/landing/Hero.astro';
import Problem from '../components/landing/Problem.astro';
import Marquee from '../components/landing/Marquee.astro';
import Features from '../components/landing/Features.astro';
import VisualisasiHilal from '../components/landing/VisualisasiHilal.astro';
import CompareTable from '../components/landing/CompareTable.astro';
import Endpoints from '../components/landing/Endpoints.astro';
import Cta from '../components/landing/Cta.astro';
import Footer from '../components/landing/Footer.astro';

const title = 'API Kalender MABIMS';
const description = 'Integrasikan kalender Hijriah MABIMS ke web / aplikasi Anda. Satu endpoint, tanpa autentikasi, data publik dari Kemenag.';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" />
    <meta name="theme-color" content="#23262f" />

    <!-- Canonical -->
    <link rel="canonical" href="https://mabims.dev/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mabims.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://mabims.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="mabims.dev" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://mabims.dev/og-image.png" />

    <!-- hreflang -->
    <link rel="alternate" hreflang="id" href="https://mabims.dev/" />
    <link rel="alternate" hreflang="en" href="https://mabims.dev/en/" />
    <link rel="alternate" hreflang="x-default" href="https://mabims.dev/" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "mabims.dev",
        "url": "https://mabims.dev",
        "description": "Integrasikan kalender Hijriah MABIMS ke web / aplikasi Anda. Satu endpoint, tanpa autentikasi, data publik dari Kemenag.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://mabims.dev/faq/?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "MABIMS API",
        "url": "https://mabims.dev",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Cross-platform",
        "description": "Integrasikan kalender Hijriah MABIMS ke web / aplikasi Anda. Satu endpoint, tanpa autentikasi, data publik dari Kemenag.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "author": {
          "@type": "Person",
          "name": "Pijar Adiluhung"
        }
      }
    </script>
  </head>
  <body>
    <nav class="landing-nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          <img src="/mabims-long.png" alt="MABIMS" class="nav-logo-img" />
        </a>
        <div class="nav-links">
          <a href="/quickstart/">Quickstart</a>
          <a href="/playground/converter/">Coba</a>
          <a href="/blog/">Blog</a>
          <a href="/faq/">FAQ</a>
          <a href="https://github.com/PijarAdiluhung/mabims-api" target="_blank" rel="noopener" class="nav-github">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
        <button class="nav-toggle" aria-label="Toggle menu" id="nav-toggle">
          <svg class="icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <a href="/quickstart/">Quickstart</a>
      <a href="/playground/converter/">Coba</a>
      <a href="/blog/">Blog</a>
      <a href="/faq/">FAQ</a>
      <a href="https://github.com/PijarAdiluhung/mabims-api" target="_blank" rel="noopener">GitHub</a>
    </div>

    <main class="landing-main">
      <div class="landing-container">
        <Hero />
        <Problem />
        <Marquee />
        <CompareTable />
        <Features />
        <VisualisasiHilal />
        <Endpoints />
        <Cta />
      </div>
      <Footer />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --sl-color-accent: #fecf46;
    --sl-color-accent-high: #e6b830;
    --sl-color-accent-low: #fef0c8;
    --sl-color-white: #ffffff;
    --sl-color-gray-2: #c4c4c4;
    --sl-color-gray-3: #888888;
    --sl-text-xs: 0.75rem;
    --sl-text-sm: 0.875rem;
    --sl-text-body: 1rem;
    --sl-text-h4: 1.125rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: 'Poppins', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    background: #17181c;
    color: #e8e8ee;
    min-height: 100vh;
  }

  /* Gradient fade dividers instead of hard borders */
  section {
    border-top: none !important;
    position: relative;
  }

  .landing-container > section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
    pointer-events: none;
  }

  /* Force yellow CTA buttons */
  a[class*="btn-primary"],
  a[class*="btn-primary"]:visited {
    background: #fecf46 !important;
    color: #1a1a2e !important;
    border: none !important;
  }

  a[class*="btn-primary"]:hover {
    background: #e6b830 !important;
    color: #1a1a2e !important;
  }

  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(35, 38, 47, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
  }

  .nav-logo-img {
    height: 28px;
    width: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-links a {
    color: #999;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: #fff;
  }

  .nav-github {
    display: flex;
    align-items: center;
  }

  .landing-main {
    width: 100%;
  }

  .landing-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    padding: 0.25rem;
  }

  .nav-toggle:hover {
    color: #fff;
  }

  .nav-toggle .icon-close {
    display: none;
  }

  .nav-toggle.active .icon-open {
    display: none;
  }

  .nav-toggle.active .icon-close {
    display: block;
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    background: rgba(35, 38, 47, 0.98);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 1rem 1.5rem;
    z-index: 99;
    flex-direction: column;
    gap: 0;
  }

  .mobile-menu.active {
    display: flex;
  }

  .mobile-menu a {
    color: #999;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: color 0.2s;
  }

  .mobile-menu a:last-child {
    border-bottom: none;
  }

  .mobile-menu a:hover {
    color: #fff;
  }

  @media (max-width: 640px) {
    .landing-container {
      padding: 0 1rem;
    }

    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    toggle.classList.toggle('active');
    menu.classList.toggle('active');
  });
</script>
