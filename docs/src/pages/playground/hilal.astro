---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:8000";
const months = [
  [1, "Muharram"],
  [2, "Safar"],
  [3, "Rabiul Awal"],
  [4, "Rabiul Akhir"],
  [5, "Jumadil Awal"],
  [6, "Jumadil Akhir"],
  [7, "Rajab"],
  [8, "Sya'ban"],
  [9, "Ramadhan"],
  [10, "Syawal"],
  [11, "Dzulqa'dah"],
  [12, "Dzulhijjah"],
];
---

<StarlightPage
  frontmatter={{
    title: "Playground Hilal",
    description:
      "Generate grafik visibilitas hilal untuk malam penentuan awal bulan Hijriah.",
  }}
>
  <p>
    Halaman ini adalah sampel dari fungsionalitas API MABIMS untuk menampilkan
    visibilitas hilal. Coba sekarang dan dapatkan gambar visibilitas hilal di
    Sabang, titik paling barat di Indonesia yang sering menjadi penentu awal
    bulan.
  </p>

  <div class="pg-status" id="status" role="status">Memeriksa status API…</div>

  <form id="hilal-form" class="pg-form">
    <label>
      Bulan Hijriah
      <select id="bulan">
        {months.map(([value, name]) => <option value={value}>{name}</option>)}
      </select>
    </label>
    <label>
      Tahun Hijriah
      <select id="tahun">
        {Array.from({ length: 41 }, (_, i) => 1446 + i).map((y) => (
          <option value={y} selected={y === 1447}>{y}</option>
        ))}
      </select>
    </label>
    <button type="submit" class="pg-btn">Render Grafik</button>
  </form>

  <div class="hilal-grid">
    <figure class="hilal-figure" id="figure" hidden>
      <div class="hilal-skeleton" id="skeleton">
        <div class="hilal-spinner" role="status" aria-label="Memuat"></div>
      </div>
      <img
        id="chart"
        alt="Grafik visibilitas hilal"
        width="360"
        height="640"
        hidden
      />
      <figcaption id="figcap"></figcaption>
    </figure>
    <div class="hilal-data" id="data" hidden>
      <div class="hilal-verdict" id="verdict"></div>
      <details>
        <summary>Respons JSON lengkap</summary>
        <pre class="pg-result" id="raw"></pre>
      </details>
    </div>
  </div>

  <p class="hilal-note" id="error" hidden></p>

  <script define:vars={{ apiBase }}>
    const statusEl = document.getElementById("status");
    const form = document.getElementById("hilal-form");
    const bulanEl = document.getElementById("bulan");
    const tahunEl = document.getElementById("tahun");
    const figureEl = document.getElementById("figure");
    const chartEl = document.getElementById("chart");
    const skeletonEl = document.getElementById("skeleton");
    const figcapEl = document.getElementById("figcap");
    const dataEl = document.getElementById("data");
    const verdictEl = document.getElementById("verdict");
    const rawEl = document.getElementById("raw");
    const errorEl = document.getElementById("error");

    async function loadStatus() {
      try {
        const res = await fetch(`${apiBase}/api/v1/meta`);
        if (!res.ok) throw new Error(res.status);
        const meta = await res.json();

        const [firstRes, lastRes] = await Promise.all([
          fetch(`${apiBase}/api/v1/convert?date=${meta.coverage.first}`),
          fetch(`${apiBase}/api/v1/convert?date=${meta.coverage.last}`),
        ]);
        const firstBody = await firstRes.json();
        const lastBody = await lastRes.json();
        const firstHijri = `${firstBody.output.day} ${firstBody.output.month_name} ${firstBody.output.year}`;
        const lastHijri = `${lastBody.output.day} ${lastBody.output.month_name} ${lastBody.output.year}`;

        statusEl.className = "pg-status pg-ok";
        statusEl.textContent =
          `Data kalender MABIMS resmi dari Kemenag saat ini mencakup: ${firstHijri} → ${lastHijri}` +
          (meta.fallback_active
            ? " Di luar cakupan ini, menggunakan perhitungan Neo MABIMS."
            : "");
      } catch {
        statusEl.className = "pg-status pg-warn";
        statusEl.textContent =
          "API tidak dapat diakses dari sini — mungkin belum di-deploy.";
      }
    }

    async function loadDefaults() {
      try {
        const res = await fetch(`${apiBase}/api/v1/today`);
        if (!res.ok) return;
        const body = await res.json();
        let month = body.output.month + 1;
        let year = body.output.year;
        if (month > 12) {
          month = 1;
          year += 1;
        }
        bulanEl.value = String(month);
        tahunEl.value = String(year);
      } catch {
        /* biarkan nilai default statis */
      }
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorEl.hidden = true;
      dataEl.hidden = true;
      figureEl.hidden = false;
      skeletonEl.hidden = false;
      chartEl.hidden = true;
      figcapEl.textContent = "Merender grafik…";

      const params = new URLSearchParams({
        month: bulanEl.value,
        year: tahunEl.value,
      });
      const vizUrl = `${apiBase}/api/v1/hilal/viz?${params}`;

      try {
        const res = await fetch(`${apiBase}/api/v1/hilal/info?${params}`);
        const body = await res.json();
        if (!res.ok) {
          figureEl.hidden = true;
          errorEl.hidden = false;
          errorEl.textContent = `${res.status} ${body?.error?.code ?? ""}: ${body?.error?.message ?? res.statusText}`;
          return;
        }
        const ev = body.evening;
        chartEl.onload = () => {
          skeletonEl.hidden = true;
          chartEl.hidden = false;
          figcapEl.textContent = `${ev.hijri_date} · ${ev.gregorian_date}`;
        };
        chartEl.onerror = () => {
          skeletonEl.hidden = true;
          figcapEl.textContent = "Gagal memuat gambar.";
        };
        chartEl.src = vizUrl;

        const visible = ev.visible;
        verdictEl.textContent = visible
          ? `🌙 TERLIHAT — malam 1 ${body.month.name} ${body.month.year} H`
          : `⛔ TIDAK TERLIHAT — 1 ${body.month.name} ${body.month.year} H kemungkinan mundur`;
        verdictEl.className = `hilal-verdict ${visible ? "is-ok" : "is-bad"}`;

        rawEl.textContent = JSON.stringify(body, null, 2);
        dataEl.hidden = false;
      } catch (error) {
        figureEl.hidden = true;
        errorEl.hidden = false;
        errorEl.textContent = String(error);
      }
    });

    loadStatus();
    loadDefaults();
  </script>

  <style>
    .pg-status {
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      margin-bottom: 1.5rem;
      border: 1px solid var(--sl-color-gray-5);
    }
    .pg-ok {
      background: color-mix(
        in srgb,
        var(--sl-color-green-high) 15%,
        transparent
      );
    }
    .pg-warn {
      background: color-mix(
        in srgb,
        var(--sl-color-orange-high) 18%,
        transparent
      );
    }
    .pg-form {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: end;
      margin-bottom: 1.5rem;
    }
    .pg-form label {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      font-size: 0.875rem;
      font-weight: 600;
    }
    @media (max-width: 42rem) {
      .pg-form {
        gap: 0;
      }
      .pg-form label {
        width: 100%;
      }
    }
    .pg-form input,
    .pg-form select {
      height: 2.25rem;
      padding: 0 0.6rem;
      border-radius: 0.375rem;
      border: 1px solid var(--sl-color-gray-4);
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
    }
    .pg-btn {
      height: 2.25rem;
      padding: 0 1.25rem;
      border-radius: 0.375rem;
      border: none;
      background: var(--sl-color-accent);
      color: var(--sl-color-black);
      font-weight: 700;
      cursor: pointer;
    }
    .hilal-grid {
      display: grid;
      grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
      gap: 1.5rem;
      align-items: start;
    }
    @media (max-width: 42rem) {
      .hilal-grid {
        grid-template-columns: 1fr;
      }
    }
    .hilal-figure {
      margin: 0;
    }
    .hilal-skeleton {
      aspect-ratio: 9 / 16;
      display: grid;
      place-items: center;
      border-radius: 0.75rem;
      border: 1px solid var(--sl-color-gray-5);
      background: linear-gradient(
        110deg,
        var(--sl-color-gray-6) 30%,
        var(--sl-color-gray-5) 45%,
        var(--sl-color-gray-6) 60%
      );
      background-size: 200% 100%;
      animation: hilal-shimmer 1.4s ease-in-out infinite;
    }
    .hilal-spinner {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 4px solid var(--sl-color-gray-5);
      border-top-color: var(--sl-color-accent);
      animation: hilal-spin 0.9s linear infinite;
    }
    @keyframes hilal-shimmer {
      to {
        background-position: -200% 0;
      }
    }
    @keyframes hilal-spin {
      to {
        transform: rotate(360deg);
      }
    }
    .hilal-skeleton[hidden],
    .hilal-figure img[hidden] {
      display: none;
    }
    .hilal-figure img {
      width: 100%;
      height: auto;
      border-radius: 0.75rem;
      border: 1px solid var(--sl-color-gray-5);
      background: #1f1235;
    }
    .hilal-figure figcaption {
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--sl-color-gray-3);
    }
    .hilal-verdict {
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .hilal-verdict.is-ok {
      background: color-mix(
        in srgb,
        var(--sl-color-green-high) 18%,
        transparent
      );
    }
    .hilal-verdict.is-bad {
      background: color-mix(in srgb, var(--sl-color-red-high) 16%, transparent);
    }
    .hilal-note {
      color: var(--sl-color-red-high);
      font-weight: 600;
    }
    .pg-result {
      padding: 1rem;
      border-radius: 0.5rem;
      background: var(--sl-color-bg-code);
      overflow-x: auto;
    }
    details summary {
      cursor: pointer;
    }
  </style>
</StarlightPage>
