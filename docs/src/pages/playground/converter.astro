---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:8000";
---

<StarlightPage
  frontmatter={{
    title: "Playground",
    description:
      "Konversi tanggal langsung terhadap API MABIMS secara real time.",
  }}
>
  <p id="status">Memeriksa status API…</p>

  <section class="conv-section">
    <h2>Hari Ini</h2>
    <div class="today-display" id="today-display">Memuat…</div>
    <details>
      <summary>Respons JSON lengkap</summary>
      <pre class="pg-result" id="today-raw"></pre>
    </details>
  </section>

  <section class="conv-section">
    <h2>Konverter</h2>
    <form id="conv-form" class="pg-form">
      <label>
        Tanggal
        <input type="date" id="date" required />
      </label>
      <button type="submit" class="pg-btn">Konversi</button>
    </form>
    <div id="conv-result" hidden>
      <div class="conv-output" id="conv-output"></div>
      <details>
        <summary>Respons JSON lengkap</summary>
        <pre class="pg-result" id="conv-raw"></pre>
      </details>
    </div>
  </section>

  <script>
    import flatpickr from "flatpickr";
    import "flatpickr/dist/flatpickr.min.css";

    function initPicker() {
      const el = document.querySelector<HTMLInputElement>("#date");
      if (el && !el.dataset.flatpickr) {
        flatpickr(el, {
          dateFormat: "Y-m-d",
          defaultDate: "today",
          minDate: "2024-01-01",
          maxDate: "2052-12-31",
          disableMobile: true,
        });
      }
    }
    initPicker();
    document.addEventListener("astro:page-load", initPicker);
  </script>

  <script define:vars={{ apiBase }}>
    const HIJRI_MONTHS = [
      '', 'Muharram', 'Safar', 'Rabiul Awal', 'Rabiul Akhir',
      'Jumadil Awal', 'Jumadil Akhir', 'Rajab', "Sya'ban",
      'Ramadhan', 'Syawal', "Dzulqa'dah", 'Dzulhijjah',
    ];

    function formatHijri(dateStr) {
      const [y, m, d] = dateStr.split('-').map(Number);
      return `${d} ${HIJRI_MONTHS[m]} ${y}`;
    }

    const statusEl = document.getElementById("status");
    const form = document.getElementById("conv-form");
    const dateEl = document.getElementById("date");
    const todayDisplay = document.getElementById("today-display");
    const todayRaw = document.getElementById("today-raw");
    const convResult = document.getElementById("conv-result");
    const convOutput = document.getElementById("conv-output");
    const convRaw = document.getElementById("conv-raw");

    async function loadStatus() {
      try {
        const res = await fetch(`${apiBase}/api/v1/meta`);
        if (!res.ok) throw new Error(res.status);
        const meta = await res.json();
        statusEl.textContent =
          `Data MABIMS resmi Kemenag mencakup ${meta.coverage.first} → ${meta.coverage.last}` +
          (meta.fallback_active
            ? " · Di luar cakupan ini, menggunakan perhitungan Neo MABIMS."
            : "");
      } catch {
        statusEl.textContent =
          "API tidak dapat diakses dari sini — mungkin belum di-deploy.";
      }
    }

    async function loadToday() {
      try {
        const res = await fetch(`${apiBase}/api/v1/today`);
        if (!res.ok) throw new Error(res.status);
        const body = await res.json();
        todayDisplay.innerHTML =
          `<span class="today-hijri">${formatHijri(body.output.date)}</span>` +
          `<span class="today-greg">${body.input.date}</span>`;
        todayRaw.textContent = JSON.stringify(body, null, 2);
      } catch {
        todayDisplay.textContent = "Gagal memuat tanggal hari ini.";
      }
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      convResult.hidden = false;
      convOutput.textContent = "Mengkonversi…";
      convRaw.textContent = "";
      const params = new URLSearchParams({ date: dateEl.value });
      try {
        const res = await fetch(`${apiBase}/api/v1/convert?${params}`);
        const body = await res.json();
        if (!res.ok) {
          convOutput.textContent = `${res.status} ${body?.error?.code ?? ""}: ${body?.error?.message ?? res.statusText}`;
          convOutput.className = "conv-error";
        } else {
          convOutput.innerHTML =
            `<span class="conv-result-hijri">${formatHijri(body.output.date)}</span>` +
            `<span class="conv-result-greg">${body.input.date}</span>`;
          convOutput.className = "conv-result-display";
          convRaw.textContent = JSON.stringify(body, null, 2);
        }
      } catch (error) {
        convOutput.textContent = String(error);
        convOutput.className = "conv-error";
      }
    });

    loadStatus();
    loadToday();
  </script>

  <style is:global>
    .conv-section {
      margin-bottom: 2rem;
    }
    .conv-section h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 0 0.75rem;
    }
    .today-display {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 1rem;
      border-radius: 0.5rem;
      background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
      border: 1px solid rgba(254, 207, 70, 0.15);
      margin-bottom: 0.75rem;
    }
    .today-hijri {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--sl-color-accent);
    }
    .today-greg {
      font-size: 0.875rem;
      color: var(--sl-color-gray-3);
    }
    .conv-result-display {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 1rem;
      border-radius: 0.5rem;
      background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
      border: 1px solid rgba(254, 207, 70, 0.15);
      margin-bottom: 0.75rem;
    }
    .conv-result-hijri {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--sl-color-accent);
    }
    .conv-result-greg {
      font-size: 0.875rem;
      color: var(--sl-color-gray-3);
    }
    .pg-form {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: end;
      margin-bottom: 1rem;
    }
    .pg-form label {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      font-size: 0.875rem;
      font-weight: 600;
    }
    @media (max-width: 42rem) {
    .conv-error {
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      background: color-mix(in srgb, var(--sl-color-red-high) 12%, transparent);
      border: 1px solid rgba(239, 68, 68, 0.15);
      margin-bottom: 0.75rem;
      color: var(--sl-color-red-high);
    }
    .pg-form {
        gap: 0;
      }
      .pg-form label {
        width: 100%;
      }
    }
    .pg-form input {
      height: 2.25rem;
      padding: 0 0.6rem;
      border-radius: 0.375rem;
      border: 1px solid var(--sl-color-gray-4);
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
    }
    .pg-btn {
      height: 2.25rem;
      padding: 0 1.25rem;
      border-radius: 0.375rem;
      border: none;
      background: var(--sl-color-accent);
      color: var(--sl-color-black);
      font-weight: 700;
      cursor: pointer;
    }
    .pg-result {
      padding: 1rem;
      border-radius: 0.5rem;
      background: var(--sl-color-bg-code);
      overflow-x: auto;
    }
    details summary {
      cursor: pointer;
      margin-bottom: 0.5rem;
    }
  </style>
</StarlightPage>
