---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE ?? "http://localhost:8000";
---

<StarlightPage
  frontmatter={{
    title: "Playground",
    description:
      "Konversi tanggal langsung terhadap API MABIMS secara real time.",
  }}
>
  <p id="status">Memeriksa status API…</p>

  <section class="conv-section">
    <h2>Hari Ini</h2>
    <div class="today-display" id="today-display">Memuat…</div>
    <details>
      <summary>Respons JSON lengkap</summary>
      <pre class="pg-result" id="today-raw"></pre>
    </details>
  </section>

  <section class="conv-section">
    <h2>Konverter</h2>
    <form id="conv-form" class="pg-form">
      <label>
        Tanggal
        <input type="text" id="date" readonly placeholder="YYYY-MM-DD" required />
      </label>
      <button type="submit" class="pg-btn">Konversi</button>
    </form>
    <div id="conv-result" hidden>
      <div class="conv-output" id="conv-output"></div>
      <details>
        <summary>Respons JSON lengkap</summary>
        <pre class="pg-result" id="conv-raw"></pre>
      </details>
    </div>
  </section>

  <script>
    import { Calendar } from "vanilla-calendar-pro";
    import "vanilla-calendar-pro/styles/index.css";

    let cleanup: (() => void) | null = null;

    function initPicker() {
      const el = document.querySelector<HTMLInputElement>("#date");
      if (!el) return;

      cleanup?.();
      cleanup = null;

      const now = new Date();
      const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
      el.value = today;

      const calendar = new Calendar(el, {
        inputMode: true,
        positionToInput: "bottom",
        openOnFocus: true,
        selectionDatesMode: "single",
        selectedTheme: "dark",
        dateMin: "2024-01-01",
        dateMax: "2052-12-31",
        selectedDates: [today],
        onChangeToInput(self) {
          const [date] = self.context.selectedDates;
          if (date) {
            el.value = date;
            calendar.hide();
          }
        },
      });

      calendar.init();
      cleanup = () => calendar.destroy();
    }

    initPicker();
    document.addEventListener("astro:page-load", initPicker);
  </script>

  <script define:vars={{ apiBase }}>
    const statusEl = document.getElementById("status");
    const form = document.getElementById("conv-form");
    const dateEl = document.getElementById("date");
    const todayDisplay = document.getElementById("today-display");
    const todayRaw = document.getElementById("today-raw");
    const convResult = document.getElementById("conv-result");
    const convOutput = document.getElementById("conv-output");
    const convRaw = document.getElementById("conv-raw");

    async function loadStatus() {
      try {
        const res = await fetch(`${apiBase}/api/v1/meta`);
        if (!res.ok) throw new Error(res.status);
        const meta = await res.json();
        statusEl.textContent =
          `Data MABIMS resmi Kemenag mencakup ${meta.coverage.first} → ${meta.coverage.last}` +
          (meta.fallback_active
            ? " · Di luar cakupan ini, menggunakan perhitungan Neo MABIMS."
            : "");
      } catch {
        statusEl.textContent =
          "API tidak dapat diakses dari sini — mungkin belum di-deploy.";
      }
    }

    async function loadToday() {
      try {
        const res = await fetch(`${apiBase}/api/v1/today`);
        if (!res.ok) throw new Error(res.status);
        const body = await res.json();
        todayDisplay.innerHTML =
          `<span class="today-hijri">${body.output.day} ${body.output.month_name} ${body.output.year}</span>` +
          `<span class="today-greg">${body.input.date}</span>`;
        todayRaw.textContent = JSON.stringify(body, null, 2);
      } catch {
        todayDisplay.textContent = "Gagal memuat tanggal hari ini.";
      }
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      convResult.hidden = false;
      convOutput.textContent = "Mengkonversi…";
      convRaw.textContent = "";
      const params = new URLSearchParams({ date: dateEl.value });
      try {
        const res = await fetch(`${apiBase}/api/v1/convert?${params}`);
        const body = await res.json();
        if (!res.ok) {
          convOutput.textContent = `${res.status} ${body?.error?.code ?? ""}: ${body?.error?.message ?? res.statusText}`;
          convOutput.className = "conv-error";
        } else {
          convOutput.innerHTML =
            `<span class="conv-result-hijri">${body.output.day} ${body.output.month_name} ${body.output.year}</span>` +
            `<span class="conv-result-greg">${body.input.date}</span>`;
          convOutput.className = "conv-result-display";
          convRaw.textContent = JSON.stringify(body, null, 2);
        }
      } catch (error) {
        convOutput.textContent = String(error);
        convOutput.className = "conv-error";
      }
    });

    loadStatus();
    loadToday();
  </script>

  <style is:global>
    .conv-section {
      margin-bottom: 2rem;
    }
    .conv-section h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 0 0.75rem;
    }
    .today-display {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 1rem;
      border-radius: 0.5rem;
      background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
      border: 1px solid rgba(254, 207, 70, 0.15);
      margin-bottom: 0.75rem;
    }
    .today-hijri {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--sl-color-accent);
    }
    .today-greg {
      font-size: 0.875rem;
      color: var(--sl-color-gray-3);
    }
    .conv-result-display {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 1rem;
      border-radius: 0.5rem;
      background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
      border: 1px solid rgba(254, 207, 70, 0.15);
      margin-bottom: 0.75rem;
    }
    .conv-result-hijri {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--sl-color-accent);
    }
    .conv-result-greg {
      font-size: 0.875rem;
      color: var(--sl-color-gray-3);
    }
    .pg-form {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: end;
      margin-bottom: 1rem;
    }
    .pg-form label {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      font-size: 0.875rem;
      font-weight: 600;
    }
    @media (max-width: 42rem) {
    .conv-error {
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      background: color-mix(in srgb, var(--sl-color-red-high) 12%, transparent);
      border: 1px solid rgba(239, 68, 68, 0.15);
      margin-bottom: 0.75rem;
      color: var(--sl-color-red-high);
    }
    .pg-form {
        gap: 0;
      }
      .pg-form label {
        width: 100%;
      }
    }
    .pg-form input {
      height: 2.25rem;
      padding: 0 0.6rem;
      border-radius: 0.375rem;
      border: 1px solid var(--sl-color-gray-4);
      background: var(--sl-color-bg);
      color: var(--sl-color-text);
      cursor: pointer;
    }
    .pg-form input:focus {
      outline: none;
      border-color: var(--sl-color-accent);
    }
    /* Calendar is appended to document.body in input mode */
    [data-vc='calendar'][data-vc-input] {
      --vc-bg: #1a1c24;
      --vc-color: #c4c4c4;
      --vc-focus-outline-color: #fecf46;
      --vc-header-color: #ffffff;
      --vc-title-color: #ffffff;
      --vc-title-color-hover: #fecf46;
      --vc-months-years-bg: transparent;
      --vc-months-years-color: #c4c4c4;
      --vc-months-years-bg-hover: #262933;
      --vc-months-years-bg-selected: #fecf46;
      --vc-months-years-color-selected: #17181c;
      --vc-week-day-color: #888888;
      --vc-week-day-off-color: #c98080;
      --vc-date-bg: transparent;
      --vc-date-color: #b8bcc8;
      --vc-date-color-hover: #ffffff;
      --vc-date-bg-hover: #262933;
      --vc-date-hover-bg: #262933;
      --vc-date-outside-color: #55575f;
      --vc-date-disabled-color: #4a4d57;
      --vc-date-today-bg: #262933;
      --vc-date-today-color: #fecf46;
      --vc-date-selected-bg: #fecf46;
      --vc-date-selected-color: #17181c;
      --vc-date-selected-outside-bg: #262933;
      --vc-date-selected-outside-color: #fecf46;
      --vc-date-weekend-color: #c98080;
      --vc-date-weekend-bg-hover: #262933;
      --vc-date-weekend-hover-bg: #262933;
      --vc-date-weekend-outside-bg: transparent;
      --vc-date-weekend-outside-color: #8a6f6f;
      z-index: 50;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.55);
    }
    .pg-btn {
      height: 2.25rem;
      padding: 0 1.25rem;
      border-radius: 0.375rem;
      border: none;
      background: var(--sl-color-accent);
      color: var(--sl-color-black);
      font-weight: 700;
      cursor: pointer;
    }
    .pg-result {
      padding: 1rem;
      border-radius: 0.5rem;
      background: var(--sl-color-bg-code);
      overflow-x: auto;
    }
    details summary {
      cursor: pointer;
      margin-bottom: 0.5rem;
    }
  </style>
</StarlightPage>
